---
interface Props {
	class?: string;
}
---

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Navigation menu" aria-modal="true">
	<div class="mobile-menu-inner">
		<slot />
	</div>
	<div class="mobile-menu-bg" aria-hidden="true">
		<div class="bg-gradient"></div>
		<div class="bg-dots"></div>
	</div>
</div>

<style>
	.mobile-menu {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 95;
		overflow-y: auto;
		overflow-x: hidden;
		background: var(--color-bg);
		opacity: 0;
		visibility: hidden;
		transition: opacity 400ms cubic-bezier(0.4, 0, 0.2, 1),
					visibility 0ms 400ms;
	}
	:global([data-theme="dark"]) .mobile-menu {
		background: var(--sd-navy);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .mobile-menu {
			background: var(--sd-navy);
		}
	}
	.mobile-menu :global(.is-open) {
		opacity: 1;
		visibility: visible;
	}
	.mobile-menu.is-open {
		opacity: 1;
		visibility: visible;
		transition: opacity 400ms cubic-bezier(0.4, 0, 0.2, 1),
					visibility 0ms 0ms;
	}

	.mobile-menu-inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 100vh;
		min-height: 100dvh;
		padding: calc(60px + var(--space-10)) var(--space-8) var(--space-10);
	}

	.mobile-menu-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
	}
	.bg-gradient {
		position: absolute;
		bottom: -20%;
		right: -20%;
		width: 70vw;
		height: 70vw;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(232, 54, 59, 0.08) 0%, transparent 70%);
		filter: blur(40px);
	}
	:global([data-theme="dark"]) .bg-gradient {
		background: radial-gradient(circle, rgba(232, 54, 59, 0.12) 0%, transparent 70%);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .bg-gradient {
			background: radial-gradient(circle, rgba(232, 54, 59, 0.12) 0%, transparent 70%);
		}
	}
	.bg-dots {
		position: absolute;
		top: 15%;
		left: 8%;
		width: 120px;
		height: 120px;
		background-image: radial-gradient(circle, var(--color-border) 1px, transparent 1px);
		background-size: 16px 16px;
		opacity: 0.5;
	}

	@media (max-width: 767px) {
		.mobile-menu {
			display: block;
		}
	}
</style>
