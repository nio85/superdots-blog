---
interface Props {
	source?: string;
}

const { source = 'article-sticky' } = Astro.props;
---

<div class="sticky-cta newsletter" data-source={source} id="sticky-newsletter-cta" aria-label="Newsletter signup" hidden>
	<div class="sticky-cta-inner">
		<p class="sticky-cta-text">
			<span class="sticky-cta-dot" aria-hidden="true"></span>
			One AI workflow, every Tuesday<span class="dot-accent">.</span>
		</p>
		<form class="newsletter-form sticky-cta-form" aria-label="Newsletter signup">
			<div class="sticky-cta-field">
				<label for="sticky-cta-email" class="sr-only">Email address</label>
				<input
					type="email"
					id="sticky-cta-email"
					name="email"
					placeholder="you@company.com"
					required
					autocomplete="email"
					data-clarity-mask="true"
				/>
				<button type="submit" class="btn btn-primary">Subscribe</button>
			</div>
			<div class="newsletter-status" role="status" aria-live="polite"></div>
		</form>
		<button class="sticky-cta-close" aria-label="Dismiss newsletter banner" type="button">
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
			</svg>
		</button>
	</div>
</div>

<script>
	import { bindNewsletterForm } from '../scripts/newsletter-submit';

	const DISMISS_KEY = 'sticky-cta-dismissed';
	const DISMISS_DAYS = 7;
	const SCROLL_THRESHOLD = 0.2;

	function init() {
		const el = document.getElementById('sticky-newsletter-cta');
		if (!el) return;
		const banner: HTMLElement = el;

		const dismissed = localStorage.getItem(DISMISS_KEY);
		if (dismissed && Date.now() < Number(dismissed)) return;

		const form = banner.querySelector<HTMLFormElement>('.newsletter-form');
		if (form) {
			bindNewsletterForm(form, {
				source: 'article-sticky',
				defaultText: 'Subscribe',
				successText: 'Check your inbox!',
			});

			form.addEventListener('submit', () => {
				setTimeout(() => {
					const status = form.querySelector('.newsletter-status');
					if (status?.classList.contains('newsletter-status--success')) {
						setTimeout(() => hide(banner), 3000);
					}
				}, 100);
			});
		}

		banner.querySelector('.sticky-cta-close')?.addEventListener('click', () => {
			localStorage.setItem(DISMISS_KEY, String(Date.now() + DISMISS_DAYS * 86400000));
			hide(banner);
		});

		const endCta = document.querySelector('.newsletter--banner');

		let visible = false;
		function update() {
			const scrollPct = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
			const endCtaVisible = endCta ? isInViewport(endCta as HTMLElement) : false;
			const shouldShow = scrollPct >= SCROLL_THRESHOLD && !endCtaVisible;

			if (shouldShow && !visible) {
				banner.hidden = false;
				requestAnimationFrame(() => banner.classList.add('sticky-cta--visible'));
				visible = true;
			} else if (!shouldShow && visible) {
				hide(banner);
				visible = false;
			}
		}

		let ticking = false;
		window.addEventListener('scroll', () => {
			if (!ticking) {
				requestAnimationFrame(() => { update(); ticking = false; });
				ticking = true;
			}
		}, { passive: true });
	}

	function isInViewport(el: HTMLElement): boolean {
		const rect = el.getBoundingClientRect();
		return rect.top < window.innerHeight && rect.bottom > 0;
	}

	function hide(banner: HTMLElement) {
		banner.classList.remove('sticky-cta--visible');
		banner.addEventListener('transitionend', () => { banner.hidden = true; }, { once: true });
	}

	init();
</script>

<style>
	.sticky-cta {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 90;
		background: var(--color-bg-dim);
		border-top: 1px solid var(--color-border);
		padding: var(--space-3) var(--space-4);
		transform: translateY(100%);
		transition: transform 0.3s ease;
		box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
		/* Override base newsletter styles */
		border-radius: 0;
		margin: 0;
		overflow: visible;
	}
	.sticky-cta::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--color-primary);
	}
	.sticky-cta--visible {
		transform: translateY(0);
	}
	.sticky-cta-inner {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}
	.sticky-cta-text {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		margin: 0;
		white-space: nowrap;
		letter-spacing: -0.01em;
	}
	.sticky-cta-dot {
		width: 6px;
		height: 6px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		flex-shrink: 0;
	}
	.sticky-cta-form {
		flex: 1;
		min-width: 0;
	}
	.sticky-cta-field {
		display: flex;
		gap: var(--space-2);
	}
	.sticky-cta-field input {
		flex: 1;
		min-width: 0;
		padding: var(--space-2) var(--space-3);
		font-size: var(--text-sm);
		font-family: inherit;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg);
		color: var(--color-text);
		transition: border-color var(--transition-fast);
	}
	.sticky-cta-field input:focus {
		outline: none;
		border-color: var(--color-primary);
		box-shadow: var(--shadow-glow);
	}
	.sticky-cta-field input::placeholder {
		color: var(--color-text-muted);
		opacity: 0.6;
	}
	.sticky-cta-field button {
		white-space: nowrap;
		flex-shrink: 0;
		padding: var(--space-2) var(--space-4);
		font-size: var(--text-sm);
	}
	.sticky-cta-close {
		flex-shrink: 0;
		background: none;
		border: none;
		color: var(--color-text-muted);
		cursor: pointer;
		padding: var(--space-1);
		border-radius: var(--radius-sm);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: color var(--transition-fast);
	}
	.sticky-cta-close:hover {
		color: var(--color-text-strong);
	}
	/* Status message inside sticky bar */
	.sticky-cta .newsletter-status {
		font-size: var(--text-xs);
		margin-top: var(--space-1);
		min-height: 0;
	}
	.sticky-cta .newsletter-status:empty {
		display: none;
	}

	@media (max-width: 640px) {
		.sticky-cta-inner {
			flex-wrap: wrap;
			gap: var(--space-2);
		}
		.sticky-cta-text {
			flex-basis: 100%;
			font-size: var(--text-xs);
		}
		.sticky-cta-form {
			flex: 1;
		}
		.sticky-cta-close {
			position: absolute;
			top: var(--space-2);
			right: var(--space-2);
		}
		.sticky-cta {
			padding: var(--space-3) var(--space-4);
			padding-right: var(--space-8);
		}
	}
</style>
