---
/**
 * Inline collapsible table of contents.
 * Auto-generated from article headings via client-side JS.
 * Hidden on short articles (<4 headings).
 * Rendered as a <details> accordion at the top of the article prose.
 */
---

<details class="toc" id="article-toc">
	<summary class="toc-summary">
		<span class="toc-summary-text">Table of contents</span>
		<svg class="toc-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
		</svg>
	</summary>
	<nav class="toc-inner" aria-label="Table of contents">
		<ol class="toc-list" id="toc-list">
			<!-- Populated by client JS -->
		</ol>
	</nav>
</details>

<script>
	(function () {
		const prose = document.getElementById('article-prose');
		const tocList = document.getElementById('toc-list');
		const tocDetails = document.getElementById('article-toc');
		if (!prose || !tocList || !tocDetails) return;

		const headings = prose.querySelectorAll('h2, h3');
		if (headings.length < 4) {
			tocDetails.style.display = 'none';
			return;
		}

		// Build TOC links
		headings.forEach((h, i) => {
			if (!h.id) h.id = `heading-${i}`;
			const li = document.createElement('li');
			li.className = h.tagName === 'H3' ? 'toc-item toc-item--sub' : 'toc-item';
			const a = document.createElement('a');
			a.href = `#${h.id}`;
			a.textContent = h.textContent?.replace(/\.$/, '') || '';
			a.className = 'toc-link';
			li.appendChild(a);
			tocList.appendChild(li);
		});

		// Close accordion on link click (smooth scroll still works)
		tocList.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			if (target.classList.contains('toc-link')) {
				tocDetails.removeAttribute('open');
			}
		});
	})();
</script>

<style>
	.toc {
		margin-bottom: var(--space-6);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg-dim);
		overflow: hidden;
	}

	.toc-summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--space-3) var(--space-4);
		cursor: pointer;
		user-select: none;
		list-style: none;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		letter-spacing: 0.02em;
		transition: color var(--transition-fast);
	}

	.toc-summary::-webkit-details-marker {
		display: none;
	}
	.toc-summary::marker {
		display: none;
		content: '';
	}

	.toc-summary:hover {
		color: var(--color-text);
	}

	.toc-chevron {
		flex-shrink: 0;
		transition: transform var(--transition-fast);
		opacity: 0.5;
	}

	.toc[open] .toc-chevron {
		transform: rotate(180deg);
	}

	.toc-inner {
		padding: 0 var(--space-4) var(--space-4);
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--color-border);
		padding-top: var(--space-3);
	}

	.toc-item {
		margin-bottom: var(--space-0-5);
	}

	.toc-item--sub {
		padding-left: var(--space-4);
	}

	.toc-link {
		display: block;
		font-size: var(--text-sm);
		line-height: var(--leading-snug);
		color: var(--color-text-muted);
		text-decoration: none;
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		transition: color var(--transition-fast), background var(--transition-fast);
	}

	.toc-link:hover {
		color: var(--color-text);
		background: var(--color-bg);
	}
</style>
