---
import FormattedDate from './FormattedDate.astro';
import { PILLARS } from '../consts';

const PILLAR_BADGE_COLORS: Record<string, string> = {
	'dot-by-dot': '#E8363B',
	'connecting-the-dots': '#14B8A6',
	'the-big-picture': '#6366F1',
	'behind-the-dots': '#F59E0B',
};

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	department?: string;
	useCase?: string;
	slug?: string;
	href?: string;
	tags?: string[];
	headingLevel?: 'h2' | 'h3';
	variant?: 'article' | 'guide' | 'series';
	readingTime?: number;
	relatedCount?: number;
	contentPillar?: string;
	/** Series variant only — pillar accent color override (e.g. '#14B8A6'). */
	pillarColor?: string;
	/** Series variant only — number of articles in this pillar. */
	count?: number;
	/** Series variant only — latest article title shown as teaser. */
	latestTitle?: string;
}

const {
	title,
	description,
	pubDate,
	department,
	slug,
	href,
	headingLevel = 'h3',
	variant = 'article',
	readingTime,
	relatedCount,
	contentPillar,
	pillarColor,
	count,
	latestTitle,
} = Astro.props;

const pillarBadgeColor = contentPillar ? PILLAR_BADGE_COLORS[contentPillar] : undefined;
const pillarLabel = contentPillar ? PILLARS.find(p => p.slug === contentPillar)?.label : undefined;
const Heading = headingLevel;

const linkHref = href || `/blog/${slug}/`;
const isGuide = variant === 'guide';
const isSeries = variant === 'series';
const ctaText = isSeries ? 'Browse series' : isGuide ? 'Read guide' : 'Read article';

// For series variant: convert pillar hex → "r, g, b" triplet so the gradient
// wash (::after uses rgba(var(--card-accent-rgb))) renders in the right tone.
function hexToRgbTriplet(hex?: string): string | undefined {
	if (!hex) return undefined;
	const h = hex.replace('#', '');
	if (h.length !== 6) return undefined;
	const r = parseInt(h.substring(0, 2), 16);
	const g = parseInt(h.substring(2, 4), 16);
	const b = parseInt(h.substring(4, 6), 16);
	return `${r}, ${g}, ${b}`;
}
const pillarRgb = isSeries ? hexToRgbTriplet(pillarColor) : undefined;
const seriesStyle = isSeries && pillarColor
	? `--card-accent: ${pillarColor};${pillarRgb ? ` --card-accent-rgb: ${pillarRgb};` : ''}`
	: undefined;
---

<article
	class:list={['post-card', { 'post-card--guide': isGuide, 'post-card--series': isSeries }]}
	style={seriesStyle}
>
	<a href={linkHref}>
		<div class="meta">
			{pillarBadgeColor && pillarLabel && !isSeries && (
				<span class="badge badge-pillar" style={`border-color: ${pillarBadgeColor}; color: ${pillarBadgeColor};`}>{pillarLabel}</span>
			)}
			{department && !isSeries && <span class:list={['badge', isGuide ? 'badge-guide-dept' : 'badge-dept']}>{department}</span>}
			{!isGuide && !isSeries && pubDate && <span class="date"><FormattedDate date={pubDate} /></span>}
			{isSeries && count !== undefined && (
				<span class="series-count-badge">{count} {count === 1 ? 'article' : 'articles'}</span>
			)}
		</div>
		<Heading class="card-title">{title}</Heading>
		<p>{description}</p>
		{isSeries && latestTitle && (
			<p class="series-latest"><span class="series-latest-label">Latest:</span> {latestTitle}</p>
		)}
		{isGuide && (readingTime || relatedCount) ? (
			<div class="guide-meta">
				{readingTime && readingTime > 0 && (
					<span class="guide-meta-item">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
						{readingTime} min read
					</span>
				)}
				{relatedCount && relatedCount > 0 && (
					<span class="guide-meta-item">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
						+{relatedCount} related articles
					</span>
				)}
			</div>
		) : null}
		<span class="read-more">{ctaText} <span aria-hidden="true">&rarr;</span></span>
	</a>
</article>

<style>
	.post-card {
		--card-accent: var(--color-primary);
		--card-accent-light: var(--sd-red-light);
		--card-accent-rgb: 232, 54, 59;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-6);
		transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
		position: relative;
		overflow: hidden;
	}
	.post-card--guide {
		--card-accent: var(--color-secondary);
		--card-accent-light: var(--sd-teal-light);
		--card-accent-rgb: 20, 184, 166;
	}
	/* Series variant — same card shell as article, but accent is driven by
	   the pillar color passed inline. The hover behaviour (left-border
	   reveal, gradient wash, lift) is identical to the article variant. */
	.post-card--series .series-count-badge {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--card-accent);
		padding: 0;
	}
	.post-card--series .series-latest {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-4);
		line-height: var(--leading-snug);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.post-card--series .series-latest-label {
		font-weight: var(--weight-semibold);
		color: var(--color-text);
	}
	/* Hover state — gated behind (hover: hover) so touch devices never
	   activate it (prevents the "stuck active card after drag-scroll"
	   bug in horizontal carousels). Simplified: no left-border reveal,
	   no gradient wash — just a clean border/shadow/lift. */
	@media (hover: hover) {
		.post-card:hover {
			border-color: var(--card-accent);
			box-shadow: var(--shadow-md), 0 4px 16px rgba(var(--card-accent-rgb), 0.08);
			transform: translateY(-2px);
		}
	}
	.post-card a {
		text-decoration: none;
		color: inherit;
		display: block;
		position: relative;
		z-index: 1;
	}
	.post-card a:hover {
		text-decoration: none;
	}
	.post-card .card-title {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: var(--weight-bold);
		margin: var(--space-3) 0 var(--space-2);
		color: var(--color-text-strong);
		letter-spacing: -0.02em;
		transition: color var(--transition-fast);
		line-height: var(--leading-tight);
	}
	.post-card:hover .card-title {
		color: var(--card-accent);
	}
	.post-card p {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		margin: 0 0 var(--space-4);
		line-height: var(--leading-snug);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
	}
	.date {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin-left: auto;
	}
	.badge-pillar {
		border: 1px solid;
		background: transparent;
	}
	.badge-guide-dept {
		background: var(--sd-teal-light);
		color: var(--sd-teal-dark);
	}
	.guide-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-bottom: var(--space-4);
	}
	.guide-meta-item {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.read-more {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--card-accent);
		transition: gap var(--transition-fast), letter-spacing var(--transition-fast);
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
	}
	.post-card:hover .read-more {
		gap: var(--space-2);
	}
</style>
