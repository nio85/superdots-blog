---
import FormattedDate from './FormattedDate.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	department: string;
	useCase: string;
	slug: string;
}

const { title, description, pubDate, department, useCase, slug } = Astro.props;
---

<article class="post-card">
	<a href={`/blog/${slug}/`}>
		<div class="meta">
			<span class="badge dept">{department}</span>
			<span class="badge use-case">{useCase}</span>
			<FormattedDate date={pubDate} />
		</div>
		<h3>{title}</h3>
		<p>{description}</p>
	</a>
</article>

<style>
	.post-card {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem;
		transition: border-color 0.2s, box-shadow 0.2s;
	}
	.post-card:hover {
		border-color: var(--accent);
		box-shadow: 0 2px 12px rgba(99, 102, 241, 0.1);
	}
	.post-card a {
		text-decoration: none;
		color: inherit;
	}
	.post-card h3 {
		margin: 0.5rem 0 0.25rem;
		font-size: 1.25rem;
	}
	.post-card p {
		color: var(--text-light);
		font-size: 0.95rem;
		margin: 0;
		line-height: 1.5;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
		color: var(--text-light);
		flex-wrap: wrap;
	}
	.badge {
		display: inline-block;
		padding: 2px 8px;
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: capitalize;
	}
	.badge.dept {
		background: #ede9fe;
		color: #6d28d9;
	}
	.badge.use-case {
		background: #ecfdf5;
		color: #059669;
	}
</style>
