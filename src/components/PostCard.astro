---
import FormattedDate from './FormattedDate.astro';
import { TAGS, PILLARS } from '../consts';

const PILLAR_COLORS: Record<string, string> = {
	'dot-by-dot': '#E8363B',
	'connecting-the-dots': '#14B8A6',
	'the-big-picture': '#8B8BF5',
	'behind-the-dots': '#F59E0B',
};

interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	department?: string;
	useCase?: string;
	slug?: string;
	href?: string;
	tags?: string[];
	headingLevel?: 'h2' | 'h3';
	variant?: 'default' | 'feature' | 'quote' | 'guide';
	readingTime?: number;
	relatedCount?: number;
	contentPillar?: string;
	quoteText?: string;
	quoteAuthor?: string;
	heroImage?: string;
}

const {
	title,
	description,
	pubDate,
	department,
	useCase,
	slug,
	href,
	tags = [],
	headingLevel = 'h3',
	variant = 'default',
	readingTime,
	relatedCount,
	contentPillar,
	quoteText,
	quoteAuthor,
	heroImage,
} = Astro.props;

const pillarKey = contentPillar || 'dot-by-dot';
const pillarColor = PILLAR_COLORS[pillarKey] || PILLAR_COLORS['dot-by-dot'];
const pillarLabel = PILLARS.find((p) => p.slug === pillarKey)?.label;
const Heading = headingLevel;

const linkHref = href || `/blog/${slug}/`;
const isGuide = variant === 'guide';
const isFeature = variant === 'feature';
const isQuote = variant === 'quote';

const tagMeta = tags
	.map((t) => TAGS.find((tm) => tm.slug === t))
	.filter(Boolean)
	.slice(0, 3);
---

<article
	class:list={['post-card', `post-card--${variant}`]}
	style={`--pillar-color: ${pillarColor};`}
	data-pillar={pillarKey}
>
	<a href={linkHref} class="post-card-link">
		{isFeature && heroImage && (
			<div class="feature-image" aria-hidden="true">
				<img src={heroImage} alt="" loading="lazy" />
			</div>
		)}
		{isFeature && !heroImage && (
			<div class="feature-pattern" aria-hidden="true"></div>
		)}

		<div class="card-body">
			<span class="pillar-dot" aria-hidden="true"></span>

			<div class="meta">
				{pillarLabel && (
					<span class="badge-pillar-inline">{pillarLabel}</span>
				)}
				{department && !isQuote && <span class:list={['badge', isGuide ? 'badge-guide-dept' : 'badge-dept']}>{department}</span>}
				{!isGuide && !isQuote && useCase && <span class="badge badge-usecase">{useCase}</span>}
				{!isQuote && pubDate && <span class="date"><FormattedDate date={pubDate} /></span>}
			</div>

			{isQuote && quoteText ? (
				<blockquote class="quote-body">
					<p class="quote-text">&ldquo;{quoteText}&rdquo;</p>
					<footer class="quote-attribution">
						<Heading class="quote-source-title">{title}</Heading>
						{quoteAuthor && <span class="quote-author">— {quoteAuthor}</span>}
					</footer>
				</blockquote>
			) : (
				<>
					<Heading class="card-title">
						{title}
						<span class="title-underline" aria-hidden="true"></span>
					</Heading>
					<p class="card-desc">{description}</p>
				</>
			)}

			{isGuide && (readingTime || relatedCount) ? (
				<div class="guide-meta">
					{readingTime && readingTime > 0 && (
						<span class="guide-meta-item">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
							{readingTime} min read
						</span>
					)}
					{relatedCount && relatedCount > 0 && (
						<span class="guide-meta-item">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
							+{relatedCount} related articles
						</span>
					)}
				</div>
			) : null}

			{tagMeta.length > 0 && !isQuote && (
				<div class="tag-pills">
					{tagMeta.map((t) => (
						<a href={`/tags/${t!.slug}/`} class="badge badge-tag" onclick="event.stopPropagation()">{t!.label}</a>
					))}
				</div>
			)}
		</div>
	</a>
</article>

<style>
	.post-card {
		position: relative;
		background: var(--color-bg-dim);
		border-radius: var(--radius-lg);
		transition: background 240ms ease;
		overflow: hidden;
	}

	.post-card-link {
		display: block;
		padding: var(--space-5) var(--space-6) var(--space-6);
		color: inherit;
		text-decoration: none;
	}

	.post-card-link:hover {
		text-decoration: none;
	}

	.post-card:hover {
		background: color-mix(in srgb, var(--pillar-color) 5%, var(--color-bg-dim));
	}

	/* The signature — a pillar dot that grows, plus an underline that draws under the title */
	.pillar-dot {
		display: block;
		width: 10px;
		height: 10px;
		border-radius: var(--radius-full);
		background: var(--pillar-color);
		margin-bottom: var(--space-3);
		transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 240ms ease;
	}

	.post-card:hover .pillar-dot {
		transform: scale(1.5);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--pillar-color) 20%, transparent);
	}

	.card-body {
		display: flex;
		flex-direction: column;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
		margin-bottom: var(--space-3);
	}

	.badge-pillar-inline {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--pillar-color);
		padding: 0;
	}

	.date {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin-left: auto;
		font-family: var(--font-mono);
	}

	.card-title {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		margin: 0 0 var(--space-3);
		color: var(--color-text-strong);
		letter-spacing: -0.025em;
		line-height: var(--leading-tight);
		position: relative;
		display: inline-block;
		padding-bottom: var(--space-1);
	}

	.title-underline {
		position: absolute;
		left: 0;
		bottom: 0;
		height: 2px;
		width: 0;
		background: var(--pillar-color);
		border-radius: var(--radius-full);
		transition: width 380ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.post-card:hover .title-underline {
		width: 100%;
	}

	.card-desc {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		margin: 0 0 var(--space-4);
		line-height: var(--leading-snug);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.tag-pills {
		display: flex;
		gap: var(--space-1);
		flex-wrap: wrap;
		margin-top: var(--space-2);
	}

	.tag-pills .badge-tag {
		font-size: var(--text-xs);
		cursor: pointer;
		text-decoration: none;
		transition: all var(--transition-fast);
		background: transparent;
		border: 1px solid var(--color-border);
		color: var(--color-text-muted);
	}

	.tag-pills .badge-tag:hover {
		border-color: var(--pillar-color);
		color: var(--pillar-color);
		text-decoration: none;
	}

	/* ---- Feature variant ---- */
	.post-card--feature {
		grid-column: span 2;
	}

	.post-card--feature .post-card-link {
		display: flex;
		flex-direction: column;
		padding: 0;
	}

	.feature-image {
		aspect-ratio: 16 / 8;
		overflow: hidden;
		background: var(--color-bg-code);
		border-bottom: 2px solid var(--pillar-color);
	}

	.feature-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.post-card--feature:hover .feature-image img {
		transform: scale(1.02);
	}

	.feature-pattern {
		aspect-ratio: 16 / 7;
		background-image: radial-gradient(circle, var(--pillar-color) 1.6px, transparent 1.6px);
		background-size: 20px 20px;
		opacity: 0.35;
		border-bottom: 2px solid var(--pillar-color);
	}

	.post-card--feature .card-body {
		padding: var(--space-6) var(--space-8) var(--space-8);
	}

	.post-card--feature .card-title {
		font-size: var(--text-3xl);
	}

	.post-card--feature .card-desc {
		-webkit-line-clamp: unset;
		font-size: var(--text-lg);
		line-height: var(--leading-normal);
	}

	/* ---- Quote variant (Phase 1: component ready, not wired yet) ---- */
	.post-card--quote {
		background: color-mix(in srgb, var(--pillar-color) 6%, var(--color-bg-dim));
		border-top: 3px solid var(--pillar-color);
	}

	.quote-body {
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
	}

	.quote-text {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		letter-spacing: -0.02em;
		line-height: var(--leading-snug);
		margin: 0 0 var(--space-4);
	}

	.quote-attribution {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.quote-source-title {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--pillar-color);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin: 0;
	}

	.quote-author {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	/* ---- Guide variant (existing behaviour preserved) ---- */
	.post-card--guide {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	.post-card--guide:hover {
		border-color: var(--color-secondary, #14B8A6);
		background: var(--color-bg);
	}

	.badge-guide-dept {
		background: var(--sd-teal-light);
		color: var(--sd-teal-dark);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-full);
	}

	.guide-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		margin-top: var(--space-2);
		margin-bottom: var(--space-3);
	}

	.guide-meta-item {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	/* ---- Responsive ---- */
	@media (max-width: 640px) {
		.post-card--feature {
			grid-column: span 1;
		}
		.post-card--feature .card-title {
			font-size: var(--text-2xl);
		}
		.post-card--feature .card-body {
			padding: var(--space-5) var(--space-5) var(--space-6);
		}
		.card-title {
			font-size: var(--text-xl);
		}
	}

	/* ---- Dark mode polish ---- */
	:global([data-theme="dark"]) .post-card {
		background: rgba(255, 255, 255, 0.025);
	}

	:global([data-theme="dark"]) .post-card:hover {
		background: color-mix(in srgb, var(--pillar-color) 10%, rgba(255, 255, 255, 0.03));
	}

	:global([data-theme="dark"]) .post-card--guide {
		background: rgba(255, 255, 255, 0.025);
		border-color: rgba(255, 255, 255, 0.08);
	}

	:global([data-theme="dark"]) .post-card--quote {
		background: color-mix(in srgb, var(--pillar-color) 12%, rgba(255, 255, 255, 0.025));
	}

	@media (prefers-reduced-motion: reduce) {
		.pillar-dot,
		.title-underline,
		.feature-image img {
			transition: none;
		}
	}
</style>
