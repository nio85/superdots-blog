---
interface Props {
	href: string;
	label: string;
	active: boolean;
	index: number;
}

const { href, label, active, index } = Astro.props;
---

<a
	href={href}
	class:list={['mobile-link', { active }]}
	aria-current={active ? 'page' : undefined}
	style={`--item-index: ${index}`}
>
	<span class="mobile-link-indicator" aria-hidden="true">
		<span class="indicator-line"></span>
		<span class="indicator-dot"></span>
	</span>
	<span class="mobile-link-label">{label}</span>
	<svg class="mobile-link-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<line x1="5" y1="12" x2="19" y2="12"></line>
		<polyline points="12 5 19 12 12 19"></polyline>
	</svg>
</a>

<style>
	.mobile-link {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		padding: var(--space-5) var(--space-4);
		font-family: var(--font-display);
		font-size: var(--text-3xl);
		font-weight: var(--weight-bold);
		color: var(--color-text-muted);
		text-decoration: none;
		border-radius: var(--radius-lg);
		transition: color 200ms ease, background 200ms ease;
		letter-spacing: -0.01em;
		opacity: 0;
		transform: translateY(20px);
	}
	.mobile-link.is-visible {
		opacity: 1;
		transform: translateY(0);
		transition: color 200ms ease, background 200ms ease,
					opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
					transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	@media (prefers-reduced-motion: reduce) {
		.mobile-link {
			opacity: 1;
			transform: none;
			transition: color 200ms ease, background 200ms ease;
		}
	}
	.mobile-link:hover {
		color: var(--color-text-strong);
		background: var(--color-bg-dim);
		text-decoration: none;
	}
	.mobile-link.active {
		color: var(--color-text-strong);
	}

	.mobile-link-indicator {
		display: flex;
		align-items: center;
		gap: 0;
		width: 28px;
		flex-shrink: 0;
		position: relative;
	}
	.indicator-line {
		width: 0;
		height: 2px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		transition: width 300ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.indicator-dot {
		width: 8px;
		height: 8px;
		border-radius: var(--radius-full);
		background: transparent;
		border: 2px solid transparent;
		transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
		flex-shrink: 0;
	}
	.mobile-link.active .indicator-line {
		width: 14px;
	}
	.mobile-link.active .indicator-dot {
		background: var(--color-primary);
		border-color: var(--color-primary);
		box-shadow: 0 0 8px rgba(232, 54, 59, 0.4);
	}
	.mobile-link:hover .indicator-dot {
		border-color: var(--color-border-strong);
	}

	.mobile-link-label {
		flex: 1;
	}

	.mobile-link-arrow {
		opacity: 0;
		transform: translateX(-8px);
		transition: all 200ms ease;
		color: var(--color-text-muted);
		flex-shrink: 0;
	}
	.mobile-link:hover .mobile-link-arrow {
		opacity: 0.6;
		transform: translateX(0);
	}
	.mobile-link.active .mobile-link-arrow {
		opacity: 0.4;
		transform: translateX(0);
	}
</style>
