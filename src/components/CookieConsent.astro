---
/**
 * Cookie consent — Silktide Consent Manager (vendored).
 * Replaces vanilla-cookieconsent v3 (migrated 2026-04-15).
 *
 * Categories:
 *   - necessary  (required): sd-theme, stcm.*, __cf_bm
 *   - analytics  (opt-in):   GA4 + Microsoft Clarity
 *   - marketing  (opt-in):   reserved
 *
 * Design overrides: src/styles/silktide-consent.css
 */
---

<link rel="stylesheet" href="/vendor/silktide/silktide-consent-manager.css" />
<script is:inline src="/vendor/silktide/silktide-consent-manager.js"></script>

<script>
import '../styles/silktide-consent.css';

declare global {
  interface Window {
    gtag: (...args: any[]) => void;
    SD_startClarity: () => void;
    SD_clarityLoaded: boolean;
    silktideConsentManager: {
      init: (config: any) => void;
      update: (config: any) => void;
      getInstance: () => any;
      resetConsent: () => void;
    };
  }
}

// --- Migrate legacy localStorage (sd-cookie-consent v1 AND cc_cookie v3) ---
function migrateLegacyConsent(): { analytics: boolean; marketing: boolean } | null {
  const v1 = localStorage.getItem('sd-cookie-consent');
  if (v1) {
    const analytics = v1 === 'accepted';
    localStorage.removeItem('sd-cookie-consent');
    localStorage.removeItem('sd-cookie-consent-date');
    return { analytics, marketing: false };
  }
  const v3 = localStorage.getItem('cc_cookie');
  if (v3) {
    try {
      const parsed = JSON.parse(v3);
      const cats: string[] = parsed.categories ?? [];
      localStorage.removeItem('cc_cookie');
      return { analytics: cats.includes('analytics'), marketing: cats.includes('marketing') };
    } catch {
      /* ignore */
    }
  }
  return null;
}

// Pre-seed Silktide storage from legacy keys so the banner doesn't reappear.
function seedSilktideFromLegacy(legacy: { analytics: boolean; marketing: boolean }) {
  const ns = 'superdots.';
  localStorage.setItem(`stcm.${ns}consent.necessary`, 'true');
  localStorage.setItem(`stcm.${ns}consent.analytics`, String(legacy.analytics));
  localStorage.setItem(`stcm.${ns}consent.marketing`, String(legacy.marketing));
  localStorage.setItem(`stcm.${ns}hasConsented`, 'true');
}

const legacy = migrateLegacyConsent();
if (legacy) seedSilktideFromLegacy(legacy);

function initSilktide() {
  if (!window.silktideConsentManager) return;

  window.silktideConsentManager.init({
    namespace: 'superdots',
    icon: { position: 'bottomLeft' },
    backdrop: { show: true },
    prompt: { position: 'center' },
    consentTypes: [
      {
        id: 'necessary',
        label: 'Essential',
        description: 'Theme preference and this very consent record. Nothing else.',
        required: true,
        defaultValue: true,
      },
      {
        id: 'analytics',
        label: 'Analytics',
        description:
          'Google Analytics (GA4) and Microsoft Clarity. Aggregate reading patterns and heatmaps — no names, no emails, no selling.',
        defaultValue: false,
        gtag: 'analytics_storage',
        onAccept: () => {
          window.SD_startClarity?.();
        },
      },
      {
        id: 'marketing',
        label: 'Marketing',
        description: 'Reserved for the future. Nothing active today.',
        defaultValue: false,
        gtag: ['ad_storage', 'ad_user_data', 'ad_personalization'],
      },
    ],
    text: {
      prompt: {
        title: 'A word on cookies.',
        description:
          'We use Google Analytics and Microsoft Clarity to see which articles actually get read. No personal data is sold, shared, or creepy. Read the <a href="/cookie-policy/" target="_blank" rel="noopener">cookie policy</a> or <a href="/privacy/" target="_blank" rel="noopener">privacy policy</a> — they open in a new tab so you don\'t lose this prompt.',
        acceptAllButtonText: 'Allow all',
        rejectNonEssentialButtonText: 'Only essential',
        preferencesButtonText: 'Choose',
      },
      preferences: {
        title: 'Your call.',
        description:
          'Three categories. No dark patterns. Toggle what you want — we remember for 6 months. Essentials stay on (without them the site breaks). Full details in the <a href="/cookie-policy/" target="_blank" rel="noopener">cookie policy</a>.',
        saveButtonText: 'Save choices',
        creditLinkText: '',
      },
    },
  });
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initSilktide, { once: true });
} else {
  initSilktide();
}

// --- Footer "Cookie Settings" reopener ---
document.getElementById('cookie-settings-link')?.addEventListener('click', (e) => {
  e.preventDefault();
  const icon = document.getElementById('stcm-icon') as HTMLElement | null;
  if (icon) {
    icon.click();
    return;
  }
  // Fallback: create+toggle via instance if icon isn't mounted yet
  const inst = window.silktideConsentManager?.getInstance?.();
  if (inst?.toggleModal) {
    inst.showBackdrop?.();
    inst.toggleModal(true);
  }
});
</script>
