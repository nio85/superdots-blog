---
/**
 * Cookie consent — editorial design, zero dependencies.
 *
 * Custom GDPR-compliant:
 *  - storage localStorage['sd-consent-v2']
 *  - UI state via html[data-consent-state]: idle | banner | preferences
 *  - Policy pages (/privacy/, /cookie-policy/) suppress the banner so users
 *    can actually read the policy without it being covered. Analytics stay
 *    denied by default there (Consent Mode v2), so nothing is set without
 *    consent — fully compliant. The footer "Cookie settings" link still
 *    works manually everywhere.
 */

const { pathname } = Astro.url;
const isPolicyPage = pathname === '/privacy/' || pathname === '/privacy'
  || pathname === '/cookie-policy/' || pathname === '/cookie-policy';
---

<div id="sd-cc-root" aria-hidden="true" data-policy-page={isPolicyPage ? 'true' : 'false'}>
  <div id="sd-cc-backdrop" aria-hidden="true"></div>

  <!-- BANNER -->
  <div
    id="sd-cc-banner"
    role="alertdialog"
    aria-modal="true"
    aria-labelledby="sd-cc-banner-title"
    aria-describedby="sd-cc-banner-desc"
    tabindex="-1"
  >
    <div class="sd-cc-rule" aria-hidden="true"></div>

    <p class="sd-cc-eyebrow">
      <span class="sd-cc-dot" aria-hidden="true"></span>
      Cookies
    </p>

    <h2 id="sd-cc-banner-title" class="sd-cc-title">
      A word on cookies<span class="sd-cc-period">.</span>
    </h2>

    <p id="sd-cc-banner-desc" class="sd-cc-lede">
      We use <strong>Google Analytics</strong> and <strong>Microsoft Clarity</strong> to see which articles actually get read.
      No personal data is sold, shared, or creepy.
    </p>

    <div class="sd-cc-actions">
      <button type="button" class="btn btn-primary sd-cc-btn" data-action="accept-all">Allow all</button>
      <button type="button" class="btn btn-ghost sd-cc-btn" data-action="reject-all">Only essential</button>
      <button type="button" class="sd-cc-btn-text" data-action="open-preferences">Choose what</button>
    </div>

    <div class="sd-cc-policy-row">
      <a href="/privacy/" class="sd-cc-policy-link">Privacy policy</a>
      <span class="sd-cc-policy-sep" aria-hidden="true">·</span>
      <a href="/cookie-policy/" class="sd-cc-policy-link">Cookie policy</a>
    </div>
  </div>

  <!-- PREFERENCES -->
  <div
    id="sd-cc-preferences"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sd-cc-prefs-title"
    tabindex="-1"
  >
    <div class="sd-cc-rule" aria-hidden="true"></div>
    <div class="sd-cc-prefs-header">
      <div>
        <p class="sd-cc-eyebrow">
          <span class="sd-cc-dot" aria-hidden="true"></span>
          Preferences
        </p>
        <h2 id="sd-cc-prefs-title" class="sd-cc-title">Your call<span class="sd-cc-period">.</span></h2>
      </div>
      <button type="button" class="sd-cc-close" data-action="close-preferences" aria-label="Close preferences">
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <p class="sd-cc-intro">
      Three categories. Toggle what you want — we remember for 6 months.
    </p>

    <div class="sd-cc-categories">
      <fieldset class="sd-cc-cat sd-cc-cat-locked">
        <div class="sd-cc-cat-head">
          <legend>Essential</legend>
          <label class="sd-cc-switch sd-cc-switch-locked">
            <input type="checkbox" checked disabled data-cat="necessary" />
            <span class="sd-cc-track" aria-hidden="true"><span class="sd-cc-thumb"></span></span>
            <span class="sd-cc-sr">Always on</span>
          </label>
        </div>
        <p>Theme preference and this very consent record. Nothing else.</p>
      </fieldset>

      <fieldset class="sd-cc-cat">
        <div class="sd-cc-cat-head">
          <legend>Analytics</legend>
          <label class="sd-cc-switch">
            <input type="checkbox" data-cat="analytics" />
            <span class="sd-cc-track" aria-hidden="true"><span class="sd-cc-thumb"></span></span>
            <span class="sd-cc-sr">Toggle analytics</span>
          </label>
        </div>
        <p>Google Analytics and Microsoft Clarity. Aggregate reading patterns — no names, no selling.</p>
      </fieldset>

      <fieldset class="sd-cc-cat">
        <div class="sd-cc-cat-head">
          <legend>Marketing</legend>
          <label class="sd-cc-switch">
            <input type="checkbox" data-cat="marketing" />
            <span class="sd-cc-track" aria-hidden="true"><span class="sd-cc-thumb"></span></span>
            <span class="sd-cc-sr">Toggle marketing</span>
          </label>
        </div>
        <p>Reserved for the future. Nothing active today.</p>
      </fieldset>
    </div>

    <footer class="sd-cc-prefs-footer">
      <button type="button" class="btn btn-primary sd-cc-btn" data-action="save-preferences">Save choices</button>
      <button type="button" class="btn btn-ghost sd-cc-btn" data-action="reject-all">Only essential</button>
      <button type="button" class="btn btn-ghost sd-cc-btn" data-action="accept-all">Allow all</button>
    </footer>

    <div class="sd-cc-policy-row sd-cc-policy-row-prefs">
      <a href="/privacy/" class="sd-cc-policy-link">Privacy policy</a>
      <span class="sd-cc-policy-sep" aria-hidden="true">·</span>
      <a href="/cookie-policy/" class="sd-cc-policy-link">Cookie policy</a>
    </div>
  </div>
</div>

<script>
import '../styles/cookie-consent.css';

declare global {
  interface Window {
    gtag: (...args: any[]) => void;
    clarity?: (...args: any[]) => void;
    SD_startClarity: () => void;
    SD_clarityLoaded: boolean;
  }
}

type Categories = { necessary: true; analytics: boolean; marketing: boolean };
type ConsentRecord = {
  version: 2;
  timestamp: string;
  expires: string;
  categories: Categories;
};

const STORAGE_KEY = 'sd-consent-v2';
const SIX_MONTHS_MS = 1000 * 60 * 60 * 24 * 30 * 6;

function readConsent(): ConsentRecord | null {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return null;
    const p = JSON.parse(raw);
    if (p?.version !== 2) return null;
    if (new Date(p.expires).getTime() < Date.now()) return null;
    if (!p.categories) return null;
    return p as ConsentRecord;
  } catch {
    return null;
  }
}

function writeConsent(cats: Partial<Categories>): ConsentRecord {
  const now = new Date();
  const record: ConsentRecord = {
    version: 2,
    timestamp: now.toISOString(),
    expires: new Date(now.getTime() + SIX_MONTHS_MS).toISOString(),
    categories: {
      necessary: true,
      analytics: !!cats.analytics,
      marketing: !!cats.marketing,
    },
  };
  localStorage.setItem(STORAGE_KEY, JSON.stringify(record));
  syncConsent(record.categories);
  return record;
}

function migrateLegacy(): ConsentRecord | null {
  const ccMatch = document.cookie.match(/(?:^|;\s*)cc_cookie=([^;]*)/);
  if (ccMatch) {
    try {
      const data = JSON.parse(decodeURIComponent(ccMatch[1]));
      const cats = data.categories || [];
      const rec = writeConsent({
        analytics: cats.includes('analytics'),
        marketing: cats.includes('marketing'),
      });
      document.cookie = 'cc_cookie=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
      return rec;
    } catch {}
  }
  const v1 = localStorage.getItem('sd-cookie-consent');
  if (v1) {
    const rec = writeConsent({ analytics: v1 === 'accepted', marketing: false });
    localStorage.removeItem('sd-cookie-consent');
    localStorage.removeItem('sd-cookie-consent-date');
    return rec;
  }
  return null;
}

function syncConsent(cats: Categories) {
  if (typeof window.gtag === 'function') {
    window.gtag('consent', 'update', {
      analytics_storage: cats.analytics ? 'granted' : 'denied',
      ad_storage: cats.marketing ? 'granted' : 'denied',
      ad_user_data: cats.marketing ? 'granted' : 'denied',
      ad_personalization: cats.marketing ? 'granted' : 'denied',
    });
  }
  if (cats.analytics) {
    if (typeof window.SD_startClarity === 'function') window.SD_startClarity();
  } else {
    if (typeof window.clarity === 'function') {
      try { window.clarity('stop'); } catch {}
    }
    window.SD_clarityLoaded = false;
  }
}

// --- UI state machine ---
const root = document.getElementById('sd-cc-root');
const banner = document.getElementById('sd-cc-banner');
const prefs = document.getElementById('sd-cc-preferences');
const isPolicyPage = root?.dataset.policyPage === 'true';
let lastFocus: HTMLElement | null = null;

function getFocusable(el: HTMLElement): HTMLElement[] {
  return Array.from(
    el.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input:not([disabled]):not([type=hidden]), [tabindex]:not([tabindex="-1"])'
    )
  ).filter((n) => n.offsetParent !== null || n.getClientRects().length > 0);
}

function setState(state: 'idle' | 'banner' | 'preferences') {
  document.documentElement.setAttribute('data-consent-state', state);
  if (root) root.setAttribute('aria-hidden', state === 'idle' ? 'true' : 'false');
  if (state === 'idle') {
    document.body.style.overflow = '';
    if (lastFocus && typeof lastFocus.focus === 'function') {
      try { lastFocus.focus(); } catch {}
    }
    lastFocus = null;
    return;
  }
  document.body.style.overflow = 'hidden';
  const active = state === 'banner' ? banner : prefs;
  if (!active) return;
  if (!lastFocus) lastFocus = document.activeElement as HTMLElement;
  const primary =
    active.querySelector<HTMLElement>('[data-action="accept-all"]') ||
    active.querySelector<HTMLElement>('[data-action="save-preferences"]');
  setTimeout(() => primary?.focus(), 30);
}

function loadCurrentIntoToggles() {
  const current = readConsent();
  const cats = current?.categories ?? { necessary: true, analytics: false, marketing: false };
  prefs?.querySelectorAll<HTMLInputElement>('input[data-cat]').forEach((input) => {
    const key = input.dataset.cat as keyof Categories;
    if (key === 'necessary') { input.checked = true; return; }
    input.checked = !!cats[key];
  });
}

function readTogglesAsCategories(): Partial<Categories> {
  const out: Partial<Categories> = {};
  prefs?.querySelectorAll<HTMLInputElement>('input[data-cat]').forEach((input) => {
    const key = input.dataset.cat as keyof Categories;
    if (key === 'necessary') return;
    (out as any)[key] = input.checked;
  });
  return out;
}

// --- Event delegation ---
document.addEventListener('click', (e) => {
  const target = e.target as HTMLElement | null;
  const btn = target?.closest<HTMLElement>('[data-action]');
  if (!btn) return;
  const action = btn.dataset.action;
  if (action === 'accept-all') {
    writeConsent({ analytics: true, marketing: true });
    setState('idle');
  } else if (action === 'reject-all') {
    writeConsent({ analytics: false, marketing: false });
    setState('idle');
  } else if (action === 'open-preferences') {
    loadCurrentIntoToggles();
    setState('preferences');
  } else if (action === 'close-preferences') {
    setState(readConsent() || isPolicyPage ? 'idle' : 'banner');
  } else if (action === 'save-preferences') {
    writeConsent(readTogglesAsCategories());
    setState('idle');
  }
});

// Keyboard: ESC closes preferences (not banner) + Tab focus trap
document.addEventListener('keydown', (e) => {
  const state = document.documentElement.getAttribute('data-consent-state');
  if (state !== 'banner' && state !== 'preferences') return;
  const active = state === 'banner' ? banner : prefs;
  if (!active) return;

  if (e.key === 'Escape' && state === 'preferences') {
    e.preventDefault();
    setState(readConsent() || isPolicyPage ? 'idle' : 'banner');
    return;
  }
  if (e.key === 'Tab') {
    const focusables = getFocusable(active);
    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }
});

// Footer "Cookie Settings" link
const footerBtn = document.getElementById('cookie-settings-link');
if (footerBtn) {
  footerBtn.addEventListener('click', (e) => {
    e.preventDefault();
    loadCurrentIntoToggles();
    setState('preferences');
  });
}

// --- Boot ---
const existing = readConsent() ?? migrateLegacy();
if (existing) {
  syncConsent(existing.categories);
  setState('idle');
} else if (isPolicyPage) {
  // Suppress auto-banner on policy pages so the user can read them.
  // Consent Mode v2 keeps analytics denied by default — fully compliant.
  setState('idle');
} else {
  setState('banner');
}
</script>
