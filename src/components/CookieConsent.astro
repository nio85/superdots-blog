---
/**
 * CookieConsent v3 integration — replaces the old CookieBanner.astro.
 * Uses vanilla-cookieconsent by orestbida.
 *
 * Categories:
 *   - necessary (read-only): sd-theme, cc_cookie, __cf_bm
 *   - analytics (opt-in):    GA4, Clarity
 *   - marketing (opt-in):    empty for now, future-proofing
 *
 * Design overrides: src/styles/cookie-consent.css
 */
---

<script>
import 'vanilla-cookieconsent/dist/cookieconsent.css';
import '../styles/cookie-consent.css';
import * as CookieConsent from 'vanilla-cookieconsent';

declare global {
  interface Window {
    gtag: (...args: any[]) => void;
    SD_startClarity: () => void;
    SD_clarityLoaded: boolean;
    __sdMigrateAnalytics?: boolean;
  }
}

// --- Migration from old sd-cookie-consent localStorage format ---
function checkOldConsent(): boolean {
  const oldConsent = localStorage.getItem('sd-cookie-consent');
  if (!oldConsent) return false;

  const shouldGrantAnalytics = oldConsent === 'accepted';

  // Clean up old keys regardless
  localStorage.removeItem('sd-cookie-consent');
  localStorage.removeItem('sd-cookie-consent-date');

  return shouldGrantAnalytics;
}

const migrateAnalytics = checkOldConsent();

// --- GA4 Consent helpers ---
function updateGtagConsent(analyticsAccepted: boolean, marketingAccepted: boolean) {
  if (typeof window.gtag !== 'function') return;
  window.gtag('consent', 'update', {
    analytics_storage: analyticsAccepted ? 'granted' : 'denied',
    ad_storage: marketingAccepted ? 'granted' : 'denied',
    ad_user_data: marketingAccepted ? 'granted' : 'denied',
    ad_personalization: marketingAccepted ? 'granted' : 'denied',
  });
}

// --- Clarity helper ---
function handleClarity(accepted: boolean) {
  if (accepted && typeof window.SD_startClarity === 'function') {
    window.SD_startClarity();
  }
}

// --- Sync consent state to GA4 + Clarity ---
function syncConsentState() {
  const analyticsAccepted = CookieConsent.acceptedCategory('analytics');
  const marketingAccepted = CookieConsent.acceptedCategory('marketing');
  updateGtagConsent(analyticsAccepted, marketingAccepted);
  handleClarity(analyticsAccepted);
}

// --- Initialize CookieConsent ---
CookieConsent.run({
  // Block page interaction until user makes a choice
  disablePageInteraction: true,

  guiOptions: {
    consentModal: {
      layout: 'box',
      position: 'middle center',
      equalWeightButtons: false,
      flipButtons: false,
    },
    preferencesModal: {
      layout: 'box',
      equalWeightButtons: true,
      flipButtons: false,
    },
  },

  categories: {
    necessary: {
      enabled: true,
      readOnly: true,
    },
    analytics: {
      enabled: migrateAnalytics,
    },
    marketing: {
      enabled: false,
    },
  },

  onFirstConsent: () => {
    syncConsentState();
  },

  onConsent: () => {
    syncConsentState();
  },

  onChange: () => {
    syncConsentState();
  },

  language: {
    default: 'en',
    translations: {
      en: {
        consentModal: {
          title: 'A word on cookies.',
          description:
            'We use Google Analytics and Microsoft Clarity to see which articles actually get read. No personal data is sold, shared, or creepy. <a href="/cookie-policy/">The full story →</a>',
          acceptAllBtn: 'Allow all',
          acceptNecessaryBtn: 'Only essential',
          showPreferencesBtn: 'Choose',
          footer:
            '<a href="/privacy/">Privacy</a> · <a href="/cookie-policy/">Cookie policy</a>',
        },
        preferencesModal: {
          title: 'Your call.',
          acceptAllBtn: 'Allow all',
          acceptNecessaryBtn: 'Only essential',
          savePreferencesBtn: 'Save choices',
          closeIconLabel: 'Close',
          sections: [
            {
              title: 'Three categories. No dark patterns.',
              description:
                'Toggle what you want. We remember your choice for 6 months. Essential cookies stay on — without them the site breaks.',
            },
            {
              title: 'Essential',
              description:
                'Theme preference and this very consent record. Nothing else.',
              linkedCategory: 'necessary',
            },
            {
              title: 'Analytics',
              description:
                'Google Analytics (GA4) and Microsoft Clarity. Aggregate reading patterns and heatmaps — no names, no emails, no selling.',
              linkedCategory: 'analytics',
            },
            {
              title: 'Marketing',
              description:
                'Reserved for the future. Nothing active today.',
              linkedCategory: 'marketing',
            },
            {
              title: 'Questions?',
              description:
                'The whole policy is <a href="/cookie-policy/">right here</a>. Written in plain English, no legalese.',
            },
          ],
        },
      },
    },
  },
});

// --- Wire footer "Cookie Settings" button ---
const settingsBtn = document.getElementById('cookie-settings-link');
if (settingsBtn) {
  settingsBtn.addEventListener('click', (e) => {
    e.preventDefault();
    CookieConsent.showPreferences();
  });
}
</script>
