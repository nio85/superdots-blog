---
import '../styles/global.css';
import { SITE_TITLE, GA_MEASUREMENT_ID, CLARITY_PROJECT_ID } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, type = 'website', publishedTime, modifiedTime } = Astro.props;
const ogImage = new URL(image || '/images/og-default.png', Astro.url);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://superdots.sh';
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Theme: prevent FOUC by reading preference before render -->
<script is:inline>
(function() {
	var stored = localStorage.getItem('sd-theme');
	var theme = stored || 'auto';
	document.documentElement.setAttribute('data-theme', theme);
})();
</script>

<!-- Preconnect to third-party origins used by analytics (only after cookie consent) -->
<script is:inline>
(function() {
	if (localStorage.getItem('sd-analytics-optout') === 'true') return;
	if (localStorage.getItem('sd-cookie-consent') !== 'accepted') return;
	var pc = document.createElement('link');
	pc.rel = 'preconnect'; pc.href = 'https://www.googletagmanager.com'; pc.crossOrigin = '';
	document.head.appendChild(pc);
	var dp = document.createElement('link');
	dp.rel = 'dns-prefetch'; dp.href = 'https://www.clarity.ms';
	document.head.appendChild(dp);
})();
</script>

<!-- Fonts: self-hosted variable (latin subset) — only preload critical fonts -->
<link rel="preload" href="/fonts/space-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<!-- JetBrains Mono: prefetch only (used in code blocks, not render-critical) -->
<link rel="prefetch" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<style is:inline>
@font-face {
	font-family: 'Space Grotesk';
	font-style: normal;
	font-display: swap;
	font-weight: 400 700;
	src: url('/fonts/space-grotesk-latin-wght-normal.woff2') format('woff2');
	unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
	font-family: 'Inter';
	font-style: normal;
	font-display: swap;
	font-weight: 400 700;
	src: url('/fonts/inter-latin-wght-normal.woff2') format('woff2');
	unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
	font-family: 'JetBrains Mono';
	font-style: normal;
	font-display: swap;
	font-weight: 400 500;
	src: url('/fonts/jetbrains-mono-latin-wght-normal.woff2') format('woff2');
	unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
</style>
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="ai-generated" content="true" />
<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Superdots" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url.toString()} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.toString()} />

<!-- Google Analytics (GA4) — loaded only after cookie consent; skipped entirely when opted out -->
<script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
if (localStorage.getItem('sd-analytics-optout') !== 'true') {
	window.SD_GA_ID = gaId;
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	window.gtag = gtag;

	// Consent Mode v2: default all consent to denied (required for EU/EEA traffic)
	gtag('consent', 'default', {
		analytics_storage: 'denied',
		ad_storage: 'denied',
		ad_user_data: 'denied',
		ad_personalization: 'denied',
		wait_for_update: 500
	});

	(function() {
		// Always load gtag.js so consent mode signals are sent to GA4
		var s = document.createElement('script');
		s.async = true;
		s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
		document.head.appendChild(s);
		gtag('js', new Date());
		gtag('config', gaId);

		// If user already consented, grant analytics immediately
		var consent = localStorage.getItem('sd-cookie-consent');
		if (consent === 'accepted') {
			gtag('consent', 'update', {
				analytics_storage: 'granted'
			});
		}
	})();
}
</script>

<!-- Microsoft Clarity — heatmaps & session recordings (consent-aware; skipped when opted out) -->
{CLARITY_PROJECT_ID && (
<script is:inline define:vars={{ clarityId: CLARITY_PROJECT_ID }}>
if (localStorage.getItem('sd-analytics-optout') !== 'true') {
	window.SD_CLARITY_ID = clarityId;
	window.SD_startClarity = function() {
		if (window.SD_clarityLoaded) return;
		window.SD_clarityLoaded = true;
		(function(c,l,a,r,i,t,y){
			c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
			t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
			y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
		})(window, document, "clarity", "script", clarityId);
	};
	// Start immediately if user already consented
	if (localStorage.getItem('sd-cookie-consent') === 'accepted') {
		window.SD_startClarity();
	}
}
</script>
)}

<!-- Organization schema (all pages) -->
<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "Superdots",
	"url": siteUrl,
	"logo": `${siteUrl}/favicon.svg`,
	"sameAs": []
})} />

{isHomePage && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": "Superdots",
		"url": siteUrl,
		"description": "Practical AI guides for every department. No fluff, just useful stuff.",
		"potentialAction": {
			"@type": "SearchAction",
			"target": {
				"@type": "EntryPoint",
				"urlTemplate": `${siteUrl}/blog?q={search_term_string}`
			},
			"query-input": "required name=search_term_string"
		}
	})} />
)}
