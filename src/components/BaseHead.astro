---
import '../styles/global.css';
import { SITE_TITLE } from '../consts';
import { consentInlineScript } from '../lib/consent-inline';
import AnalyticsScripts from './AnalyticsScripts.astro';
import MarketingPixels from './MarketingPixels.astro';
import StructuredData from './StructuredData.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	ogTitle?: string;        // raw title for og:title/twitter:title (no brand suffix)
	imageAlt?: string;       // for og:image:alt + twitter:image:alt
	articleAuthorUrl?: string; // for article:author
	section?: string;        // for article:section
	tags?: string[];         // for article:tag (multiple allowed)
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, type = 'website', publishedTime, modifiedTime, ogTitle, imageAlt, articleAuthorUrl, section, tags } = Astro.props;
const ogImage = new URL(image || '/images/og-default.png', Astro.url);
const socialTitle = ogTitle || title;
const ext = ogImage.pathname.split('.').pop()?.toLowerCase();
const ogImageType = ext === 'webp' ? 'image/webp' : ext === 'png' ? 'image/png' : ext === 'jpg' || ext === 'jpeg' ? 'image/jpeg' : undefined;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://superdots.sh';
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Theme: prevent FOUC by reading preference before render -->
<script is:inline>
(function() {
	var stored = localStorage.getItem('sd-theme');
	var theme = stored || 'dark';
	document.documentElement.setAttribute('data-theme', theme);
})();
</script>

<!-- Consent helper: defines window.SD_readConsent + window.SD_isOptedOut -->
<script is:inline set:html={consentInlineScript} />

<!-- Analytics deferral: queue scripts to load after page is interactive -->
<script is:inline>
	window.SD_deferAnalytics = function(fn) {
		function run() {
			if (typeof requestIdleCallback === 'function') {
				requestIdleCallback(fn);
			} else {
				setTimeout(fn, 200);
			}
		}
		if (document.readyState === 'complete') { run(); }
		else { window.addEventListener('load', run, { once: true }); }
	};
</script>

<!-- Fonts: self-hosted variable (latin subset) — only preload critical fonts -->
<link rel="preload" href="/fonts/space-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<!-- JetBrains Mono: prefetch only (used in code blocks, not render-critical) -->
<link rel="prefetch" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<style is:inline>
@font-face {
	font-family: 'Space Grotesk';
	font-style: normal;
	font-display: swap;
	font-weight: 400 700;
	src: url('/fonts/space-grotesk-latin-wght-normal.woff2') format('woff2');
	unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
	font-family: 'Inter';
	font-style: normal;
	font-display: swap;
	font-weight: 400 700;
	src: url('/fonts/inter-latin-wght-normal.woff2') format('woff2');
	unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
	font-family: 'JetBrains Mono';
	font-style: normal;
	font-display: swap;
	font-weight: 400 500;
	src: url('/fonts/jetbrains-mono-latin-wght-normal.woff2') format('woff2');
	unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
</style>
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="ai-generated" content="true" />
<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Superdots" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{ogImageType && <meta property="og:image:type" content={ogImageType} />}
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{articleAuthorUrl && <meta property="article:author" content={articleAuthorUrl} />}
{section && <meta property="article:section" content={section} />}
{tags && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.toString()} />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.toString()} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

<AnalyticsScripts />
<MarketingPixels />
<StructuredData siteUrl={siteUrl} isHomePage={isHomePage} />
