---
import '../styles/global.css';
import { SITE_TITLE, GA_MEASUREMENT_ID, CLARITY_PROJECT_ID, UMAMI_WEBSITE_ID, UMAMI_URL, REDDIT_PIXEL_ID } from '../consts';
import { consentInlineScript } from '../lib/consent-inline';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, type = 'website', publishedTime, modifiedTime } = Astro.props;
const ogImage = new URL(image || '/images/og-default.png', Astro.url);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://superdots.sh';
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Theme: prevent FOUC by reading preference before render -->
<script is:inline>
(function() {
	var stored = localStorage.getItem('sd-theme');
	var theme = stored || 'dark';
	document.documentElement.setAttribute('data-theme', theme);
})();
</script>

<!-- Consent helper: defines window.SD_readConsent + window.SD_isOptedOut -->
<script is:inline set:html={consentInlineScript} />

<!-- Analytics deferral: queue scripts to load after page is interactive -->
<script is:inline>
	window.SD_deferAnalytics = function(fn) {
		function run() {
			if (typeof requestIdleCallback === 'function') {
				requestIdleCallback(fn);
			} else {
				setTimeout(fn, 200);
			}
		}
		if (document.readyState === 'complete') { run(); }
		else { window.addEventListener('load', run, { once: true }); }
	};
</script>

<!-- Fonts: self-hosted variable (latin subset) — only preload critical fonts -->
<link rel="preload" href="/fonts/space-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<!-- JetBrains Mono: prefetch only (used in code blocks, not render-critical) -->
<link rel="prefetch" href="/fonts/jetbrains-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
<style is:inline>
@font-face {
	font-family: 'Space Grotesk';
	font-style: normal;
	font-display: swap;
	font-weight: 400 700;
	src: url('/fonts/space-grotesk-latin-wght-normal.woff2') format('woff2');
	unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
	font-family: 'Inter';
	font-style: normal;
	font-display: swap;
	font-weight: 400 700;
	src: url('/fonts/inter-latin-wght-normal.woff2') format('woff2');
	unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
	font-family: 'JetBrains Mono';
	font-style: normal;
	font-display: swap;
	font-weight: 400 500;
	src: url('/fonts/jetbrains-mono-latin-wght-normal.woff2') format('woff2');
	unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
</style>
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="ai-generated" content="true" />
<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content="Superdots" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url.toString()} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.toString()} />

<!-- Google Analytics (GA4) — consent defaults sync (EU compliance), script load deferred -->
<script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID }}>
	if (!window.SD_isOptedOut()) {
		window.SD_GA_ID = gaId;
		window.dataLayer = window.dataLayer || [];
		function gtag() { dataLayer.push(arguments); }
		window.gtag = gtag;

		gtag('consent', 'default', {
			analytics_storage: 'denied',
			ad_storage: 'denied',
			ad_user_data: 'denied',
			ad_personalization: 'denied',
			wait_for_update: 500,
		});

		window.SD_deferAnalytics(function() {
			var s = document.createElement('script');
			s.async = true;
			s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
			document.head.appendChild(s);
			gtag('js', new Date());
			gtag('config', gaId);

			var c = window.SD_readConsent();
			if (c.analytics) {
				gtag('consent', 'update', { analytics_storage: 'granted' });
			}
			if (c.marketing) {
				gtag('consent', 'update', {
					ad_storage: 'granted',
					ad_user_data: 'granted',
					ad_personalization: 'granted',
				});
			}
		});
	}
</script>

<!-- Microsoft Clarity — heatmaps & session recordings (deferred, consent-aware) -->
{CLARITY_PROJECT_ID && (
<script is:inline define:vars={{ clarityId: CLARITY_PROJECT_ID }}>
	if (!window.SD_isOptedOut()) {
		window.SD_CLARITY_ID = clarityId;
		window.SD_startClarity = function() {
			if (window.SD_clarityLoaded) return;
			window.SD_clarityLoaded = true;
			(function(c, l, a, r, i, t, y) {
				c[a] = c[a] || function() { (c[a].q = c[a].q || []).push(arguments); };
				t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
				y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
			})(window, document, 'clarity', 'script', clarityId);
		};
		if (window.SD_readConsent().analytics) {
			window.SD_deferAnalytics(function() { window.SD_startClarity(); });
		}
	}
</script>
)}

<!-- Umami Analytics (privacy-friendly, cookie-free — deferred) -->
{UMAMI_WEBSITE_ID && (
<script is:inline define:vars={{ UMAMI_URL, UMAMI_WEBSITE_ID }}>
  if (location.hostname === 'superdots.sh') {
    window.SD_startUmamiRecorder = function() {
      if (window.SD_umamiRecorderLoaded) return;
      window.SD_umamiRecorderLoaded = true;
      var r = document.createElement('script');
      r.src = UMAMI_URL + '/recorder.js';
      r.defer = true;
      r.setAttribute('data-website-id', UMAMI_WEBSITE_ID);
      r.setAttribute('data-sample-rate', '1');
      r.setAttribute('data-mask-level', 'moderate');
      r.setAttribute('data-max-duration', '300000');
      document.head.appendChild(r);
    };
    window.SD_deferAnalytics(function() {
      var s = document.createElement('script');
      s.src = UMAMI_URL + '/script.js';
      s.defer = true;
      s.setAttribute('data-website-id', UMAMI_WEBSITE_ID);
      s.setAttribute('data-domains', 'superdots.sh');
      s.setAttribute('data-performance', 'true');
      document.head.appendChild(s);
      if (window.SD_readConsent().analytics) {
        window.SD_startUmamiRecorder();
      }
    });
  }
</script>
)}

<!-- Reddit Pixel — marketing consent required (deferred) -->
{REDDIT_PIXEL_ID && (
<script is:inline define:vars={{ redditPixelId: REDDIT_PIXEL_ID }}>
	if (location.hostname === 'superdots.sh' && !window.SD_isOptedOut() && window.SD_readConsent().marketing) {
		window.SD_deferAnalytics(function() {
			!function(w, d) {
				if (!w.rdt) {
					var p = w.rdt = function() { p.sendEvent ? p.sendEvent.apply(p, arguments) : p.callQueue.push(arguments); };
					p.callQueue = [];
					var t = d.createElement('script');
					t.src = 'https://www.redditstatic.com/ads/pixel.js';
					t.async = !0;
					var s = d.getElementsByTagName('script')[0];
					s.parentNode.insertBefore(t, s);
				}
			}(window, document);
			rdt('init', redditPixelId);
			rdt('track', 'PageVisit');
		});
	}
</script>
)}

<!-- Organization schema (all pages) -->
<script type="application/ld+json" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Organization",
	"name": "Superdots",
	"url": siteUrl,
	"logo": `${siteUrl}/favicon.svg`,
	"sameAs": []
})} />

{isHomePage && (
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "WebSite",
		"name": "Superdots",
		"url": siteUrl,
		"description": "Practical AI guides for every department. No fluff, just useful stuff.",
		"potentialAction": {
			"@type": "SearchAction",
			"target": {
				"@type": "EntryPoint",
				"urlTemplate": `${siteUrl}/blog?q={search_term_string}`
			},
			"query-input": "required name=search_term_string"
		}
	})} />
)}
