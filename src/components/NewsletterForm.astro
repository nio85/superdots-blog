---
interface Props {
	variant?: 'inline' | 'banner' | 'compact';
	source?: string;
}

const { variant = 'banner', source = 'unknown' } = Astro.props;
---

<div class:list={['newsletter', `newsletter--${variant}`]} data-source={source}>
	{variant === 'banner' && <div class="newsletter-dots" aria-hidden="true"></div>}
	{variant === 'banner' && <div class="newsletter-glow" aria-hidden="true"></div>}
	<div class="newsletter-inner">
		{variant !== 'compact' && (
			<div class="newsletter-text">
				<span class="superdot"></span>
				<h3 class="newsletter-heading">Get AI tips that actually help at work<span class="dot-accent">.</span></h3>
				<p class="newsletter-desc">One email per week. Practical guides, no fluff.</p>
			</div>
		)}
		{variant === 'compact' && (
			<p class="newsletter-compact-label">Get the newsletter<span class="dot-accent">.</span></p>
		)}
		<form class="newsletter-form" aria-label="Newsletter signup">
			<div class="newsletter-field">
				<label for={`newsletter-email-${variant}`} class="sr-only">Email address</label>
				<input
					type="email"
					id={`newsletter-email-${variant}`}
					name="email"
					placeholder={variant === 'compact' ? 'your@email.com' : 'you@company.com'}
					required
					autocomplete="email"
					aria-describedby={`newsletter-legal-${variant}`}
					data-clarity-mask="true"
				/>
				<button type="submit" class="btn btn-primary">{variant === 'compact' ? 'Join' : 'Subscribe'}</button>
			</div>
			{variant !== 'compact' && (
				<p class="newsletter-legal" id={`newsletter-legal-${variant}`}>
					By subscribing, you agree to receive our newsletter. We'll use your email address solely to send you articles about AI at work &mdash; no spam, no sharing. Emails include open and click tracking to help us improve content. You can unsubscribe anytime. See our <a href="/privacy#newsletter">Privacy Policy</a>.
				</p>
			)}
			{variant === 'compact' && (
				<p class="newsletter-legal newsletter-legal--compact" id={`newsletter-legal-${variant}`}>
					No spam. Includes <a href="/privacy#newsletter">email tracking</a>.
				</p>
			)}
			<div class="newsletter-status" role="status" aria-live="polite"></div>
		</form>
	</div>
</div>

<script>
	document.querySelectorAll('.newsletter-form').forEach((form) => {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const el = e.currentTarget as HTMLFormElement;
			const input = el.querySelector('input[type="email"]') as HTMLInputElement;
			const btn = el.querySelector('button[type="submit"]') as HTMLButtonElement;
			const status = el.querySelector('.newsletter-status') as HTMLElement;
			const source = el.closest('.newsletter')?.getAttribute('data-source') || 'unknown';

			const email = input.value.trim();
			if (!email) return;

			btn.disabled = true;
			btn.textContent = 'Sending...';
			status.textContent = '';
			status.className = 'newsletter-status';

			try {
				const res = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email, source }),
				});
				const data = await res.json();

				if (res.ok) {
					status.textContent = 'Check your inbox to confirm your subscription.';
					status.classList.add('newsletter-status--success');
					input.value = '';
				} else {
					status.textContent = data.error || 'Something went wrong. Please try again.';
					status.classList.add('newsletter-status--error');
				}
			} catch {
				status.textContent = 'Network error. Please try again.';
				status.classList.add('newsletter-status--error');
			} finally {
				btn.disabled = false;
				const isCompact = el.closest('.newsletter')?.classList.contains('newsletter--compact');
				btn.textContent = isCompact ? 'Join' : 'Subscribe';
			}
		});
	});
</script>

<style>
	.newsletter {
		border: 2px solid var(--color-border);
		border-radius: var(--radius-xl);
		padding: var(--space-8) var(--space-6);
		margin: var(--space-12) 0;
		position: relative;
		overflow: hidden;
		content-visibility: auto;
		contain-intrinsic-size: auto 320px;
	}
	/* Red left accent bar */
	.newsletter::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 4px;
		height: 100%;
		background: var(--color-primary);
	}
	.newsletter--banner {
		background: var(--color-bg-dim);
		border-color: var(--color-border);
	}
	.newsletter--inline {
		background: transparent;
		margin: var(--space-4) 0;
		padding: var(--space-5) var(--space-4);
		border-radius: var(--radius-lg);
	}
	.newsletter--compact {
		background: transparent;
		border: none;
		margin: 0;
		padding: 0;
	}
	.newsletter--compact::before {
		display: none;
	}
	.newsletter-compact-label {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
		letter-spacing: -0.01em;
	}
	.newsletter--compact .newsletter-field input {
		padding: var(--space-2) var(--space-3);
		font-size: var(--text-sm);
		border-width: 1px;
	}
	.newsletter--compact .newsletter-field button {
		padding: var(--space-2) var(--space-4);
		font-size: var(--text-sm);
	}
	.newsletter-legal--compact {
		font-size: var(--text-xs);
		opacity: 0.7;
	}
	/* Dot pattern decoration — banner variant only */
	.newsletter-dots {
		position: absolute;
		top: -10px;
		right: -10px;
		width: 140px;
		height: 140px;
		background-image: radial-gradient(circle, var(--color-border-strong) 1px, transparent 1px);
		background-size: 14px 14px;
		opacity: 0.3;
		pointer-events: none;
	}
	/* Subtle gradient glow — banner variant only */
	.newsletter-glow {
		position: absolute;
		bottom: -40%;
		right: -15%;
		width: 300px;
		height: 300px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(232, 54, 59, 0.06) 0%, transparent 70%);
		filter: blur(30px);
		pointer-events: none;
	}
	:global([data-theme="dark"]) .newsletter-glow {
		background: radial-gradient(circle, rgba(232, 54, 59, 0.1) 0%, transparent 70%);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .newsletter-glow {
			background: radial-gradient(circle, rgba(232, 54, 59, 0.1) 0%, transparent 70%);
		}
	}
	.newsletter-inner {
		max-width: 560px;
		position: relative;
		z-index: 1;
	}
	.newsletter-text {
		margin-bottom: var(--space-5);
	}
	.newsletter-text .superdot {
		display: inline-block;
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		margin-bottom: var(--space-2);
	}
	.newsletter-heading {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
		letter-spacing: -0.02em;
		line-height: var(--leading-tight);
	}
	.newsletter--inline .newsletter-heading {
		font-size: var(--text-lg);
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.newsletter-desc {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		margin: 0;
	}
	.newsletter-field {
		display: flex;
		gap: var(--space-2);
	}
	.newsletter-field input {
		flex: 1;
		padding: var(--space-3) var(--space-4);
		font-size: var(--text-base);
		font-family: inherit;
		border: 2px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg);
		color: var(--color-text);
		transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
		min-width: 0;
	}
	.newsletter-field input:focus {
		outline: none;
		border-color: var(--color-primary);
		box-shadow: var(--shadow-glow);
	}
	.newsletter-field input::placeholder {
		color: var(--color-text-muted);
		opacity: 0.6;
	}
	.newsletter-field button {
		white-space: nowrap;
		flex-shrink: 0;
	}
	.newsletter-legal {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin: var(--space-2) 0 0;
		line-height: var(--leading-relaxed);
	}
	.newsletter-legal a {
		color: var(--color-text-muted);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.newsletter-legal a:hover {
		color: var(--color-primary);
	}
	.newsletter-status {
		font-size: var(--text-sm);
		margin-top: var(--space-2);
		min-height: 1.4em;
	}
	.newsletter-status--success {
		color: var(--sd-teal, #14B8A6);
	}
	.newsletter-status--error {
		color: var(--color-primary);
	}

	@media (max-width: 480px) {
		.newsletter-field {
			flex-direction: column;
		}
		.newsletter {
			padding: var(--space-6) var(--space-4);
		}
		.newsletter-dots {
			width: 80px;
			height: 80px;
		}
	}
</style>
