---
import NewsletterField from './NewsletterField.astro';

interface Props {
	variant?: 'inline' | 'banner' | 'compact' | 'hero' | 'midpost';
	source?: string;
}

const { variant = 'banner', source = 'unknown' } = Astro.props;

const headingText: Record<string, string> = {
	banner: 'One AI workflow, every Tuesday',
	inline: 'One workflow, every Tuesday.',
	hero: 'One workflow per week. Free.',
	midpost: 'One more, every Tuesday.',
};
const descText: Record<string, string> = {
	banner: 'Step-by-step guides for Sales, Marketing, and Operations — specific tools, real configurations, and honest tradeoffs. One focused issue per week.',
	inline: 'Sales, Marketing, or Operations — specific tools, real steps, honest takes.',
	hero: '',
	midpost: 'Sales, Marketing, or Operations — specific tools, real steps, honest takes.',
};
---

<div class:list={['newsletter', `newsletter--${variant}`]} data-source={source}>
	{(variant === 'banner' || variant === 'midpost' || variant === 'hero') && <div class="newsletter-dots" aria-hidden="true"></div>}
	{(variant === 'banner' || variant === 'midpost' || variant === 'hero') && <div class="newsletter-glow" aria-hidden="true"></div>}
	<div class="newsletter-inner">
		{variant !== 'compact' && variant !== 'hero' && (
			<div class="newsletter-text">
				<span class="superdot"></span>
				<h3 class="newsletter-heading">{headingText[variant] || headingText.banner}<span class="dot-accent">.</span></h3>
				{descText[variant] && <p class="newsletter-desc">{descText[variant]}</p>}
				{variant === 'banner' && (
					<p class="newsletter-social-proof">Published every week since January&nbsp;2026.</p>
				)}
			</div>
		)}
		{variant === 'hero' && (
			<p class="newsletter-hero-label">{headingText.hero}<span class="dot-accent">.</span></p>
		)}
		{variant === 'compact' && (
			<p class="newsletter-compact-label">One workflow, every Tuesday<span class="dot-accent">.</span></p>
		)}
		<NewsletterField variant={variant} />
	</div>
</div>

<style>
	/* --- Base --- */
	.newsletter {
		border: 2px solid var(--color-border);
		border-radius: var(--radius-xl);
		padding: var(--space-8) var(--space-6);
		margin: var(--space-12) 0;
		position: relative;
		overflow: hidden;
		content-visibility: auto;
		contain-intrinsic-size: auto 320px;
	}
	.newsletter::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 4px;
		height: 100%;
		background: var(--color-primary);
	}
	.newsletter-inner {
		max-width: 560px;
		position: relative;
		z-index: 1;
	}
	.newsletter-text {
		margin-bottom: var(--space-5);
	}
	.newsletter-text .superdot {
		display: inline-block;
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		margin-bottom: var(--space-2);
	}
	.newsletter-heading {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
		letter-spacing: -0.02em;
		line-height: var(--leading-tight);
	}
	.newsletter-desc {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		margin: 0;
	}

	/* --- Decorations --- */
	.newsletter-dots {
		position: absolute;
		top: -10px;
		right: -10px;
		width: 140px;
		height: 140px;
		background-image: radial-gradient(circle, var(--color-border-strong) 1px, transparent 1px);
		background-size: 14px 14px;
		opacity: 0.3;
		pointer-events: none;
	}
	.newsletter-glow {
		position: absolute;
		bottom: -40%;
		right: -15%;
		width: 300px;
		height: 300px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(232, 54, 59, 0.06) 0%, transparent 70%);
		filter: blur(30px);
		pointer-events: none;
	}
	:global([data-theme="dark"]) .newsletter-glow {
		background: radial-gradient(circle, rgba(232, 54, 59, 0.1) 0%, transparent 70%);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .newsletter-glow {
			background: radial-gradient(circle, rgba(232, 54, 59, 0.1) 0%, transparent 70%);
		}
	}

	/* --- Banner variant --- */
	.newsletter--banner {
		background: linear-gradient(135deg, var(--color-bg-dim) 0%, var(--color-bg) 50%, var(--color-bg-dim) 100%);
		border: 1px solid var(--color-border);
		padding: var(--space-10) var(--space-8);
		text-align: center;
	}
	.newsletter--banner::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 3px;
		border-radius: var(--radius-full);
		background: var(--color-primary);
	}
	.newsletter--banner::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 3px;
		border-radius: var(--radius-full);
		background: var(--color-primary);
	}
	.newsletter--banner .newsletter-inner { max-width: 460px; margin: 0 auto; }
	.newsletter--banner .newsletter-text { margin-bottom: var(--space-6); }
	.newsletter--banner .newsletter-text .superdot { width: 10px; height: 10px; margin-bottom: var(--space-3); box-shadow: 0 0 12px rgba(232, 54, 59, 0.3); }
	.newsletter--banner .newsletter-heading { font-size: var(--text-2xl); letter-spacing: -0.025em; }
	.newsletter--banner .newsletter-desc { font-size: var(--text-sm); font-weight: var(--weight-medium); opacity: 0.7; }
	.newsletter--banner .newsletter-dots { top: auto; bottom: -10px; left: -10px; right: auto; width: 100px; height: 100px; opacity: 0.2; }
	.newsletter--banner .newsletter-glow { top: -30%; bottom: auto; left: 50%; right: auto; transform: translateX(-50%); width: 400px; height: 400px; background: radial-gradient(circle, rgba(232, 54, 59, 0.05) 0%, transparent 70%); filter: blur(40px); }
	:global([data-theme="dark"]) .newsletter--banner { background: linear-gradient(135deg, var(--color-bg-dim) 0%, var(--color-bg) 50%, var(--color-bg-dim) 100%); }
	.newsletter-social-proof {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin: var(--space-3) 0 0;
		opacity: 0.75;
		letter-spacing: 0.01em;
	}
	.newsletter-social-proof::before {
		content: '';
		display: inline-block;
		width: 5px;
		height: 5px;
		background: var(--color-primary);
		border-radius: 50%;
		opacity: 0.7;
		flex-shrink: 0;
	}

	/* --- Inline variant --- */
	.newsletter--inline {
		background: transparent;
		margin: var(--space-4) 0;
		padding: var(--space-5) var(--space-4);
		border-radius: var(--radius-lg);
	}
	.newsletter--inline .newsletter-heading { font-size: var(--text-lg); }

	/* --- Compact variant --- */
	.newsletter--compact {
		background: transparent;
		border: none;
		margin: 0;
		padding: 0;
	}
	.newsletter--compact::before { display: none; }
	.newsletter-compact-label {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
		letter-spacing: -0.01em;
	}

	/* --- Hero variant --- */
	.newsletter--hero {
		background: linear-gradient(135deg, rgba(232, 54, 59, 0.03) 0%, transparent 60%);
		border: 1px solid var(--color-border);
		margin: 0;
		padding: var(--space-6) var(--space-8);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}
	.newsletter--hero::before { display: none; }
	.newsletter--hero .newsletter-inner { max-width: 480px; margin: 0 auto; }
	.newsletter-hero-label {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		margin: 0 0 var(--space-4);
		text-align: center;
	}
	.newsletter-hero-label .dot-accent { color: var(--color-primary); }
	.newsletter--hero .newsletter-dots { top: auto; bottom: -6px; right: -6px; width: 80px; height: 80px; opacity: 0.15; }
	.newsletter--hero .newsletter-glow { top: -40%; bottom: auto; left: 50%; right: auto; transform: translateX(-50%); width: 300px; height: 300px; background: radial-gradient(circle, rgba(232, 54, 59, 0.04) 0%, transparent 70%); filter: blur(30px); }
	:global([data-theme="dark"]) .newsletter--hero { background: linear-gradient(135deg, rgba(232, 54, 59, 0.06) 0%, transparent 60%); border-color: var(--color-border); }
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .newsletter--hero { background: linear-gradient(135deg, rgba(232, 54, 59, 0.06) 0%, transparent 60%); border-color: var(--color-border); }
	}

	/* --- Midpost variant --- */
	.newsletter--midpost {
		background: linear-gradient(135deg, var(--color-bg-dim) 0%, var(--color-bg) 50%, var(--color-bg-dim) 100%);
		border: 1px solid var(--color-border);
		padding: var(--space-10) var(--space-8);
		margin: var(--space-12) 0;
		text-align: center;
	}
	.newsletter--midpost::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 60px; height: 3px; border-radius: var(--radius-full); background: var(--color-primary); }
	.newsletter--midpost::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 60px; height: 3px; border-radius: var(--radius-full); background: var(--color-primary); }
	.newsletter--midpost .newsletter-inner { max-width: 440px; margin: 0 auto; }
	.newsletter--midpost .newsletter-text { margin-bottom: var(--space-6); }
	.newsletter--midpost .newsletter-text .superdot { width: 10px; height: 10px; margin-bottom: var(--space-3); box-shadow: 0 0 12px rgba(232, 54, 59, 0.3); }
	.newsletter--midpost .newsletter-heading { font-size: var(--text-2xl); letter-spacing: -0.025em; }
	.newsletter--midpost .newsletter-desc { font-size: var(--text-sm); font-weight: var(--weight-medium); opacity: 0.7; }
	.newsletter--midpost .newsletter-dots { top: auto; bottom: -10px; left: -10px; right: auto; width: 100px; height: 100px; opacity: 0.2; }
	.newsletter--midpost .newsletter-glow { top: -30%; bottom: auto; left: 50%; right: auto; transform: translateX(-50%); width: 400px; height: 400px; background: radial-gradient(circle, rgba(232, 54, 59, 0.05) 0%, transparent 70%); filter: blur(40px); }

	/* --- Responsive --- */
	@media (max-width: 480px) {
		.newsletter { padding: var(--space-6) var(--space-4); }
		.newsletter--midpost { padding: var(--space-8) var(--space-5); }
		.newsletter--midpost .newsletter-heading { font-size: var(--text-xl); }
		.newsletter--banner { padding: var(--space-8) var(--space-5); }
		.newsletter--banner .newsletter-heading { font-size: var(--text-xl); }
		.newsletter--hero { padding: var(--space-5) var(--space-4); }
		.newsletter-dots { width: 80px; height: 80px; }
	}
</style>
