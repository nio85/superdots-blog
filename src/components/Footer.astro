---
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-dots" aria-hidden="true"></div>
	<div class="footer-inner">
		<div class="footer-brand">
			<svg class="footer-mark" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<circle cx="14" cy="50" r="6" fill="#E8363B"/>
				<circle cx="32" cy="32" r="8" fill="#E8363B"/>
				<circle cx="50" cy="14" r="10" fill="#E8363B"/>
			</svg>
			<span class="footer-name">Superdots</span>
		</div>
		<p class="footer-tagline">
			<span>Made in Italy</span>
			<span class="sep" aria-hidden="true">·</span>
			<span>Nine AI agents</span>
			<span class="sep" aria-hidden="true">·</span>
			<span>One homelab</span>
		</p>
		<nav class="footer-content" aria-label="Content">
			<a href="/series/">Series</a>
			<a href="/blog/">Blog</a>
			<a href="/guides/">Guides</a>
			<a href="/about/">About</a>
			<a href="/how-we-work/">How We Work</a>
			<a href="/rss.xml">RSS</a>
		</nav>
		<nav class="footer-legal">
			<a href="/privacy/">Privacy Policy</a>
			<a href="/cookie-policy/">Cookie Policy</a>
			<a href="/terms/">Terms of Service</a>
			<button type="button" id="cookie-settings-link" class="footer-cookie-btn">Cookie Settings</button>
		</nav>
		<p class="footer-ai-disclosure">Content on this site is created with AI assistance and reviewed by the Superdots team.</p>
		<p class="footer-copy">&copy; {year} Superdots</p>
	</div>
</footer>

<style>
	footer {
		position: relative;
		border-top: 1px solid var(--color-border);
		padding: var(--space-12) var(--space-4);
		margin-top: var(--space-16);
		overflow: hidden;
		content-visibility: auto;
		contain-intrinsic-size: auto 300px;
	}
	.footer-dots {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(circle, var(--color-text-muted) 1.3px, transparent 1.3px);
		background-size: 22px 22px;
		opacity: 0.1;
		-webkit-mask-image: radial-gradient(ellipse at center, black 10%, transparent 72%);
		mask-image: radial-gradient(ellipse at center, black 10%, transparent 72%);
		pointer-events: none;
	}
	:global([data-theme="dark"]) .footer-dots {
		opacity: 0.18;
	}
	.footer-inner {
		position: relative;
		max-width: var(--max-width-content);
		margin: 0 auto;
		text-align: center;
	}
	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-3);
	}
	.footer-mark {
		width: 32px;
		height: 32px;
		color: var(--color-primary);
		flex-shrink: 0;
		transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.footer-brand:hover .footer-mark {
		transform: rotate(-8deg) scale(1.05);
	}
	.footer-name {
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		font-size: var(--text-xl);
		color: var(--color-text-strong);
		letter-spacing: -0.02em;
	}
	.footer-tagline {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		flex-wrap: wrap;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-text-muted);
		margin: 0 0 var(--space-8);
	}
	.footer-tagline .sep {
		color: var(--color-primary);
	}
	.footer-content {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-bottom: var(--space-4);
	}
	.footer-content a {
		color: var(--color-text);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.footer-content a:hover {
		color: var(--color-primary);
	}
	.footer-legal {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-bottom: var(--space-4);
	}
	.footer-legal a {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.footer-legal a:hover {
		color: var(--color-primary);
	}
	.footer-cookie-btn {
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		font-family: inherit;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.footer-cookie-btn:hover {
		color: var(--color-primary);
	}
	.footer-ai-disclosure {
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		margin: 0 0 var(--space-2);
		opacity: 0.6;
		font-style: italic;
	}
	.footer-copy {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		margin: 0;
		opacity: 0.7;
	}
</style>
