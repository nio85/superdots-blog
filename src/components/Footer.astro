---
import NewsletterForm from './NewsletterForm.astro';
const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<svg class="footer-mark" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<defs>
					<linearGradient id="ft-logo-a" x1="0" y1="1" x2="0.8" y2="0">
						<stop offset="0%" stop-color="#0B1222"/>
						<stop offset="40%" stop-color="#1A2744"/>
						<stop offset="100%" stop-color="#E8363B"/>
					</linearGradient>
					<linearGradient id="ft-logo-b" x1="1" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#F04048"/>
						<stop offset="100%" stop-color="#C42D31"/>
					</linearGradient>
				</defs>
				<circle cx="22" cy="36" r="20" fill="url(#ft-logo-a)"/>
				<circle cx="42" cy="24" r="16" fill="url(#ft-logo-b)" opacity="0.88"/>
			</svg>
			<span class="footer-name">Superdots</span>
		</div>
		<p class="footer-tagline">Practical AI for every team. No fluff, just useful stuff.</p>
		<div class="footer-newsletter">
			<NewsletterForm variant="compact" source="footer" />
		</div>
		<nav class="footer-content" aria-label="Content">
			<a href="/blog/">Blog</a>
			<a href="/category/">Categories</a>
			<a href="/about/">About</a>
			<a href="/rss.xml">RSS</a>
		</nav>
		<nav class="footer-legal">
			<a href="/privacy">Privacy Policy</a>
			<a href="/cookie-policy">Cookie Policy</a>
			<a href="/terms">Terms of Service</a>
			<button type="button" id="cookie-settings-link" class="footer-cookie-btn">Cookie Settings</button>
		</nav>
		<p class="footer-copy">&copy; {year} Superdots</p>
	</div>
</footer>

<style>
	footer {
		border-top: 2px solid var(--color-border);
		padding: var(--space-12) var(--space-4);
		margin-top: var(--space-16);
	}
	.footer-inner {
		max-width: var(--max-width-content);
		margin: 0 auto;
		text-align: center;
	}
	.footer-brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-3);
	}
	.footer-mark {
		width: 20px;
		height: 20px;
		color: var(--color-primary);
		flex-shrink: 0;
	}
	.footer-name {
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		font-size: var(--text-lg);
		color: var(--color-text-strong);
		letter-spacing: -0.02em;
	}
	.footer-tagline {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		margin: 0 0 var(--space-4);
	}
	.footer-newsletter {
		max-width: 560px;
		margin: 0 auto var(--space-6);
		text-align: left;
	}
	.footer-content {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-bottom: var(--space-4);
	}
	.footer-content a {
		color: var(--color-text);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.footer-content a:hover {
		color: var(--color-primary);
	}
	.footer-legal {
		display: flex;
		justify-content: center;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-bottom: var(--space-4);
	}
	.footer-legal a {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.footer-legal a:hover {
		color: var(--color-primary);
	}
	.footer-cookie-btn {
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		font-family: inherit;
		text-decoration: none;
		transition: color 0.15s ease;
	}
	.footer-cookie-btn:hover {
		color: var(--color-primary);
	}
	.footer-copy {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		margin: 0;
		opacity: 0.7;
	}
</style>
