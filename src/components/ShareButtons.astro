---
interface Props {
	url: string;
	title: string;
	description?: string;
}

const { url, title, description } = Astro.props;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const linkedinHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const twitterHref = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
---

<div class="share-buttons" aria-label="Share this article">
	<span class="share-label">Share</span>
	<a href={linkedinHref} target="_blank" rel="noopener noreferrer" class="share-btn share-btn-linkedin" aria-label="Share on LinkedIn" title="Share on LinkedIn">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
			<rect x="2" y="9" width="4" height="12" />
			<circle cx="4" cy="4" r="2" />
		</svg>
	</a>
	<a href={twitterHref} target="_blank" rel="noopener noreferrer" class="share-btn share-btn-twitter" aria-label="Share on X (Twitter)" title="Share on X (Twitter)">
		<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
		</svg>
	</a>
	<button class="share-btn share-btn-copy" aria-label="Copy link to clipboard" title="Copy link">
		<svg class="icon-link" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
			<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
		</svg>
		<svg class="icon-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<polyline points="20 6 9 17 4 12" />
		</svg>
	</button>
</div>

<script define:vars={{ url }}>
	document.querySelectorAll('.share-btn-copy').forEach(function(btn) {
		btn.addEventListener('click', function() {
			navigator.clipboard.writeText(url).then(function() {
				btn.classList.add('copied');
				setTimeout(function() {
					btn.classList.remove('copied');
				}, 2000);
			});
		});
	});

	// Umami event: track share click by platform
	document.querySelectorAll('.share-btn').forEach(function(btn) {
		btn.addEventListener('click', function() {
			var platform = btn.classList.contains('share-btn-linkedin') ? 'linkedin'
				: btn.classList.contains('share-btn-twitter') ? 'twitter'
				: btn.classList.contains('share-btn-copy') ? 'copy'
				: 'unknown';
			if (typeof window.umami !== 'undefined') {
				window.umami.track('article_share', {
					platform: platform,
					path: location.pathname,
				});
			}
		});
	});
</script>

<style>
	.share-buttons {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}
	.share-label {
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		color: var(--color-text-muted);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		margin-right: var(--space-1);
	}
	.share-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text-muted);
		cursor: pointer;
		transition: all var(--transition-fast);
		text-decoration: none;
		padding: 0;
		font: inherit;
	}
	.share-btn:hover {
		color: var(--color-text);
		border-color: var(--color-border-strong);
		background: var(--color-bg-dim);
	}
	.share-btn-linkedin:hover {
		color: #0A66C2;
		border-color: #0A66C2;
	}
	.share-btn-twitter:hover {
		color: var(--color-text-strong);
		border-color: var(--color-text-strong);
	}
	.share-btn-copy .icon-check {
		display: none;
	}
	.share-btn-copy.copied .icon-link {
		display: none;
	}
	.share-btn-copy.copied .icon-check {
		display: block;
		color: var(--sd-teal);
	}
	.share-btn-copy.copied {
		border-color: var(--sd-teal);
	}
</style>
