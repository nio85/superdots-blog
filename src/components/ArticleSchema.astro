---
/**
 * Emits Article + BreadcrumbList + (optional) FAQPage JSON-LD for a blog post.
 * Centralizes SEO schema so BlogPost layout stays focused on layout.
 */
import { PILLARS } from '../consts';
import { authors } from '../data/authors';

interface Faq {
	question: string;
	answer: string;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	author: string;
	contentPillar?: string;
	heroImageSrc?: string;
	faqs?: Faq[];
}

const { title, description, pubDate, updatedDate, author, contentPillar, heroImageSrc, faqs } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://superdots.sh';
const pillarLabel = PILLARS.find((p) => p.slug === (contentPillar || 'dot-by-dot'))?.label || 'Dot by Dot';
const authorData = authors[author] || authors['Superdots Team'];
const isPersonalAuthor = author === 'Luca Bartoccini';

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: isPersonalAuthor
		? { '@type': 'Person', name: author, url: `${siteUrl}${authorData.url}` }
		: { '@type': 'Organization', name: author },
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	...(heroImageSrc && { image: new URL(heroImageSrc, Astro.url).toString() }),
	publisher: {
		'@type': 'Organization',
		name: 'Superdots',
		url: siteUrl,
		logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.svg` },
	},
	articleSection: pillarLabel,
	mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.toString() },
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
		{ '@type': 'ListItem', position: 3, name: title },
	],
};

const faqSchema = faqs && faqs.length > 0
	? {
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqs.map((faq) => ({
			'@type': 'Question',
			name: faq.question,
			acceptedAnswer: { '@type': 'Answer', text: faq.answer },
		})),
	}
	: null;
---

<script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
