<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent" style="display:none;">
	<div class="cookie-banner-inner">
		<div class="cookie-banner-content">
			<p class="cookie-banner-title">We value your privacy</p>
			<p class="cookie-banner-text">
				We use Google Analytics cookies to understand how you use our site and improve our content.
				No personal data is collected. <a href="/cookie-policy">Learn more</a>
			</p>
		</div>
		<div class="cookie-banner-actions">
			<button id="cookie-reject" class="cookie-btn cookie-btn-secondary" type="button">
				Reject all
			</button>
			<button id="cookie-accept" class="cookie-btn cookie-btn-primary" type="button">
				Accept analytics
			</button>
		</div>
	</div>
</div>

<script is:inline>
(function() {
	var consent = localStorage.getItem('sd-cookie-consent');
	if (consent) return;

	var banner = document.getElementById('cookie-banner');
	if (!banner) return;
	banner.style.display = '';

	document.getElementById('cookie-accept').addEventListener('click', function() {
		localStorage.setItem('sd-cookie-consent', 'accepted');
		localStorage.setItem('sd-cookie-consent-date', new Date().toISOString());
		banner.style.display = 'none';

		var gaId = window.SD_GA_ID;
		if (gaId) {
			var s = document.createElement('script');
			s.async = true;
			s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
			document.head.appendChild(s);
			window.gtag('js', new Date());
			window.gtag('config', gaId);
		}
	});

	document.getElementById('cookie-reject').addEventListener('click', function() {
		localStorage.setItem('sd-cookie-consent', 'rejected');
		localStorage.setItem('sd-cookie-consent-date', new Date().toISOString());
		banner.style.display = 'none';
	});
})();

/* Allow re-opening cookie settings from footer link */
document.addEventListener('DOMContentLoaded', function() {
	var settingsLink = document.getElementById('cookie-settings-link');
	if (settingsLink) {
		settingsLink.addEventListener('click', function(e) {
			e.preventDefault();
			localStorage.removeItem('sd-cookie-consent');
			localStorage.removeItem('sd-cookie-consent-date');
			var banner = document.getElementById('cookie-banner');
			if (banner) banner.style.display = '';
		});
	}
});
</script>

<style>
