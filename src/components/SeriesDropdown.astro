---
import { PILLARS } from '../consts';

interface Props {
	pathname: string;
}

const { pathname } = Astro.props;

const PILLAR_COLORS: Record<string, string> = {
	'dot-by-dot': '#E8363B',
	'connecting-the-dots': '#14B8A6',
	'the-big-picture': '#6366F1',
	'behind-the-dots': '#F59E0B',
};
---

<div class="nav-dropdown">
	<a
		href="/series/"
		class:list={[{ active: pathname.startsWith('/series/') }]}
		aria-current={pathname.startsWith('/series/') ? 'page' : undefined}
	>
		Series
		<svg class="dropdown-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
	</a>
	<div class="dropdown-panel">
		{PILLARS.map((p) => (
			<a href={`/series/${p.slug}/`} class="dropdown-item">
				<span class="dropdown-dot" style={`background: ${PILLAR_COLORS[p.slug]};`} aria-hidden="true"></span>
				<span>
					<span class="dropdown-item-name">{p.label}</span>
					<span class="dropdown-item-desc">{p.description}</span>
				</span>
			</a>
		))}
	</div>
</div>

<style>
	.nav-dropdown {
		position: relative;
	}
	.dropdown-chevron {
		display: inline-block;
		vertical-align: middle;
		margin-left: 2px;
		transition: transform var(--transition-fast);
	}
	.nav-dropdown:hover .dropdown-chevron {
		transform: rotate(180deg);
	}
	.dropdown-panel {
		display: none;
		position: absolute;
		top: calc(100% + var(--space-2));
		left: 50%;
		transform: translateX(-50%);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		padding: var(--space-2);
		min-width: 280px;
		z-index: 100;
	}
	.nav-dropdown:hover .dropdown-panel,
	.nav-dropdown:focus-within .dropdown-panel {
		display: block;
	}
	.dropdown-item {
		display: flex;
		align-items: flex-start;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-3);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition: background var(--transition-fast);
	}
	.dropdown-item:hover {
		background: var(--color-bg-dim);
		text-decoration: none;
	}
	.dropdown-item::after { display: none; }
	.dropdown-dot {
		width: 8px;
		height: 8px;
		border-radius: var(--radius-full);
		flex-shrink: 0;
		margin-top: 6px;
	}
	.dropdown-item-name {
		display: block;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		line-height: var(--leading-tight);
	}
	.dropdown-item-desc {
		display: block;
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		line-height: var(--leading-snug);
		margin-top: 2px;
	}
</style>
