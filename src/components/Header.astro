---
import { SITE_TITLE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import SeriesDropdown from './SeriesDropdown.astro';
import MobileMenu from './MobileMenu.astro';

const pathname = Astro.url.pathname;

const navLinks = [
	{ href: '/series/', label: 'Series' },
	{ href: '/blog/', label: 'Articles' },
	{ href: '/guides/', label: 'Guides' },
	{ href: '/about/', label: 'About' },
];
---

<header>
	<nav aria-label="Main navigation">
		<a href="/" class="logo">
			<svg class="logo-mark" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<circle cx="14" cy="50" r="6" fill="#E8363B"/>
				<circle cx="32" cy="32" r="8" fill="#E8363B"/>
				<circle cx="50" cy="14" r="10" fill="#E8363B"/>
			</svg>
			<span class="logo-text">{SITE_TITLE}</span>
		</a>

		<div class="nav-right">
			<div class="nav-links" id="nav-links">
				<SeriesDropdown pathname={pathname} />
				{navLinks.filter(l => l.href !== '/series/').map(({ href, label }) => (
					<a
						href={href}
						class:list={[{ active: pathname.startsWith(href) }]}
						aria-current={pathname.startsWith(href) ? 'page' : undefined}
					>
						{label}
					</a>
				))}
			</div>

			<ThemeToggle />

			<button
				class="hamburger"
				id="hamburger"
				type="button"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<span class="hamburger-line"></span>
				<span class="hamburger-line"></span>
				<span class="hamburger-line"></span>
			</button>
		</div>
	</nav>
</header>

<MobileMenu navLinks={navLinks} pathname={pathname} />

<style>
	header {
		border-bottom: 1px solid var(--color-border);
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgb(255, 255, 255);
	}
	@supports (backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px)) {
		header {
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			background: rgba(255, 255, 255, 0.92);
		}
	}
	:global([data-theme="dark"]) header {
		background: rgb(11, 18, 34);
	}
	@supports (backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px)) {
		:global([data-theme="dark"]) header {
			background: rgba(11, 18, 34, 0.92);
		}
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) header {
			background: rgb(11, 18, 34);
		}
		@supports (backdrop-filter: blur(12px)) or (-webkit-backdrop-filter: blur(12px)) {
			:global([data-theme="auto"]) header {
				background: rgba(11, 18, 34, 0.92);
			}
		}
	}

	nav {
		max-width: var(--max-width-content);
		margin: 0 auto;
		padding: var(--space-4);
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		text-decoration: none;
		z-index: 110;
	}
	.logo:hover {
		text-decoration: none;
	}
	.logo:hover .logo-mark {
		transform: scale(1.15);
	}
	.logo-mark {
		width: 24px;
		height: 24px;
		color: var(--color-primary);
		transition: transform var(--transition-base);
		flex-shrink: 0;
	}
	.logo-text {
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		font-size: var(--text-xl);
		color: var(--color-text-strong);
		letter-spacing: -0.02em;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.nav-links {
		display: flex;
		gap: var(--space-6);
	}
	.nav-links a {
		font-family: var(--font-display);
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		transition: color var(--transition-fast);
		position: relative;
		padding-bottom: var(--space-1);
	}
	.nav-links a::after {
		content: '';
		position: absolute;
		bottom: -2px;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		transform: scaleX(0);
		transition: transform var(--transition-base);
	}
	.nav-links a:hover {
		color: var(--color-text-strong);
		text-decoration: none;
	}
	.nav-links a:hover::after {
		transform: scaleX(1);
	}
	.nav-links a.active {
		color: var(--color-text-strong);
	}
	.nav-links a.active::after {
		transform: scaleX(1);
	}

	.hamburger {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: 36px;
		height: 36px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg-dim);
		cursor: pointer;
		padding: 0;
		gap: 5px;
		z-index: 110;
		transition: border-color var(--transition-fast);
	}
	.hamburger:hover {
		border-color: var(--color-border-strong);
	}
	.hamburger-line {
		display: block;
		width: 18px;
		height: 2px;
		background: var(--color-text-muted);
		border-radius: var(--radius-full);
		transition: transform var(--transition-base), opacity var(--transition-base);
		transform-origin: center;
	}
	.hamburger.is-active .hamburger-line:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.hamburger.is-active .hamburger-line:nth-child(2) {
		opacity: 0;
		transform: scaleX(0);
	}
	.hamburger.is-active .hamburger-line:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	@media (max-width: 767px) {
		.nav-links {
			display: none;
		}
		.hamburger {
			display: flex;
		}
	}

	@media (max-width: 480px) {
		nav {
			padding: var(--space-3) var(--space-4);
		}
		.logo-text {
			font-size: var(--text-lg);
		}
		.nav-right {
			gap: var(--space-2);
		}
	}
</style>
