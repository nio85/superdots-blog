---
/**
 * Mid-article newsletter CTA, injected via JS at ~40% of the prose content
 * (snapped to the nearest H2/H3 break for clean placement).
 *
 * Copy is department-specific when a known department is provided, otherwise
 * falls back to a generic variant.
 *
 * NOTE: submit logic is currently duplicated with NewsletterForm.astro.
 * Consolidation tracked in Epic #8 (duplicate logic consolidation).
 */

interface Props {
	department?: string;
}

const { department = '' } = Astro.props;
---

<template id="midpost-cta-template" data-department={department}>
	<aside class="newsletter newsletter--midpost" data-source="article-inline" aria-label="Newsletter signup">
		<div class="newsletter-dots" aria-hidden="true"></div>
		<div class="newsletter-glow" aria-hidden="true"></div>
		<div class="newsletter-inner">
			<div class="newsletter-text">
				<span class="superdot"></span>
				<h3 class="newsletter-heading"></h3>
				<p class="newsletter-desc"></p>
			</div>
			<form class="newsletter-form" aria-label="Newsletter signup">
				<div class="newsletter-field">
					<label for="newsletter-email-midpost" class="sr-only">Email address</label>
					<input
						type="email"
						id="newsletter-email-midpost"
						name="email"
						placeholder="you@company.com"
						required
						autocomplete="email"
						data-clarity-mask="true"
					/>
					<button type="submit" class="btn btn-primary">Count me in</button>
				</div>
				<p class="newsletter-legal">
					No spam. We respect your <a href="/privacy#newsletter">privacy</a>. Unsubscribe anytime.
				</p>
				<div class="newsletter-status" role="status" aria-live="polite"></div>
			</form>
		</div>
	</aside>
</template>

<script>
	(() => {
		const prose = document.getElementById('article-prose');
		const tpl = document.getElementById('midpost-cta-template') as HTMLTemplateElement | null;
		if (!prose || !tpl) return;

		const children = Array.from(prose.children);
		if (children.length < 6) return; // Skip short articles

		const dept = tpl.dataset.department || '';
		const deptCopy: Record<string, { heading: string; desc: string }> = {
			sales: {
				heading: 'AI workflows for sales teams, every Tuesday',
				desc: 'Prospecting, objection handling, pipeline automation — one hands-on guide per week.',
			},
			marketing: {
				heading: 'AI workflows for marketing teams, every Tuesday',
				desc: 'Content, campaigns, analytics — one hands-on guide per week.',
			},
			hr: {
				heading: 'AI workflows for HR teams, every Tuesday',
				desc: 'Recruiting, onboarding, people ops — one hands-on guide per week.',
			},
			finance: {
				heading: 'AI workflows for finance teams, every Tuesday',
				desc: 'Forecasting, reporting, compliance — one hands-on guide per week.',
			},
			operations: {
				heading: 'AI workflows for ops teams, every Tuesday',
				desc: 'Process automation, supply chain, resource planning — one hands-on guide per week.',
			},
			legal: {
				heading: 'AI workflows for legal teams, every Tuesday',
				desc: 'Contract review, research, compliance — one hands-on guide per week.',
			},
			engineering: {
				heading: 'AI workflows for engineering teams, every Tuesday',
				desc: 'Code review, debugging, infrastructure — one hands-on guide per week.',
			},
			design: {
				heading: 'AI workflows for design teams, every Tuesday',
				desc: 'Prototyping, asset generation, user research — one hands-on guide per week.',
			},
			'customer-support': {
				heading: 'AI workflows for support teams, every Tuesday',
				desc: 'Ticket triage, knowledge base, response drafting — one hands-on guide per week.',
			},
		};
		const copy = deptCopy[dept] || {
			heading: 'Enjoying this? Get one like it every week',
			desc: 'Practical AI guides for your team — delivered every Tuesday.',
		};

		// Find nearest H2/H3 break near the 40% mark for clean placement
		const targetIndex = Math.floor(children.length * 0.4);
		let insertIndex = targetIndex;
		for (let i = targetIndex; i < Math.min(targetIndex + 4, children.length); i++) {
			const tag = children[i].tagName;
			if (tag === 'H2' || tag === 'H3') {
				insertIndex = i;
				break;
			}
		}

		const cta = tpl.content.cloneNode(true) as DocumentFragment;
		const heading = cta.querySelector('.newsletter-heading');
		const desc = cta.querySelector('.newsletter-desc');
		if (heading) heading.innerHTML = `${copy.heading}<span class="dot-accent">.</span>`;
		if (desc) desc.textContent = copy.desc;
		children[insertIndex].before(cta);

		// Bind submit handler on the injected form
		const injectedForm = prose.querySelector('.newsletter--midpost .newsletter-form');
		if (!injectedForm) return;
		injectedForm.addEventListener('submit', async (e) => {
			e.preventDefault();
			const el = e.currentTarget as HTMLFormElement;
			const input = el.querySelector('input[type="email"]') as HTMLInputElement;
			const btn = el.querySelector('button[type="submit"]') as HTMLButtonElement;
			const status = el.querySelector('.newsletter-status') as HTMLElement;
			const email = input.value.trim();
			if (!email) return;
			btn.disabled = true;
			btn.textContent = 'Sending...';
			status.textContent = '';
			status.className = 'newsletter-status';
			try {
				const res = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email, source: 'article-inline' }),
				});
				const data = await res.json();
				if (res.ok) {
					status.textContent = 'Check your inbox to confirm.';
					status.classList.add('newsletter-status--success');
					input.value = '';
				} else {
					status.textContent = data.error || 'Something went wrong.';
					status.classList.add('newsletter-status--error');
				}
			} catch {
				status.textContent = 'Network error. Please try again.';
				status.classList.add('newsletter-status--error');
			} finally {
				btn.disabled = false;
				btn.textContent = 'Count me in';
			}
		});
	})();
</script>

<style is:global>
	.newsletter--midpost {
		background: linear-gradient(135deg, var(--color-bg-dim) 0%, var(--color-bg) 50%, var(--color-bg-dim) 100%);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		padding: var(--space-10) var(--space-8);
		margin: var(--space-12) 0;
		position: relative;
		overflow: hidden;
		text-align: center;
	}
	.newsletter--midpost::before,
	.newsletter--midpost::after {
		content: '';
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
		width: 60px;
		height: 3px;
		border-radius: var(--radius-full);
		background: var(--color-primary);
	}
	.newsletter--midpost::before { top: 0; }
	.newsletter--midpost::after { bottom: 0; }
	.newsletter--midpost .newsletter-dots {
		position: absolute;
		bottom: -10px;
		left: -10px;
		width: 100px;
		height: 100px;
		background-image: radial-gradient(circle, var(--color-border-strong) 1px, transparent 1px);
		background-size: 14px 14px;
		opacity: 0.2;
		pointer-events: none;
	}
	.newsletter--midpost .newsletter-glow {
		position: absolute;
		top: -30%;
		left: 50%;
		transform: translateX(-50%);
		width: 400px;
		height: 400px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(232, 54, 59, 0.05) 0%, transparent 70%);
		filter: blur(40px);
		pointer-events: none;
	}
	.newsletter--midpost .newsletter-inner {
		max-width: 440px;
		margin: 0 auto;
		position: relative;
		z-index: 1;
	}
	.newsletter--midpost .newsletter-text {
		margin-bottom: var(--space-6);
	}
	.newsletter--midpost .newsletter-text .superdot {
		display: inline-block;
		width: 10px;
		height: 10px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		margin-bottom: var(--space-3);
		box-shadow: 0 0 12px rgba(232, 54, 59, 0.3);
	}
	.newsletter--midpost .newsletter-heading {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
		letter-spacing: -0.025em;
		line-height: var(--leading-tight);
	}
	.newsletter--midpost .newsletter-desc {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		letter-spacing: 0.02em;
		text-transform: uppercase;
		font-weight: var(--weight-medium);
		opacity: 0.7;
		margin: 0;
	}
	.newsletter--midpost .newsletter-field {
		display: flex;
		gap: var(--space-2);
		justify-content: center;
	}
	.newsletter--midpost .newsletter-field input {
		flex: 1;
		max-width: 240px;
		padding: var(--space-3) var(--space-4);
		font-size: var(--text-base);
		font-family: inherit;
		border: 2px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg);
		color: var(--color-text);
		transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
		min-width: 0;
	}
	.newsletter--midpost .newsletter-field input:focus {
		outline: none;
		border-color: var(--color-primary);
		box-shadow: var(--shadow-glow);
	}
	.newsletter--midpost .newsletter-field input::placeholder {
		color: var(--color-text-muted);
		opacity: 0.6;
	}
	.newsletter--midpost .newsletter-field button {
		white-space: nowrap;
		flex-shrink: 0;
	}
	.newsletter--midpost .newsletter-legal {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin: var(--space-2) 0 0;
		line-height: var(--leading-relaxed);
		text-align: center;
	}
	.newsletter--midpost .newsletter-legal a {
		color: var(--color-text-muted);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.newsletter--midpost .newsletter-legal a:hover {
		color: var(--color-primary);
	}
	.newsletter--midpost .newsletter-status {
		font-size: var(--text-sm);
		margin-top: var(--space-2);
		min-height: 1.4em;
		text-align: center;
	}
	.newsletter--midpost .newsletter-status--success {
		color: var(--sd-teal, #14B8A6);
	}
	.newsletter--midpost .newsletter-status--error {
		color: var(--color-primary);
	}
	/* Dark mode */
	[data-theme="dark"] .newsletter--midpost {
		background: linear-gradient(135deg, var(--color-bg-dim) 0%, rgba(15, 23, 42, 0.8) 50%, var(--color-bg-dim) 100%);
		border-color: var(--color-border);
	}
	[data-theme="dark"] .newsletter--midpost .newsletter-glow {
		background: radial-gradient(circle, rgba(232, 54, 59, 0.08) 0%, transparent 70%);
	}
	@media (prefers-color-scheme: dark) {
		[data-theme="auto"] .newsletter--midpost {
			background: linear-gradient(135deg, var(--color-bg-dim) 0%, rgba(15, 23, 42, 0.8) 50%, var(--color-bg-dim) 100%);
			border-color: var(--color-border);
		}
		[data-theme="auto"] .newsletter--midpost .newsletter-glow {
			background: radial-gradient(circle, rgba(232, 54, 59, 0.08) 0%, transparent 70%);
		}
	}
	/* Mobile */
	@media (max-width: 480px) {
		.newsletter--midpost {
			padding: var(--space-8) var(--space-5);
		}
		.newsletter--midpost .newsletter-heading {
			font-size: var(--text-xl);
		}
		.newsletter--midpost .newsletter-field {
			flex-direction: column;
		}
		.newsletter--midpost .newsletter-field input {
			max-width: 100%;
		}
	}
</style>
