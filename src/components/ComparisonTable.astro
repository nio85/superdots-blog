---
/**
 * ComparisonTable — Responsive tool comparison table for monetization pages.
 *
 * Usage:
 *   <ComparisonTable tools={[
 *     { name: "ToolName", url: "https://...", features: "Key feature list", pricing: "$29/mo", bestFor: "Small teams", rating: 4.5, ctaText: "Try free", ctaUrl: "https://..." },
 *   ]} />
 */

interface Tool {
	name: string;
	logo?: string;
	url?: string;
	features: string;
	pricing: string;
	bestFor: string;
	rating: number;
	ctaText?: string;
	ctaUrl: string;
}

interface Props {
	tools: Tool[];
	caption?: string;
}

const { tools, caption } = Astro.props;

function renderStars(rating: number): string {
	const full = Math.floor(rating);
	const half = rating % 1 >= 0.25 && rating % 1 < 0.75 ? 1 : 0;
	const bump = rating % 1 >= 0.75 ? 1 : 0;
	const filled = full + bump;
	const empty = 5 - filled - half;
	return '★'.repeat(filled) + (half ? '½' : '') + '☆'.repeat(empty);
}
---

<div class="comparison-table-wrap">
	{caption && <p class="comparison-caption">{caption}</p>}

	{/* Desktop: scrollable table */}
	<div class="comparison-scroll" role="region" aria-label="Tool comparison table" tabindex="0">
		<table class="comparison-table">
			<thead>
				<tr>
					<th>Tool</th>
					<th>Key Features</th>
					<th>Pricing</th>
					<th>Best For</th>
					<th>Rating</th>
					<th><span class="sr-only">Action</span></th>
				</tr>
			</thead>
			<tbody>
				{tools.map((tool) => (
					<tr>
						<td class="tool-name-cell">
							{tool.logo && <img src={tool.logo} alt="" class="tool-logo" width="24" height="24" loading="lazy" />}
							{tool.url ? <a href={tool.url} rel="noopener">{tool.name}</a> : tool.name}
						</td>
						<td>{tool.features}</td>
						<td class="pricing-cell">{tool.pricing}</td>
						<td><span class="best-for-badge">{tool.bestFor}</span></td>
						<td class="rating-cell" title={`${tool.rating} out of 5`}>
							<span class="rating-stars" aria-hidden="true">{renderStars(tool.rating)}</span>
							<span class="rating-num">{tool.rating}</span>
						</td>
						<td class="cta-cell">
							<a href={tool.ctaUrl} class="btn btn-primary btn-sm comparison-cta" rel="noopener sponsored">{tool.ctaText || 'Try it'}</a>
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>

	{/* Mobile: card layout */}
	<div class="comparison-cards">
		{tools.map((tool, i) => (
			<div class="comparison-card">
				<div class="comparison-card-header">
					<div class="comparison-card-name">
						{tool.logo && <img src={tool.logo} alt="" class="tool-logo" width="28" height="28" loading="lazy" />}
						<span class="comparison-card-rank">#{i + 1}</span>
						{tool.url ? <a href={tool.url} rel="noopener">{tool.name}</a> : <strong>{tool.name}</strong>}
					</div>
					<div class="rating-cell" title={`${tool.rating} out of 5`}>
						<span class="rating-stars" aria-hidden="true">{renderStars(tool.rating)}</span>
						<span class="rating-num">{tool.rating}</span>
					</div>
				</div>
				<div class="comparison-card-body">
					<div class="comparison-card-row">
						<span class="comparison-card-label">Features</span>
						<span>{tool.features}</span>
					</div>
					<div class="comparison-card-row">
						<span class="comparison-card-label">Pricing</span>
						<span class="pricing-cell">{tool.pricing}</span>
					</div>
					<div class="comparison-card-row">
						<span class="comparison-card-label">Best for</span>
						<span class="best-for-badge">{tool.bestFor}</span>
					</div>
				</div>
				<a href={tool.ctaUrl} class="btn btn-primary btn-sm comparison-cta comparison-card-cta" rel="noopener sponsored">{tool.ctaText || 'Try it'}</a>
			</div>
		))}
	</div>
</div>

<style>
	/* --- Wrapper --- */
	.comparison-table-wrap {
		margin: var(--space-8) 0;
	}
	.comparison-caption {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: var(--space-3);
	}

	/* --- Desktop Table --- */
	.comparison-scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background:
			linear-gradient(to right, var(--color-bg) 30%, transparent),
			linear-gradient(to left, var(--color-bg) 30%, transparent),
			linear-gradient(to right, rgba(0, 0, 0, 0.08), transparent 15px),
			linear-gradient(to left, rgba(0, 0, 0, 0.08), transparent 15px);
		background-position: left center, right center, left center, right center;
		background-repeat: no-repeat;
		background-size: 20px 100%, 20px 100%, 15px 100%, 15px 100%;
		background-attachment: local, local, scroll, scroll;
	}
	.comparison-scroll::-webkit-scrollbar {
		height: 6px;
	}
	.comparison-scroll::-webkit-scrollbar-track {
		background: var(--color-bg-dim);
		border-radius: var(--radius-full);
	}
	.comparison-scroll::-webkit-scrollbar-thumb {
		background: var(--color-border-strong);
		border-radius: var(--radius-full);
	}
	.comparison-table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-base);
		min-width: 700px;
	}
	.comparison-table thead th {
		text-align: left;
		font-weight: var(--weight-semibold);
		font-family: var(--font-display);
		padding: var(--space-3) var(--space-4);
		background: var(--color-bg-dim);
		border-bottom: 2px solid var(--color-primary);
		font-size: var(--text-sm);
		letter-spacing: 0.02em;
		color: var(--color-text-strong);
		white-space: nowrap;
	}
	.comparison-table td {
		padding: var(--space-3) var(--space-4);
		border-bottom: 1px solid var(--color-border);
		vertical-align: middle;
		font-size: var(--text-sm);
		color: var(--color-text);
	}
	.comparison-table tr:last-child td {
		border-bottom: none;
	}
	.comparison-table tr:hover td {
		background: var(--color-bg-dim);
	}

	/* --- Shared elements --- */
	.tool-name-cell {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		white-space: nowrap;
	}
	.tool-name-cell a {
		color: var(--color-text-strong);
		text-decoration: none;
	}
	.tool-name-cell a:hover {
		color: var(--color-primary);
		text-decoration: underline;
	}
	.tool-logo {
		border-radius: var(--radius-sm);
		flex-shrink: 0;
	}
	.pricing-cell {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		white-space: nowrap;
	}
	.best-for-badge {
		display: inline-block;
		padding: var(--space-0-5) var(--space-2);
		background: var(--sd-teal-light);
		color: var(--sd-teal-dark);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		white-space: nowrap;
	}
	.rating-cell {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		white-space: nowrap;
	}
	.rating-stars {
		color: var(--sd-amber);
		font-size: var(--text-sm);
		letter-spacing: 1px;
	}
	.rating-num {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}
	.cta-cell {
		text-align: right;
	}
	.comparison-cta {
		text-decoration: none;
		white-space: nowrap;
	}
	.comparison-cta:hover {
		text-decoration: none;
	}

	/* --- Mobile Cards (hidden on desktop) --- */
	.comparison-cards {
		display: none;
		flex-direction: column;
		gap: var(--space-4);
	}
	.comparison-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		transition: border-color var(--transition-base);
	}
	.comparison-card:hover {
		border-color: var(--color-primary);
	}
	.comparison-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-3);
		gap: var(--space-2);
	}
	.comparison-card-name {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-weight: var(--weight-bold);
		font-family: var(--font-display);
		color: var(--color-text-strong);
		font-size: var(--text-lg);
	}
	.comparison-card-name a {
		color: inherit;
		text-decoration: none;
	}
	.comparison-card-name a:hover {
		color: var(--color-primary);
	}
	.comparison-card-rank {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-primary);
		font-weight: var(--weight-semibold);
		opacity: 0.6;
	}
	.comparison-card-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
	}
	.comparison-card-row {
		display: flex;
		justify-content: space-between;
		gap: var(--space-3);
		font-size: var(--text-sm);
		color: var(--color-text);
	}
	.comparison-card-label {
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		flex-shrink: 0;
		min-width: 70px;
	}
	.comparison-card-cta {
		display: block;
		text-align: center;
		width: 100%;
	}

	/* --- Responsive: swap table → cards below 768px --- */
	@media (max-width: 768px) {
		.comparison-scroll {
			display: none;
		}
		.comparison-cards {
			display: flex;
		}
	}

	/* --- Dark mode --- */
	:global([data-theme="dark"]) .best-for-badge {
		background: rgba(20, 184, 166, 0.15);
		color: #5EEAD4;
	}
	:global([data-theme="dark"]) .comparison-card {
		background: var(--color-bg-dim);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .best-for-badge {
			background: rgba(20, 184, 166, 0.15);
			color: #5EEAD4;
		}
		:global([data-theme="auto"]) .comparison-card {
			background: var(--color-bg-dim);
		}
	}
</style>
