---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, author, department, useCase, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="auto">
	<head>
		<BaseHead title={`${title} | Superdots`} description={description} image={heroImage} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Article",
			"headline": title,
			"description": description,
			"author": { "@type": "Person", "name": author },
			"datePublished": pubDate.toISOString(),
			...(updatedDate && { "dateModified": updatedDate.toISOString() }),
			...(heroImage && { "image": new URL(heroImage, Astro.url).toString() }),
			"publisher": {
				"@type": "Organization",
				"name": "Superdots",
				"url": "https://superdots.ai"
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": Astro.url.toString()
			}
		})} />
	</head>
	<body>
		<Header />
		<main class="article-main">
			<article>
				<div class="article-header">
					<div class="dots dots-md" style="top: 5%; right: -8%; opacity: 0.3;"></div>
					<div class="meta">
						<span class="badge badge-dept">{department}</span>
						<span class="badge badge-usecase">{useCase}</span>
					</div>
					<h1>{title}<span class="dot-accent">.</span></h1>
					<p class="description">{description}</p>
					<div class="byline">
						<span class="author">{author}</span>
						<span class="separator">&middot;</span>
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">
								(Updated: <FormattedDate date={updatedDate} />)
							</span>
						)}
					</div>
				</div>
				<hr />
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-main {
		max-width: var(--max-width-prose);
	}
	.article-header {
		position: relative;
		overflow: hidden;
		margin-bottom: var(--space-8);
	}
	.article-header h1 {
		font-family: var(--font-display);
		font-size: var(--text-4xl);
		font-weight: var(--weight-bold);
		letter-spacing: -0.03em;
		margin: var(--space-4) 0 var(--space-3);
		line-height: var(--leading-tight);
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.description {
		color: var(--color-text-muted);
		font-size: var(--text-xl);
		margin-bottom: var(--space-4);
		line-height: var(--leading-snug);
	}
	.meta {
		display: flex;
		gap: var(--space-2);
	}
	.byline {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
	}
	.author {
		font-weight: var(--weight-semibold);
		color: var(--color-text);
	}
	.updated {
		font-style: italic;
	}

	/* Prose Styling */
	.prose {
		line-height: var(--leading-relaxed);
		font-size: var(--text-lg);
	}
	.prose :global(h2) {
		font-family: var(--font-display);
		margin-top: var(--space-10);
		margin-bottom: var(--space-4);
		font-size: var(--text-2xl);
		letter-spacing: -0.02em;
	}
	.prose :global(h3) {
		font-family: var(--font-display);
		margin-top: var(--space-8);
		margin-bottom: var(--space-3);
		font-size: var(--text-xl);
	}
	.prose :global(ul), .prose :global(ol) {
		padding-left: var(--space-6);
	}
	.prose :global(li) {
		margin-bottom: 0.5em;
	}
	.prose :global(li::marker) {
		color: var(--color-primary);
	}
	.prose :global(strong) {
		color: var(--color-text-strong);
		font-weight: var(--weight-semibold);
	}
	.prose :global(a) {
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-thickness: 1px;
	}
	.prose :global(a:hover) {
		text-decoration-thickness: 2px;
	}
	.prose :global(img) {
		border-radius: var(--radius-lg);
		margin: var(--space-6) 0;
	}

	@media (max-width: 720px) {
		.article-header h1 {
			font-size: var(--text-3xl);
		}
		.description {
			font-size: var(--text-lg);
		}
	}
</style>
