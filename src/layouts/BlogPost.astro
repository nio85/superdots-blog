---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ShareButtons from '../components/ShareButtons.astro';
import TableOfContents from '../components/TableOfContents.astro';
import CookieConsent from '../components/CookieConsent.astro';
import ArticleSchema from '../components/ArticleSchema.astro';
import AuthorBox from '../components/AuthorBox.astro';
import MidPostCTA from '../components/MidPostCTA.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import { getImage } from 'astro:assets';
import { SKIMLINKS_PUBLISHER_ID } from '../consts';
import type { CollectionEntry } from 'astro:content';
import { TAGS } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string; readingTime?: number };

const { title, description, pubDate, updatedDate, author, department, useCase, contentPillar, heroImage, tags, faqs, noindex, slug: propSlug, readingTime } = Astro.props;

// Resolve OG image URL for meta tags (works with both local ImageMetadata and string URLs)
const ogImageSrc = heroImage
	? typeof heroImage === 'string'
		? heroImage
		: heroImage.src
	: undefined;

// Build preload hint for hero image LCP optimization
let heroPreloadHref = '';
let heroPreloadSrcset = '';
let heroPreloadType = '';
if (heroImage) {
	if (typeof heroImage === 'string') {
		heroPreloadHref = heroImage;
	} else {
		const widths = [400, 800, 1200, 1600];
		const images = await Promise.all(
			widths.map((w) => getImage({ src: heroImage, width: w, format: 'avif' }))
		);
		heroPreloadSrcset = images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
		heroPreloadHref = images[1].src;
		heroPreloadType = 'image/avif';
	}
}

const slug = propSlug || Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');

const tagMeta = (tags ?? [])
	.map((t: string) => TAGS.find((tm) => tm.slug === t))
	.filter(Boolean);

const articleUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<BaseHead title={`${title} | Superdots`} description={description} image={ogImageSrc} type="article" publishedTime={pubDate.toISOString()} modifiedTime={updatedDate?.toISOString()} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		{heroPreloadSrcset ? (
			<link rel="preload" as="image" type={heroPreloadType} imagesrcset={heroPreloadSrcset} imagesizes="(max-width: 720px) 100vw, 720px" fetchpriority="high" />
		) : heroPreloadHref ? (
			<link rel="preload" as="image" href={heroPreloadHref} fetchpriority="high" />
		) : null}
		<ArticleSchema
			title={title}
			description={description}
			pubDate={pubDate}
			updatedDate={updatedDate}
			author={author}
			contentPillar={contentPillar}
			heroImageSrc={ogImageSrc}
			faqs={faqs}
		/>
	</head>
	<body data-article-slug={slug} data-article-department={department || ''} data-article-use-case={useCase || ''}>
		<Header />
		<main class="article-main">
			<article>
				<div class="article-header">
					<div class="article-header-glow" aria-hidden="true"></div>
					<div class="dots dots-md dots-fine" style="top: 0; right: -5%; opacity: 0.12;" aria-hidden="true"></div>
					<div class="dots dots-sm dots-brand" style="bottom: 10%; left: -3%; opacity: 0.08;" aria-hidden="true"></div>
					<nav class="breadcrumb" aria-label="Breadcrumb">
						<ol>
							<li><a href="/">Home</a></li>
							<li><a href="/blog/">Blog</a></li>
							<li aria-current="page"><span class="breadcrumb-current">{title}</span></li>
						</ol>
					</nav>
					<div class="meta">
						<a href={`/category/department/${department}/`} class="badge badge-dept">{department}</a>
						<a href={`/category/use-case/${useCase}/`} class="badge badge-usecase">{useCase}</a>
						{tagMeta.map((t) => (
							<a href={`/tags/${t!.slug}/`} class="badge badge-tag">{t!.label}</a>
						))}
					</div>
					<h1>{title}<span class="dot-accent">.</span></h1>
					<p class="description">{description}</p>
					<div class="byline-row">
						<div class="byline">
							<span class="author">{author}</span>
							<span class="separator">&middot;</span>
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<span class="updated">
									(Updated: <FormattedDate date={updatedDate} />)
								</span>
							)}
							{readingTime && (
								<>
									<span class="separator">&middot;</span>
									<span class="reading-time">
										<svg class="reading-time-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
											<circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/>
											<path d="M8 4.5V8l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
										</svg>
										{readingTime} min read
									</span>
								</>
							)}
						</div>
						<ShareButtons url={articleUrl} title={title} description={description} />
					</div>
				</div>
				{heroImage && (
					<div class="hero-image">
						<OptimizedImage
							src={heroImage}
							alt={title}
							widths={[400, 800, 1200, 1600]}
							sizes="(max-width: 720px) 100vw, 720px"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
				)}
				<div class="article-divider" aria-hidden="true"><span class="superdot"></span></div>
				<TableOfContents />
				{SKIMLINKS_PUBLISHER_ID && <AffiliateDisclosure />}
				<div class="prose" id="article-prose">
					<slot />
				</div>
				{faqs && faqs.length > 0 && (
					<FaqAccordion faqs={faqs} />
				)}
			</article>
			<AuthorBox author={author} />
			<NewsletterForm variant="banner" source="article-end" />
			<RelatedArticles currentSlug={slug} department={department} useCase={useCase} tags={tags ?? []} />
		</main>
		<Footer />
		<CookieConsent />
		<MidPostCTA department={department} />

		<script is:inline>
			if (typeof fbq === 'function') {
				var el = document.body;
				fbq('track', 'ViewContent', {
					content_name: el.getAttribute('data-article-slug') || document.title,
					content_category: el.getAttribute('data-article-department') || 'blog',
					content_type: 'article'
				});
			}
		</script>

		<script>
			import '../scripts/article-engagement.ts';
		</script>

		{SKIMLINKS_PUBLISHER_ID && (
		<script is:inline define:vars={{ skimlinksId: SKIMLINKS_PUBLISHER_ID }}>
			if (location.hostname === 'superdots.sh') {
				window.SD_deferAnalytics(function() {
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://s.skimresources.com/js/' + skimlinksId + '.skimlinks.js';
					document.body.appendChild(s);
				});
			}
		</script>
		)}
	</body>
</html>

<style>
	.article-main {
		max-width: var(--max-width-prose);
	}
	.breadcrumb {
		position: relative;
		margin-bottom: var(--space-3);
	}
	.breadcrumb ol {
		list-style: none;
		display: flex;
		align-items: center;
		gap: 0;
		padding: 0;
		margin: 0;
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
	}
	.breadcrumb li {
		display: flex;
		align-items: center;
	}
	.breadcrumb li:not(:last-child)::after {
		content: '';
		display: inline-block;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--color-primary);
		margin: 0 var(--space-2);
		opacity: 0.5;
	}
	.breadcrumb a {
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color var(--transition-fast);
	}
	.breadcrumb a:hover {
		color: var(--color-primary);
	}
	.breadcrumb [aria-current] {
		color: var(--color-text-muted);
		opacity: 0.7;
	}
	.breadcrumb-current {
		display: inline-block;
		max-width: 20ch;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		vertical-align: bottom;
	}
	.article-header {
		position: relative;
		overflow: hidden;
		margin-bottom: var(--space-6);
		padding: var(--space-6) var(--space-6) var(--space-8);
		border-radius: var(--radius-xl);
		background: var(--color-bg-dim);
		border: 1px solid var(--color-border);
	}
	/* Subtle gradient glow in header */
	.article-header-glow {
		position: absolute;
		top: -30%;
		right: -15%;
		width: 400px;
		height: 400px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(232, 54, 59, 0.05) 0%, transparent 70%);
		filter: blur(40px);
		pointer-events: none;
	}
	:global([data-theme="dark"]) .article-header {
		background: var(--color-bg-dim);
		border-color: var(--color-border);
	}
	:global([data-theme="dark"]) .article-header-glow {
		background: radial-gradient(circle, rgba(232, 54, 59, 0.08) 0%, transparent 70%);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .article-header {
			background: var(--color-bg-dim);
			border-color: var(--color-border);
		}
		:global([data-theme="auto"]) .article-header-glow {
			background: radial-gradient(circle, rgba(232, 54, 59, 0.08) 0%, transparent 70%);
		}
	}
	.article-header h1 {
		position: relative;
		font-family: var(--font-display);
		font-size: var(--text-4xl);
		font-weight: var(--weight-bold);
		letter-spacing: -0.03em;
		margin: var(--space-4) 0 var(--space-3);
		line-height: 1.1;
	}
	.description {
		position: relative;
		color: var(--color-text-muted);
		font-size: var(--text-xl);
		margin-bottom: var(--space-4);
		line-height: var(--leading-snug);
	}
	.meta {
		position: relative;
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}
	.meta a.badge-dept,
	.meta a.badge-usecase,
	.meta .badge-tag {
		text-decoration: none;
		transition: all var(--transition-fast);
	}
	.meta a.badge-dept:hover {
		opacity: 0.85;
		text-decoration: none;
	}
	.meta a.badge-usecase:hover {
		opacity: 0.85;
		text-decoration: none;
	}
	.meta .badge-tag:hover {
		background: var(--color-border-strong);
		color: var(--color-text-strong);
		text-decoration: none;
	}
	.byline-row {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
	.byline {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
	}
	.author {
		font-weight: var(--weight-semibold);
		color: var(--color-text);
	}
	.updated {
		font-style: italic;
	}
	/* Reading time badge */
	.reading-time {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}
	.reading-time-icon {
		flex-shrink: 0;
		opacity: 0.6;
	}
	.hero-image {
		margin: var(--space-6) 0;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-md);
	}
	.hero-image :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}
	/* Brand divider between header area and prose */
	.article-divider {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-6) 0 var(--space-8);
	}
	.article-divider::before,
	.article-divider::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--color-border);
	}
	.article-divider .superdot {
		flex-shrink: 0;
	}

	/* Prose Styling */
	.prose {
		line-height: var(--leading-relaxed);
		font-size: var(--text-lg);
	}
	.prose :global(h2) {
		font-family: var(--font-display);
		margin-top: var(--space-10);
		margin-bottom: var(--space-4);
		font-size: var(--text-2xl);
		letter-spacing: -0.02em;
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-border);
	}
	.prose :global(h2:first-child) {
		border-top: none;
		padding-top: 0;
	}
	.prose :global(h3) {
		font-family: var(--font-display);
		margin-top: var(--space-8);
		margin-bottom: var(--space-3);
		font-size: var(--text-xl);
	}
	.prose :global(ul), .prose :global(ol) {
		padding-left: var(--space-6);
	}
	.prose :global(li) {
		margin-bottom: 0.5em;
	}
	.prose :global(li::marker) {
		color: var(--color-primary);
	}
	.prose :global(strong) {
		color: var(--color-text-strong);
		font-weight: var(--weight-semibold);
	}
	.prose :global(a) {
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-thickness: 1px;
		transition: text-decoration-thickness var(--transition-fast);
	}
	.prose :global(a:hover) {
		text-decoration-thickness: 2px;
	}
	.prose :global(img) {
		border-radius: var(--radius-lg);
		margin: var(--space-6) 0;
	}
	/* Pull quotes — use > **"Quote text"** in markdown */
	.prose :global(blockquote) {
		border-left: 4px solid var(--color-primary);
		padding: var(--space-4) var(--space-5);
		margin: var(--space-8) 0;
		background: var(--color-bg-dim);
		border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
		position: relative;
	}
	.prose :global(blockquote p) {
		margin: 0;
	}
	.prose :global(blockquote strong) {
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		letter-spacing: -0.01em;
	}
	/* Responsive table wrapper — wraps every <table> via rehype plugin */
	.prose :global(.table-scroll) {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		margin: var(--space-6) 0;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		/* Scroll affordance — subtle shadow on right edge */
		background:
			linear-gradient(to right, var(--color-bg) 30%, transparent),
			linear-gradient(to left, var(--color-bg) 30%, transparent),
			linear-gradient(to right, rgba(0, 0, 0, 0.08), transparent 15px),
			linear-gradient(to left, rgba(0, 0, 0, 0.08), transparent 15px);
		background-position: left center, right center, left center, right center;
		background-repeat: no-repeat;
		background-size: 20px 100%, 20px 100%, 15px 100%, 15px 100%;
		background-attachment: local, local, scroll, scroll;
	}
	.prose :global(.table-scroll::-webkit-scrollbar) {
		height: 6px;
	}
	.prose :global(.table-scroll::-webkit-scrollbar-track) {
		background: var(--color-bg-dim);
		border-radius: var(--radius-full);
	}
	.prose :global(.table-scroll::-webkit-scrollbar-thumb) {
		background: var(--color-border-strong);
		border-radius: var(--radius-full);
	}
	.prose :global(.table-scroll::-webkit-scrollbar-thumb:hover) {
		background: var(--color-text-muted);
	}
	/* Table base styles */
	.prose :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-base);
		margin: 0; /* margin handled by .table-scroll wrapper */
	}
	.prose :global(th) {
		text-align: left;
		font-weight: var(--weight-semibold);
		font-family: var(--font-display);
		padding: var(--space-3) var(--space-4);
		background: var(--color-bg-dim);
		border-bottom: 2px solid var(--color-primary);
		font-size: var(--text-sm);
		letter-spacing: 0.02em;
		color: var(--color-text-strong);
		white-space: nowrap;
	}
	.prose :global(td) {
		padding: var(--space-3) var(--space-4);
		border-bottom: 1px solid var(--color-border);
		vertical-align: top;
	}
	.prose :global(tr:last-child td) {
		border-bottom: none;
	}
	.prose :global(tr:hover td) {
		background: var(--color-bg-dim);
	}
	/* Mobile table adjustments */
	@media (max-width: 768px) {
		.prose :global(.table-scroll) {
			margin: var(--space-4) calc(-1 * var(--space-4));
			border-radius: 0;
			border-left: none;
			border-right: none;
		}
		.prose :global(th),
		.prose :global(td) {
			padding: var(--space-2) var(--space-3);
			font-size: var(--text-sm);
		}
		.prose :global(th) {
			font-size: var(--text-xs);
		}
	}
	/* Code block refinements */
	.prose :global(pre) {
		border-radius: var(--radius-lg);
		margin: var(--space-6) 0;
		border: 1px solid var(--color-border);
	}
	.prose :global(code:not(pre code)) {
		font-family: var(--font-mono);
		font-size: 0.875em;
		background: var(--color-bg-dim);
		padding: 0.15em 0.4em;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
	}
	/* Horizontal rules as section separators */
	.prose :global(hr) {
		border: none;
		height: 1px;
		background: var(--color-border);
		margin: var(--space-10) 0;
		position: relative;
	}

	@media (max-width: 720px) {
		.article-header {
			padding: var(--space-4) var(--space-4) var(--space-6);
		}
		.article-header h1 {
			font-size: var(--text-3xl);
		}
		.description {
			font-size: var(--text-lg);
		}
	}

</style>
