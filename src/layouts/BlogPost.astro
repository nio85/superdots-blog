---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import type { CollectionEntry } from 'astro:content';
import { TAGS } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { slug?: string };

const { title, description, pubDate, updatedDate, author, department, useCase, heroImage, tags, faqs, slug: propSlug } = Astro.props;

// Resolve OG image URL for meta tags (works with both local ImageMetadata and string URLs)
const ogImageSrc = heroImage
	? typeof heroImage === 'string'
		? heroImage
		: heroImage.src
	: undefined;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://superdots.sh';
const slug = propSlug || Astro.url.pathname.replace(/^\/blog\//, '').replace(/\/$/, '');

const tagMeta = (tags ?? [])
	.map((t: string) => TAGS.find((tm) => tm.slug === t))
	.filter(Boolean);
---

<!doctype html>
<html lang="en" data-theme="auto">
	<head>
		<BaseHead title={`${title} | Superdots`} description={description} image={ogImageSrc} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Article",
			"headline": title,
			"description": description,
			"author": { "@type": "Person", "name": author },
			"datePublished": pubDate.toISOString(),
			...(updatedDate && { "dateModified": updatedDate.toISOString() }),
			...(ogImageSrc && { "image": new URL(ogImageSrc, Astro.url).toString() }),
			"publisher": {
				"@type": "Organization",
				"name": "Superdots",
				"url": siteUrl,
				"logo": {
					"@type": "ImageObject",
					"url": `${siteUrl}/favicon.svg`
				}
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": Astro.url.toString()
			}
		})} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Home",
					"item": siteUrl
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "Blog",
					"item": `${siteUrl}/blog`
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": title
				}
			]
		})} />
		{faqs && faqs.length > 0 && (
			<script type="application/ld+json" set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": faqs.map((faq: { question: string; answer: string }) => ({
					"@type": "Question",
					"name": faq.question,
					"acceptedAnswer": {
						"@type": "Answer",
						"text": faq.answer
					}
				}))
			})} />
		)}
	</head>
	<body>
		<Header />
		<main class="article-main">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<ol>
					<li><a href="/">Home</a></li>
					<li><a href="/blog/">Blog</a></li>
					<li aria-current="page">{title}</li>
				</ol>
			</nav>
			<article>
				<div class="article-header">
					<div class="article-header-glow" aria-hidden="true"></div>
					<div class="dots dots-md dots-fine" style="top: 0; right: -5%; opacity: 0.12;" aria-hidden="true"></div>
					<div class="dots dots-sm dots-brand" style="bottom: 10%; left: -3%; opacity: 0.08;" aria-hidden="true"></div>
					<div class="meta">
						<a href={`/category/department/${department}/`} class="badge badge-dept">{department}</a>
						<a href={`/category/use-case/${useCase}/`} class="badge badge-usecase">{useCase}</a>
						{tagMeta.map((t) => (
							<a href={`/tags/${t!.slug}/`} class="badge badge-tag">{t!.label}</a>
						))}
					</div>
					<h1>{title}<span class="dot-accent">.</span></h1>
					<p class="description">{description}</p>
					<div class="byline">
						<span class="author">{author}</span>
						<span class="separator">&middot;</span>
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">
								(Updated: <FormattedDate date={updatedDate} />)
							</span>
						)}
					</div>
				</div>
				{heroImage && (
					<div class="hero-image">
						<OptimizedImage
							src={heroImage}
							alt={title}
							widths={[400, 800, 1200, 1600]}
							sizes="(max-width: 720px) 100vw, 720px"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
				)}
				<div class="article-divider" aria-hidden="true"><span class="superdot"></span></div>
				<div class="prose">
					<slot />
				</div>
			</article>
			<NewsletterForm variant="banner" source="article" />
			<RelatedArticles currentSlug={slug} department={department} useCase={useCase} tags={tags ?? []} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-main {
		max-width: var(--max-width-prose);
	}
	.breadcrumb ol {
		list-style: none;
		display: flex;
		gap: var(--space-1);
		padding: 0;
		margin: 0 0 var(--space-6);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
	.breadcrumb li:not(:last-child)::after {
		content: '/';
		margin-left: var(--space-1);
		color: var(--color-border-strong);
	}
	.breadcrumb a {
		color: var(--color-text-muted);
		text-decoration: none;
	}
	.breadcrumb a:hover {
		color: var(--color-primary);
	}
	.breadcrumb [aria-current] {
		color: var(--color-text);
		font-weight: var(--weight-medium);
	}
	.article-header {
		position: relative;
		overflow: hidden;
		margin-bottom: var(--space-6);
		padding: var(--space-6) var(--space-6) var(--space-8);
		border-radius: var(--radius-xl);
		background: var(--color-bg-dim);
		border: 1px solid var(--color-border);
	}
	/* Subtle gradient glow in header */
	.article-header-glow {
		position: absolute;
		top: -30%;
		right: -15%;
		width: 400px;
		height: 400px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(232, 54, 59, 0.05) 0%, transparent 70%);
		filter: blur(40px);
		pointer-events: none;
	}
	:global([data-theme="dark"]) .article-header {
		background: var(--color-bg-dim);
		border-color: var(--color-border);
	}
	:global([data-theme="dark"]) .article-header-glow {
		background: radial-gradient(circle, rgba(232, 54, 59, 0.08) 0%, transparent 70%);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .article-header {
			background: var(--color-bg-dim);
			border-color: var(--color-border);
		}
		:global([data-theme="auto"]) .article-header-glow {
			background: radial-gradient(circle, rgba(232, 54, 59, 0.08) 0%, transparent 70%);
		}
	}
	.article-header h1 {
		position: relative;
		font-family: var(--font-display);
		font-size: var(--text-4xl);
		font-weight: var(--weight-bold);
		letter-spacing: -0.03em;
		margin: var(--space-4) 0 var(--space-3);
		line-height: 1.1;
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.description {
		position: relative;
		color: var(--color-text-muted);
		font-size: var(--text-xl);
		margin-bottom: var(--space-4);
		line-height: var(--leading-snug);
	}
	.meta {
		position: relative;
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}
	.meta a.badge-dept,
	.meta a.badge-usecase,
	.meta .badge-tag {
		text-decoration: none;
		transition: all var(--transition-fast);
	}
	.meta a.badge-dept:hover {
		opacity: 0.85;
		text-decoration: none;
	}
	.meta a.badge-usecase:hover {
		opacity: 0.85;
		text-decoration: none;
	}
	.meta .badge-tag:hover {
		background: var(--color-border-strong);
		color: var(--color-text-strong);
		text-decoration: none;
	}
	.byline {
		position: relative;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
	}
	.author {
		font-weight: var(--weight-semibold);
		color: var(--color-text);
	}
	.updated {
		font-style: italic;
	}
	.hero-image {
		margin: var(--space-6) 0;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-md);
	}
	.hero-image :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}
	/* Brand divider between header area and prose */
	.article-divider {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-6) 0 var(--space-8);
	}
	.article-divider::before,
	.article-divider::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--color-border);
	}
	.article-divider .superdot {
		flex-shrink: 0;
	}

	/* Prose Styling */
	.prose {
		line-height: var(--leading-relaxed);
		font-size: var(--text-lg);
	}
	.prose :global(h2) {
		font-family: var(--font-display);
		margin-top: var(--space-10);
		margin-bottom: var(--space-4);
		font-size: var(--text-2xl);
		letter-spacing: -0.02em;
	}
	.prose :global(h3) {
		font-family: var(--font-display);
		margin-top: var(--space-8);
		margin-bottom: var(--space-3);
		font-size: var(--text-xl);
	}
	.prose :global(ul), .prose :global(ol) {
		padding-left: var(--space-6);
	}
	.prose :global(li) {
		margin-bottom: 0.5em;
	}
	.prose :global(li::marker) {
		color: var(--color-primary);
	}
	.prose :global(strong) {
		color: var(--color-text-strong);
		font-weight: var(--weight-semibold);
	}
	.prose :global(a) {
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-thickness: 1px;
		transition: text-decoration-thickness var(--transition-fast);
	}
	.prose :global(a:hover) {
		text-decoration-thickness: 2px;
	}
	.prose :global(img) {
		border-radius: var(--radius-lg);
		margin: var(--space-6) 0;
	}
	/* Better blockquote treatment in articles */
	.prose :global(blockquote) {
		border-left: 4px solid var(--color-primary);
		padding: var(--space-4) var(--space-5);
		margin: var(--space-8) 0;
		background: var(--color-bg-dim);
		border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
	}

	@media (max-width: 720px) {
		.article-header {
			padding: var(--space-4) var(--space-4) var(--space-6);
		}
		.article-header h1 {
			font-size: var(--text-3xl);
		}
		.description {
			font-size: var(--text-lg);
		}
	}
</style>
