---
import Base from './Base.astro';

interface Props {
	title: string;
	subtitle: string;
	description: string;
	features: string[];
	previewImage?: string;
	downloadUrl: string;
	source: string;
}

const { title, subtitle, description, features, previewImage, downloadUrl, source } = Astro.props;

const BRAND_SUFFIX = ' | Superdots';
const pageTitle = (title.length + BRAND_SUFFIX.length > 60) ? title : `${title}${BRAND_SUFFIX}`;
---

<Base title={pageTitle} description={description}>
	<div class="lm">
		<!-- Hero -->
		<section class="lm-hero">
			<div class="lm-hero-glow" aria-hidden="true"></div>
			<div class="dots dots-lg dots-fine" style="top: 0; right: -3%; opacity: 0.1;" aria-hidden="true"></div>
			<p class="lm-label">
				<span class="superdot"></span>
				Free resource
			</p>
			<h1 class="lm-title">{title}<span class="dot-accent">.</span></h1>
			<p class="lm-subtitle">{subtitle}</p>
		</section>

		<div class="lm-body">
			<!-- Preview + form two-column layout -->
			<div class="lm-grid">
				<div class="lm-content">
					<p class="lm-desc">{description}</p>
					{features.length > 0 && (
						<ul class="lm-features">
							{features.map((f) => (
								<li>
									<span class="lm-check" aria-hidden="true">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
									</span>
									{f}
								</li>
							))}
						</ul>
					)}
					{previewImage && (
						<div class="lm-preview">
							<img src={previewImage} alt={`Preview of ${title}`} loading="lazy" />
						</div>
					)}
				</div>

				<div class="lm-form-card" id="lm-form-card">
					<div class="lm-form-state" id="lm-form-state">
						<span class="superdot"></span>
						<h2 class="lm-form-heading">Get your free copy<span class="dot-accent">.</span></h2>
						<p class="lm-form-desc">Enter your email and we'll send it right over.</p>
						<form class="lm-form" id="lm-form" aria-label="Download form" data-source={source} data-download={downloadUrl}>
							<div class="lm-field">
								<label for="lm-email" class="sr-only">Email address</label>
								<input
									type="email"
									id="lm-email"
									name="email"
									placeholder="you@company.com"
									required
									autocomplete="email"
									data-clarity-mask="true"
								/>
							</div>
							<button type="submit" class="btn btn-primary btn-lg lm-btn">Download now</button>
							<p class="lm-legal">
								You'll also receive our weekly newsletter. No spam, unsubscribe anytime. <a href="/privacy#newsletter">Privacy</a>.
							</p>
							<div class="lm-status" role="status" aria-live="polite"></div>
						</form>
					</div>
					<!-- Success / download state (hidden by default) -->
					<div class="lm-success" id="lm-success" hidden>
						<div class="lm-success-icon" aria-hidden="true">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
						</div>
						<h2 class="lm-success-heading">It's yours<span class="dot-accent">.</span></h2>
						<p class="lm-success-desc">Check your inbox to confirm your subscription. In the meantime, download your copy below.</p>
						<a id="lm-download-link" href={downloadUrl} class="btn btn-primary btn-lg lm-btn" download>
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
							Download PDF
						</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Extra content slot (for additional sections below the form) -->
		<div class="lm-extra">
			<slot />
		</div>
	</div>
</Base>

<script>
	const form = document.getElementById('lm-form') as HTMLFormElement | null;
	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const input = form.querySelector('input[type="email"]') as HTMLInputElement;
			const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
			const status = form.querySelector('.lm-status') as HTMLElement;
			const source = form.dataset.source || 'lead-magnet';
			const email = input.value.trim();
			if (!email) return;

			btn.disabled = true;
			btn.textContent = 'Sending...';
			status.textContent = '';
			status.className = 'lm-status';

			try {
				const res = await fetch('/api/subscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email, source }),
				});
				const data = await res.json();

				if (res.ok) {
					// Show success state
					const formState = document.getElementById('lm-form-state');
					const successState = document.getElementById('lm-success');
					if (formState) formState.hidden = true;
					if (successState) successState.hidden = false;
				} else {
					status.textContent = data.error || 'Something went wrong. Please try again.';
					status.classList.add('lm-status--error');
				}
			} catch {
				status.textContent = 'Network error. Please try again.';
				status.classList.add('lm-status--error');
			} finally {
				btn.disabled = false;
				btn.textContent = 'Download now';
			}
		});
	}
</script>

<style>
	.lm {
		max-width: var(--max-width-wide);
		margin: 0 auto;
	}

	/* Hero */
	.lm-hero {
		position: relative;
		text-align: center;
		padding: var(--space-16) var(--space-4) var(--space-10);
		overflow: hidden;
	}
	.lm-hero-glow {
		position: absolute;
		top: -40%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 900px;
		height: 500px;
		border-radius: 50%;
		background: radial-gradient(ellipse, rgba(232, 54, 59, 0.06) 0%, transparent 70%);
		filter: blur(60px);
		pointer-events: none;
	}
	:global([data-theme="dark"]) .lm-hero-glow {
		background: radial-gradient(ellipse, rgba(232, 54, 59, 0.1) 0%, transparent 70%);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .lm-hero-glow {
			background: radial-gradient(ellipse, rgba(232, 54, 59, 0.1) 0%, transparent 70%);
		}
	}
	.lm-label {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.lm-label .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
	}
	.lm-title {
		position: relative;
		font-size: var(--text-4xl);
		line-height: 1.1;
		margin-bottom: var(--space-4);
		max-width: 700px;
		margin-left: auto;
		margin-right: auto;
		letter-spacing: -0.03em;
	}
	.lm-subtitle {
		position: relative;
		color: var(--color-text-muted);
		font-size: var(--text-xl);
		max-width: 560px;
		margin: 0 auto;
		line-height: var(--leading-snug);
	}

	/* Body */
	.lm-body {
		padding: 0 var(--space-4);
	}
	.lm-grid {
		display: grid;
		grid-template-columns: 1fr 400px;
		gap: var(--space-10);
		align-items: start;
		max-width: var(--max-width-wide);
		margin: 0 auto;
	}

	/* Content side */
	.lm-content {
		padding-top: var(--space-2);
	}
	.lm-desc {
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
		margin-bottom: var(--space-6);
	}
	.lm-features {
		list-style: none;
		padding: 0;
		margin: 0 0 var(--space-8);
	}
	.lm-features li {
		display: flex;
		align-items: flex-start;
		gap: var(--space-3);
		padding: var(--space-2) 0;
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		color: var(--color-text);
	}
	.lm-check {
		flex-shrink: 0;
		width: 24px;
		height: 24px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--sd-red-light);
		border-radius: var(--radius-full);
		color: var(--color-primary);
		margin-top: var(--space-0-5);
	}
	.lm-preview {
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-md);
	}
	.lm-preview img {
		width: 100%;
		height: auto;
		display: block;
	}

	/* Form card */
	.lm-form-card {
		position: sticky;
		top: var(--space-8);
		background: var(--color-bg-dim);
		border: 2px solid var(--color-border);
		border-radius: var(--radius-xl);
		padding: var(--space-8) var(--space-6);
		overflow: hidden;
	}
	.lm-form-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 4px;
		background: var(--color-primary);
	}
	.lm-form-card .superdot {
		display: inline-block;
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		margin-bottom: var(--space-3);
	}
	.lm-form-heading {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
		letter-spacing: -0.02em;
		line-height: var(--leading-tight);
	}
	.lm-form-desc {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		margin: 0 0 var(--space-5);
	}
	.lm-field input {
		width: 100%;
		padding: var(--space-3) var(--space-4);
		font-size: var(--text-base);
		font-family: inherit;
		border: 2px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg);
		color: var(--color-text);
		transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
		box-sizing: border-box;
	}
	.lm-field input:focus {
		outline: none;
		border-color: var(--color-primary);
		box-shadow: var(--shadow-glow);
	}
	.lm-field input::placeholder {
		color: var(--color-text-muted);
		opacity: 0.6;
	}
	.lm-btn {
		width: 100%;
		margin-top: var(--space-3);
		text-align: center;
		justify-content: center;
		display: inline-flex;
		align-items: center;
	}
	.lm-legal {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		margin: var(--space-3) 0 0;
		line-height: var(--leading-relaxed);
	}
	.lm-legal a {
		color: var(--color-text-muted);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.lm-legal a:hover {
		color: var(--color-primary);
	}
	.lm-status {
		font-size: var(--text-sm);
		margin-top: var(--space-2);
	}
	.lm-status--error {
		color: var(--color-primary);
	}

	/* Success state */
	.lm-success {
		text-align: center;
	}
	.lm-success-icon {
		color: var(--sd-teal, #14B8A6);
		margin-bottom: var(--space-4);
	}
	.lm-success-heading {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
		letter-spacing: -0.02em;
	}
	.lm-success-desc {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		margin: 0 0 var(--space-5);
		line-height: var(--leading-normal);
	}

	/* Extra content below */
	.lm-extra {
		max-width: var(--max-width-content);
		margin: var(--space-16) auto 0;
		padding: 0 var(--space-4);
	}
	.lm-extra:empty {
		display: none;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.lm-grid {
			grid-template-columns: 1fr;
			gap: var(--space-8);
		}
		.lm-form-card {
			position: static;
		}
		.lm-title {
			font-size: var(--text-3xl);
		}
		.lm-hero {
			padding: var(--space-10) var(--space-4) var(--space-6);
		}
	}
	@media (max-width: 480px) {
		.lm-title {
			font-size: var(--text-2xl);
		}
		.lm-subtitle {
			font-size: var(--text-lg);
		}
		.lm-form-card {
			padding: var(--space-6) var(--space-4);
		}
	}
</style>
