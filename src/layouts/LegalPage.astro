---
import Base from './Base.astro';
import LegalBody from '../components/LegalBody.astro';

interface Props {
	title: string;
	description: string;
	pageTitle: string;
	lastUpdated: string;
}

const { title, description, pageTitle, lastUpdated } = Astro.props;
---

<Base title={title} description={description}>
	<article class="legal-page">
		<header class="legal-header">
			<div class="dots dots-md dots-brand" style="top: 0; right: 0;"></div>
			<div class="dots dots-sm" style="bottom: 10%; left: -2%;"></div>
			<p class="legal-label">
				<span class="superdot"></span>
				Legal
			</p>
			<h1>{pageTitle}<span class="dot-accent">.</span></h1>
			<p class="legal-meta">Last updated: {lastUpdated}</p>
		</header>
		<LegalBody>
			<slot />
		</LegalBody>
		<footer class="legal-footer">
			<p>
				Questions? Contact <a href="mailto:privacy@superdots.sh">privacy@superdots.sh</a>
			</p>
		</footer>
	</article>
</Base>

<style>
	.legal-page {
		max-width: var(--max-width-prose);
		margin: 0 auto;
	}

	.legal-header {
		position: relative;
		overflow: hidden;
		padding: var(--space-12) 0 var(--space-8);
		border-bottom: 2px solid var(--color-border);
		margin-bottom: var(--space-8);
	}
	.legal-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.legal-header h1 {
		margin-bottom: var(--space-3);
	}
	.legal-meta {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		margin: 0;
	}

	.legal-footer {
		margin-top: var(--space-12);
		padding-top: var(--space-6);
		border-top: 2px solid var(--color-border);
	}
	.legal-footer p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		text-align: center;
		margin: 0;
	}

	@media (max-width: 768px) {
		.legal-header {
			padding: var(--space-8) 0 var(--space-6);
		}
	}
</style>
