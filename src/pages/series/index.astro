---
import { getCollection } from 'astro:content';
import { filterPublished } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { PILLARS } from '../../consts';

const PILLAR_COLORS: Record<string, string> = {
	'dot-by-dot': '#E8363B',
	'connecting-the-dots': '#14B8A6',
	'the-big-picture': '#6366F1',
	'behind-the-dots': '#F59E0B',
};

const allPosts = filterPublished(await getCollection('blog'));

const pillarsWithCounts = PILLARS.map((p) => {
	const posts = allPosts
		.filter(({ data }) => (data.contentPillar || 'dot-by-dot') === p.slug)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	return {
		...p,
		count: posts.length,
		latestTitle: posts[0]?.data.title,
		accentColor: PILLAR_COLORS[p.slug] || '#E8363B',
	};
});
---

<Base title="Series | Superdots" description="Four editorial series covering AI and work from every angle — tools, practical advice, big-picture thinking, and behind the scenes.">
	<PageHeader
		title="Our series"
		kicker="Series"
		subtitle="Four ways we explore AI and work. Pick the angle that fits how you think."
		breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Series', href: '/series/' }]}
	/>

	<div class="post-grid">
		{pillarsWithCounts.map((p) => (
			<PostCard
				title={p.label}
				description={p.description}
				href={`/series/${p.slug}/`}
				variant="series"
				pillarColor={p.accentColor}
				count={p.count}
				latestTitle={p.latestTitle}
				headingLevel="h2"
			/>
		))}
	</div>

	<NewsletterForm variant="banner" source="series-hub" />
</Base>

<style>
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}
	@media (min-width: 640px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
