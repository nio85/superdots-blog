---
import { getCollection } from 'astro:content';
import { filterPublished } from '../../lib/posts';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { PILLARS } from '../../consts';

const PILLAR_COLORS: Record<string, string> = {
	'dot-by-dot': '#E8363B',
	'connecting-the-dots': '#14B8A6',
	'the-big-picture': '#6366F1',
	'behind-the-dots': '#F59E0B',
};

export function getStaticPaths() {
	return PILLARS.map((p) => ({
		params: { slug: p.slug },
		props: { label: p.label, description: p.description, color: p.color },
	}));
}

const { slug } = Astro.params;
const { label, description } = Astro.props;
const accentColor = PILLAR_COLORS[slug!] || '#E8363B';

const allPosts = filterPublished(await getCollection('blog'));
const posts = allPosts
	.filter(({ data }) => (data.contentPillar || 'dot-by-dot') === slug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`${label} | Superdots`} description={description}>
	<PageHeader
		title={label}
		kicker="Series"
		subtitle={description}
		count={posts.length}
		countLabel={posts.length === 1 ? 'article' : 'articles'}
		breadcrumbs={[
			{ label: 'Home', href: '/' },
			{ label: 'Series', href: '/series/' },
			{ label: label, href: `/series/${slug}/` },
		]}
	/>

	{posts.length === 0 ? (
		<p class="empty">No articles yet in this series. Check back soon.</p>
	) : (
		<div class="post-grid">
			{posts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					department={post.data.department}
					useCase={post.data.useCase}
					slug={post.slug}
					tags={post.data.tags}
					contentPillar={post.data.contentPillar}
					headingLevel="h2"
				/>
			))}
		</div>
	)}

	<NewsletterForm variant="banner" source={`series-${slug}`} />
</Base>

<style>
	.empty {
		color: var(--color-text-muted);
		font-style: italic;
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}
	@media (min-width: 640px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
