---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="Practical AI Guides & Tools | Superdots" description="Browse all practical AI guides and tools for every business team.">
	<script slot="head" type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"name": "Practical AI Guides & Tools",
		"description": "Browse all practical AI guides and tools for every business team.",
		"url": "https://superdots.sh/blog",
		"mainEntity": {
			"@type": "ItemList",
			"numberOfItems": posts.length,
			"itemListElement": posts.slice(0, 10).map((post, i) => ({
				"@type": "ListItem",
				"position": i + 1,
				"url": `https://superdots.sh/blog/${post.slug}/`
			}))
		}
	})} />
	<div class="page-header">
		<div class="dots dots-md dots-loose" style="top: 5%; right: 3%;" aria-hidden="true"></div>
		<h1>Practical AI Guides & Tools<span class="dot-accent">.</span></h1>
		<p class="page-desc">Step-by-step AI guides for every team — from sales call prep to contract review. No theory, no hype. Just techniques you can use today.</p>
	</div>
	<div class="post-grid">
		{posts.map((post) => (
			<PostCard
				title={post.data.title}
				description={post.data.description}
				pubDate={post.data.pubDate}
				department={post.data.department}
				useCase={post.data.useCase}
				slug={post.slug}
				tags={post.data.tags}
				headingLevel="h2"
			/>
		))}
	</div>
	<NewsletterForm variant="banner" source="blog-listing" />
</Base>

<style>
	.page-desc {
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		margin-bottom: var(--space-6);
		line-height: var(--leading-snug);
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}
	@media (min-width: 640px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
