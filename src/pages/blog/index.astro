---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="All Articles | Superdots" description="Browse all practical AI guides.">
	<div class="page-header">
		<div class="dots dots-md dots-loose" style="top: -10%; right: 0;"></div>
		<h1>All articles<span class="dot-accent">.</span></h1>
		<p class="page-desc">{posts.length} practical guides and counting</p>
	</div>
	<div class="post-grid">
		{posts.map((post) => (
			<PostCard
				title={post.data.title}
				description={post.data.description}
				pubDate={post.data.pubDate}
				department={post.data.department}
				useCase={post.data.useCase}
				slug={post.slug}
			/>
		))}
	</div>
</Base>

<style>
	.page-header {
		position: relative;
		overflow: hidden;
		padding: var(--space-6) 0 var(--space-2);
	}
	.page-header h1 {
		margin-bottom: var(--space-2);
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.page-desc {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		margin-bottom: var(--space-6);
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}
	@media (min-width: 640px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
