---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { getReadingTime } from '../../utils/readingTime';

const allPosts = await getCollection('blog');

// Guide definitions with article slugs for reading time
const guideDefs = [
	{
		title: 'AI for HR',
		description: 'Automate recruiting, onboarding, performance reviews, and workforce planning — without losing the human touch.',
		href: '/blog/ai-for-hr/',
		slug: 'ai-for-hr',
		department: 'HR',
		available: true,
	},
	{
		title: 'AI for Sales',
		description: 'Automate prospecting, personalize outreach, forecast revenue, and close more deals.',
		href: '/blog/ai-for-sales-complete-guide/',
		slug: 'ai-for-sales-complete-guide',
		department: 'Sales',
		available: true,
	},
	{
		title: 'AI for Marketing',
		description: 'Create content, personalize campaigns, optimize SEO, and track brand performance at scale.',
		href: '/blog/ai-for-marketing-complete-guide/',
		slug: 'ai-for-marketing-complete-guide',
		department: 'Marketing',
		available: true,
	},
	{
		title: 'AI for Customer Service',
		description: 'Build faster support with AI chatbots, sentiment analysis, and automated ticket resolution.',
		department: 'Customer Service',
		available: false,
	},
	{
		title: 'AI Business Automation',
		description: 'Streamline workflows across departments with practical AI-powered automation.',
		department: 'Operations',
		available: false,
	},
];

// Enrich guides with reading time and related article count
const guides = guideDefs.map((g) => {
	if (!g.available || !g.slug) return { ...g, readingTime: 0, relatedCount: 0 };
	const post = allPosts.find((p) => p.slug === g.slug);
	const readingTime = post ? getReadingTime(post.body) : 0;
	// Count articles in the same department (excluding the guide itself)
	const deptSlug = g.department.toLowerCase().replace(/\s+/g, '-');
	const relatedCount = allPosts.filter((p) => p.data.department === deptSlug && p.slug !== g.slug).length;
	return { ...g, readingTime, relatedCount };
});

const availableGuides = guides.filter((g) => g.available);
const comingSoonGuides = guides.filter((g) => !g.available);
---

<Base title="Guides | Superdots" description="In-depth AI guides for every department. Comprehensive playbooks covering tools, strategies, and real implementation advice.">
	<div class="page-header">
		<div class="dots dots-md" style="top: -15%; right: 0;" aria-hidden="true"></div>
		<p class="page-label">
			<span class="superdot"></span>
			Complete guides
		</p>
		<h1>AI playbooks for<br/>every team<span class="dot-accent">.</span></h1>
		<p class="page-desc">Deep-dive guides covering tools, strategies, and real implementation advice. Each guide is a comprehensive resource for bringing AI into your department.</p>
	</div>

	<section class="guides-grid">
		{availableGuides.map((guide) => (
			<PostCard
				title={guide.title}
				description={guide.description}
				department={guide.department}
				href={guide.href}
				headingLevel="h2"
				variant="guide"
				readingTime={guide.readingTime}
				relatedCount={guide.relatedCount}
			/>
		))}
	</section>

	{comingSoonGuides.length > 0 && (
		<section class="coming-soon-section">
			<p class="coming-soon-label">More guides in the works</p>
			<div class="coming-soon-row">
				{comingSoonGuides.map((guide) => (
					<div class="coming-soon-card">
						<span class="coming-soon-dept">{guide.department}</span>
						<span class="coming-soon-title">{guide.title}</span>
					</div>
				))}
			</div>
		</section>
	)}

	<!-- Evaluation checklist CTA -->
	<section class="eval-cta">
		<div class="eval-cta-inner">
			<div class="eval-cta-text">
				<h2>Not sure where to start?</h2>
				<p>Sign up for our newsletter and get practical AI tips delivered weekly — no fluff, just actionable advice for your team.</p>
			</div>
		</div>
	</section>

	<NewsletterForm variant="banner" source="guides-listing" />
</Base>

<style>
	.page-header {
		padding: var(--space-8) 0 var(--space-4);
		text-align: center;
		max-width: 640px;
		margin: 0 auto;
	}
	.page-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.page-label .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
	}
	.page-header h1 {
		font-size: var(--text-4xl);
		line-height: 1.1;
		margin-bottom: var(--space-4);
		letter-spacing: -0.03em;
	}
	.page-desc {
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		margin: 0;
	}

	/* Guides grid */
	.guides-grid {
		display: grid;
		gap: var(--space-5);
		padding: var(--space-8) 0 var(--space-6);
	}

	/* Guide cards use PostCard component — no custom card styles needed */

	/* Coming soon — compact, de-emphasized */
	.coming-soon-section {
		padding-bottom: var(--space-8);
	}
	.coming-soon-label {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: var(--space-3);
	}
	.coming-soon-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
	.coming-soon-card {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-4);
		border: 1px dashed var(--color-border);
		border-radius: var(--radius-lg);
		opacity: 0.6;
	}
	.coming-soon-dept {
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
		background: var(--color-bg-dim);
		padding: 2px var(--space-2);
		border-radius: var(--radius-sm);
	}
	.coming-soon-title {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-muted);
	}

	/* Evaluation CTA */
	.eval-cta {
		padding: var(--space-2) 0 var(--space-8);
	}
	.eval-cta-inner {
		padding: var(--space-6) var(--space-8);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-bg-dim);
		text-align: center;
	}
	.eval-cta h2 {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		margin: 0 0 var(--space-2);
	}
	.eval-cta p {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		margin: 0;
		max-width: 480px;
		margin-inline: auto;
	}

	@media (min-width: 640px) {
		.guides-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.guides-grid :global(.post-card:first-child) {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 480px) {
		.page-header h1 {
			font-size: var(--text-3xl);
		}
		.eval-cta-inner {
			padding: var(--space-5);
		}
	}
</style>
