---
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';

const guides = [
	{
		title: 'AI for HR',
		description: 'Automate recruiting, onboarding, performance reviews, and workforce planning — without losing the human touch.',
		href: '/blog/ai-for-hr/',
		department: 'HR',
		available: true,
	},
	{
		title: 'AI for Sales',
		description: 'Automate prospecting, personalize outreach, forecast revenue, and close more deals.',
		href: '/blog/ai-for-sales-complete-guide/',
		department: 'Sales',
		available: true,
	},
	{
		title: 'AI for Marketing',
		description: 'Create content, personalize campaigns, optimize SEO, and track brand performance at scale.',
		href: '/blog/ai-for-marketing-complete-guide/',
		department: 'Marketing',
		available: true,
	},
	{
		title: 'AI for Customer Service',
		description: 'Build faster support with AI chatbots, sentiment analysis, and automated ticket resolution.',
		department: 'Customer Service',
		available: false,
	},
	{
		title: 'AI Business Automation',
		description: 'Streamline workflows across departments with practical AI-powered automation.',
		department: 'Operations',
		available: false,
	},
];
---

<Base title="Guides | Superdots" description="In-depth AI guides for every department. Comprehensive playbooks covering tools, strategies, and real implementation advice.">
	<div class="page-header">
		<div class="dots dots-md" style="top: -15%; right: 0;" aria-hidden="true"></div>
		<p class="page-label">
			<span class="superdot"></span>
			Complete guides
		</p>
		<h1>AI playbooks for<br/>every team<span class="dot-accent">.</span></h1>
		<p class="page-desc">Deep-dive guides covering tools, strategies, and real implementation advice. Each guide is a comprehensive resource for bringing AI into your department.</p>
	</div>

	<section class="guides-grid">
		{guides.map((guide) => (
			guide.available ? (
				<a href={guide.href} class="guide-card">
					<div class="guide-card-inner">
						<span class="guide-dept">{guide.department}</span>
						<h2 class="guide-title">{guide.title}</h2>
						<p class="guide-desc">{guide.description}</p>
						<span class="guide-cta">
							Read guide
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
						</span>
					</div>
					<div class="guide-card-glow" aria-hidden="true"></div>
				</a>
			) : (
				<div class="guide-card guide-card--soon">
					<div class="guide-card-inner">
						<span class="guide-dept">{guide.department}</span>
						<h2 class="guide-title">{guide.title}</h2>
						<p class="guide-desc">{guide.description}</p>
						<span class="guide-soon-badge">Coming soon</span>
					</div>
				</div>
			)
		))}
	</section>
	<NewsletterForm variant="banner" source="guides-listing" />
</Base>

<style>
	.page-header {
		position: relative;
		overflow: hidden;
		padding: var(--space-8) 0 var(--space-4);
		text-align: center;
		max-width: 640px;
		margin: 0 auto;
	}
	.page-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.page-label .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
	}
	.page-header h1 {
		font-size: var(--text-4xl);
		line-height: 1.1;
		margin-bottom: var(--space-4);
		letter-spacing: -0.03em;
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.page-desc {
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		margin: 0;
	}

	/* Guides grid */
	.guides-grid {
		display: grid;
		gap: var(--space-5);
		padding: var(--space-8) 0 var(--space-12);
	}

	/* Guide card */
	.guide-card {
		position: relative;
		display: block;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		background: var(--color-bg);
		text-decoration: none;
		overflow: hidden;
		transition: all 300ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.guide-card-inner {
		position: relative;
		z-index: 1;
		padding: var(--space-8) var(--space-8) var(--space-6);
	}
	.guide-card-glow {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--color-primary), var(--sd-teal));
		opacity: 0;
		transition: opacity 300ms ease;
	}

	a.guide-card:hover {
		border-color: var(--color-primary);
		box-shadow: var(--shadow-lg);
		transform: translateY(-3px);
		text-decoration: none;
	}
	a.guide-card:hover .guide-card-glow {
		opacity: 1;
	}
	a.guide-card:hover .guide-cta {
		gap: var(--space-2);
		color: var(--color-primary);
	}

	.guide-dept {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		background: var(--sd-red-light);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-full);
		margin-bottom: var(--space-3);
	}
	.guide-title {
		font-size: var(--text-2xl);
		margin: 0 0 var(--space-2);
		color: var(--color-text-strong);
		letter-spacing: -0.02em;
	}
	.guide-desc {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		margin: 0 0 var(--space-4);
		max-width: 540px;
	}
	.guide-cta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		transition: all var(--transition-fast);
	}

	/* Coming soon variant */
	.guide-card--soon {
		opacity: 0.55;
		cursor: default;
	}
	.guide-card--soon .guide-dept {
		background: var(--color-bg-dim);
		color: var(--color-text-muted);
	}
	.guide-soon-badge {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
		border: 1px solid var(--color-border);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-full);
	}

	@media (min-width: 640px) {
		.guides-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		/* Make the first card span full width for visual hierarchy */
		.guide-card:first-child {
			grid-column: 1 / -1;
		}
		.guide-card:first-child .guide-title {
			font-size: var(--text-3xl);
		}
		.guide-card:first-child .guide-desc {
			max-width: 640px;
		}
	}

	@media (max-width: 480px) {
		.page-header h1 {
			font-size: var(--text-3xl);
		}
		.guide-card-inner {
			padding: var(--space-5) var(--space-5) var(--space-4);
		}
		.guide-title {
			font-size: var(--text-xl);
		}
	}
</style>
