---
import Base from '../layouts/Base.astro';
---

<Base title="Design System | Superdots" description="Superdots brand identity and design system showcase.">
	<div class="ds-header">
		<p class="ds-label">
			<svg class="ds-label-mark" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<circle cx="14" cy="50" r="6" fill="currentColor"/>
				<circle cx="32" cy="32" r="8" fill="currentColor"/>
				<circle cx="50" cy="14" r="10" fill="currentColor"/>
			</svg>
			Brand Book
		</p>
		<h1>Superdots Brand<span class="dot-accent">.</span></h1>
		<p class="ds-sub">The visual DNA of Superdots. Bold, human, trustworthy, no-fluff.</p>
	</div>

	<!-- Logo -->
	<section class="ds-section">
		<h2>Logo & Mark</h2>
		<p class="ds-note">Three ascending dots — minimal, memorable. Represents progression, growth, and the leveling-up that AI enables at work.</p>

		<h3>Primary Logo</h3>
		<div class="logo-showcase">
			<div class="logo-demo logo-demo-light">
				<svg viewBox="0 0 280 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="logo-svg">
					<circle cx="14" cy="50" r="6" fill="#E8363B"/>
					<circle cx="32" cy="32" r="8" fill="#E8363B"/>
					<circle cx="50" cy="14" r="10" fill="#E8363B"/>
					<text x="72" y="44" font-family="'Space Grotesk', system-ui, sans-serif" font-weight="700" font-size="32" fill="#0B1222" letter-spacing="-0.02em">superdots</text>
				</svg>
				<span class="logo-demo-label">Light background</span>
			</div>
			<div class="logo-demo logo-demo-dark">
				<svg viewBox="0 0 280 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="logo-svg">
					<circle cx="14" cy="50" r="6" fill="#E8363B"/>
					<circle cx="32" cy="32" r="8" fill="#E8363B"/>
					<circle cx="50" cy="14" r="10" fill="#E8363B"/>
					<text x="72" y="44" font-family="'Space Grotesk', system-ui, sans-serif" font-weight="700" font-size="32" fill="#FFFFFF" letter-spacing="-0.02em">superdots</text>
				</svg>
				<span class="logo-demo-label">Dark background</span>
			</div>
		</div>

		<h3>Icon Mark</h3>
		<div class="icon-showcase">
			<div class="icon-demo icon-demo-light">
				<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-svg">
					<circle cx="14" cy="50" r="6" fill="#E8363B"/>
					<circle cx="32" cy="32" r="8" fill="#E8363B"/>
					<circle cx="50" cy="14" r="10" fill="#E8363B"/>
				</svg>
				<span class="logo-demo-label">Red (primary)</span>
			</div>
			<div class="icon-demo icon-demo-navy">
				<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-svg">
					<circle cx="14" cy="50" r="6" fill="#0B1222"/>
					<circle cx="32" cy="32" r="8" fill="#0B1222"/>
					<circle cx="50" cy="14" r="10" fill="#0B1222"/>
				</svg>
				<span class="logo-demo-label">Navy</span>
			</div>
			<div class="icon-demo icon-demo-dark">
				<svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-svg">
					<circle cx="14" cy="50" r="6" fill="#FFFFFF"/>
					<circle cx="32" cy="32" r="8" fill="#FFFFFF"/>
					<circle cx="50" cy="14" r="10" fill="#FFFFFF"/>
				</svg>
				<span class="logo-demo-label">White</span>
			</div>
			<div class="icon-demo icon-demo-favicon">
				<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" class="favicon-svg">
					<rect width="32" height="32" rx="6" fill="#0B1222"/>
					<circle cx="9" cy="23" r="3" fill="#E8363B"/>
					<circle cx="16" cy="16" r="4" fill="#E8363B"/>
					<circle cx="23" cy="9" r="5" fill="#E8363B"/>
				</svg>
				<span class="logo-demo-label">Favicon</span>
			</div>
		</div>

		<h3>Usage Rules</h3>
		<div class="usage-rules">
			<div class="rule rule-do">
				<strong>Do</strong>
				<ul>
					<li>Maintain clear space equal to smallest dot diameter around the logo</li>
					<li>Use icon mark only below 140px width</li>
					<li>Keep dots in the ascending diagonal orientation</li>
				</ul>
			</div>
			<div class="rule rule-dont">
				<strong>Don't</strong>
				<ul>
					<li>Rotate, stretch, or distort the logo</li>
					<li>Add shadows, outlines, or effects</li>
					<li>Recolor dots to non-brand colors</li>
					<li>Use wordmark without the icon mark</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- Colors -->
	<section class="ds-section">
		<h2>Color Palette</h2>
		<h3>Brand Colors</h3>
		<div class="swatch-grid">
			<div class="swatch">
				<div class="swatch-color" style="background: var(--sd-red);"></div>
				<div class="swatch-info">
					<strong>Red (Primary)</strong>
					<code>#E8363B</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--sd-red-dark);"></div>
				<div class="swatch-info">
					<strong>Red Dark</strong>
					<code>#CC2D32</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color swatch-light" style="background: var(--sd-red-light);"></div>
				<div class="swatch-info">
					<strong>Red Light</strong>
					<code>#FEE2E2</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--sd-teal);"></div>
				<div class="swatch-info">
					<strong>Teal (Secondary)</strong>
					<code>#14B8A6</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--sd-teal-dark);"></div>
				<div class="swatch-info">
					<strong>Teal Dark</strong>
					<code>#0D9488</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color swatch-light" style="background: var(--sd-teal-light);"></div>
				<div class="swatch-info">
					<strong>Teal Light</strong>
					<code>#CCFBF1</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--sd-amber);"></div>
				<div class="swatch-info">
					<strong>Amber (Accent)</strong>
					<code>#F59E0B</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--sd-navy);"></div>
				<div class="swatch-info">
					<strong>Navy</strong>
					<code>#0B1222</code>
				</div>
			</div>
		</div>

		<h3>Neutrals</h3>
		<div class="neutral-strip">
			<div class="neutral-swatch" style="background: var(--sd-gray-50);"><span>50</span></div>
			<div class="neutral-swatch" style="background: var(--sd-gray-100);"><span>100</span></div>
			<div class="neutral-swatch" style="background: var(--sd-gray-200);"><span>200</span></div>
			<div class="neutral-swatch" style="background: var(--sd-gray-300);"><span>300</span></div>
			<div class="neutral-swatch" style="background: var(--sd-gray-400); color: white;"><span>400</span></div>
			<div class="neutral-swatch" style="background: var(--sd-gray-500); color: white;"><span>500</span></div>
			<div class="neutral-swatch" style="background: var(--sd-gray-600); color: white;"><span>600</span></div>
			<div class="neutral-swatch" style="background: var(--sd-gray-700); color: white;"><span>700</span></div>
			<div class="neutral-swatch" style="background: var(--sd-gray-800); color: white;"><span>800</span></div>
			<div class="neutral-swatch" style="background: var(--sd-gray-900); color: white;"><span>900</span></div>
		</div>
	</section>

	<!-- Typography -->
	<section class="ds-section">
		<h2>Typography</h2>

		<div class="type-specimen">
			<div class="type-label">Space Grotesk — Display</div>
			<p class="type-display">The quick brown fox jumps over the lazy dog</p>
		</div>

		<div class="type-specimen">
			<div class="type-label">Inter — Body</div>
			<p class="type-body">The quick brown fox jumps over the lazy dog. Every article focuses on real techniques you can apply today. No hype, no jargon walls — just clear, tested approaches.</p>
		</div>

		<div class="type-specimen">
			<div class="type-label">JetBrains Mono — Code</div>
			<p class="type-code">const result = await ai.analyze(data);</p>
		</div>

		<h3>Type Scale</h3>
		<div class="type-scale">
			<div class="scale-row"><span class="scale-label">5xl / 48px</span><span class="scale-sample" style="font-size: var(--text-5xl);">Headline</span></div>
			<div class="scale-row"><span class="scale-label">4xl / 36px</span><span class="scale-sample" style="font-size: var(--text-4xl);">Headline</span></div>
			<div class="scale-row"><span class="scale-label">3xl / 30px</span><span class="scale-sample" style="font-size: var(--text-3xl);">Heading</span></div>
			<div class="scale-row"><span class="scale-label">2xl / 24px</span><span class="scale-sample" style="font-size: var(--text-2xl);">Heading</span></div>
			<div class="scale-row"><span class="scale-label">xl / 20px</span><span class="scale-sample" style="font-size: var(--text-xl);">Subheading</span></div>
			<div class="scale-row"><span class="scale-label">lg / 18px</span><span class="scale-sample" style="font-size: var(--text-lg);">Body text</span></div>
			<div class="scale-row"><span class="scale-label">base / 16px</span><span class="scale-sample" style="font-size: var(--text-base);">Body text</span></div>
			<div class="scale-row"><span class="scale-label">sm / 14px</span><span class="scale-sample" style="font-size: var(--text-sm);">Caption</span></div>
			<div class="scale-row"><span class="scale-label">xs / 12px</span><span class="scale-sample" style="font-size: var(--text-xs);">Badge</span></div>
		</div>
	</section>

	<!-- Buttons -->
	<section class="ds-section">
		<h2>Buttons</h2>
		<div class="button-row">
			<a href="#" class="btn btn-primary">Primary</a>
			<a href="#" class="btn btn-secondary">Secondary</a>
			<a href="#" class="btn btn-ghost">Ghost</a>
		</div>
		<div class="button-row">
			<a href="#" class="btn btn-primary btn-lg">Large Primary</a>
			<a href="#" class="btn btn-secondary btn-lg">Large Secondary</a>
		</div>
		<div class="button-row">
			<a href="#" class="btn btn-primary btn-sm">Small</a>
			<a href="#" class="btn btn-secondary btn-sm">Small</a>
			<a href="#" class="btn btn-ghost btn-sm">Small</a>
		</div>
	</section>

	<!-- Badges -->
	<section class="ds-section">
		<h2>Badges</h2>
		<div class="badge-row">
			<span class="badge badge-dept">Engineering</span>
			<span class="badge badge-dept">Marketing</span>
			<span class="badge badge-dept">Sales</span>
			<span class="badge badge-dept">HR</span>
			<span class="badge badge-dept">Finance</span>
			<span class="badge badge-dept">Operations</span>
		</div>
		<div class="badge-row">
			<span class="badge badge-usecase">Automation</span>
			<span class="badge badge-usecase">Analysis</span>
			<span class="badge badge-usecase">Writing</span>
			<span class="badge badge-usecase">Communication</span>
		</div>
		<div class="badge-row">
			<span class="badge badge-tag">AI Tools</span>
			<span class="badge badge-tag">Productivity</span>
			<span class="badge badge-tag">How-To</span>
		</div>
	</section>

	<!-- Cards -->
	<section class="ds-section">
		<h2>Cards</h2>
		<div class="card-grid">
			<div class="card">
				<h3>Standard Card</h3>
				<p>Hover for border and shadow effect. Cards lift slightly and get a red border accent.</p>
			</div>
			<div class="card-flat">
				<h3>Flat Card</h3>
				<p>For secondary content areas. No border, subtle background tint.</p>
			</div>
		</div>
	</section>

	<!-- The Dot -->
	<section class="ds-section">
		<h2>The Superdot</h2>
		<p>Our signature brand element. A small red dot that represents clarity and precision.</p>
		<div class="dot-demo">
			<span class="superdot"></span>
			<span class="dot-label">8px (default)</span>
			<span class="superdot superdot-lg"></span>
			<span class="dot-label">12px (large)</span>
		</div>
		<div class="dot-usage">
			<h3>Cut through the noise<span class="dot-accent">.</span></h3>
			<p>Used as a period accent on key headlines to reinforce brand presence.</p>
		</div>
	</section>

	<!-- Spacing -->
	<section class="ds-section">
		<h2>Spacing Scale</h2>
		<div class="spacing-demo">
			<div class="space-bar" style="width: var(--space-1);"><span>1</span></div>
			<div class="space-bar" style="width: var(--space-2);"><span>2</span></div>
			<div class="space-bar" style="width: var(--space-3);"><span>3</span></div>
			<div class="space-bar" style="width: var(--space-4);"><span>4</span></div>
			<div class="space-bar" style="width: var(--space-5);"><span>5</span></div>
			<div class="space-bar" style="width: var(--space-6);"><span>6</span></div>
			<div class="space-bar" style="width: var(--space-8);"><span>8</span></div>
			<div class="space-bar" style="width: var(--space-10);"><span>10</span></div>
			<div class="space-bar" style="width: var(--space-12);"><span>12</span></div>
			<div class="space-bar" style="width: var(--space-16);"><span>16</span></div>
		</div>
	</section>

	<!-- Shadows -->
	<section class="ds-section">
		<h2>Shadows</h2>
		<div class="shadow-grid">
			<div class="shadow-box" style="box-shadow: var(--shadow-sm);">
				<span>shadow-sm</span>
			</div>
			<div class="shadow-box" style="box-shadow: var(--shadow-md);">
				<span>shadow-md</span>
			</div>
			<div class="shadow-box" style="box-shadow: var(--shadow-lg);">
				<span>shadow-lg</span>
			</div>
			<div class="shadow-box" style="box-shadow: var(--shadow-glow);">
				<span>shadow-glow</span>
			</div>
		</div>
	</section>

	<!-- Semantic Colors (Theme-aware) -->
	<section class="ds-section">
		<h2>Semantic Colors <span class="theme-indicator">(current theme)</span></h2>
		<p class="ds-note">These values change between light and dark mode. Toggle the theme to compare.</p>
		<div class="swatch-grid">
			<div class="swatch">
				<div class="swatch-color" style="background: var(--color-bg);"></div>
				<div class="swatch-info">
					<strong>Background</strong>
					<code>--color-bg</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--color-bg-dim);"></div>
				<div class="swatch-info">
					<strong>Background Dim</strong>
					<code>--color-bg-dim</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--color-bg-code);"></div>
				<div class="swatch-info">
					<strong>Code Background</strong>
					<code>--color-bg-code</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--color-text-strong);"></div>
				<div class="swatch-info">
					<strong>Text Strong</strong>
					<code>--color-text-strong</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--color-text);"></div>
				<div class="swatch-info">
					<strong>Text</strong>
					<code>--color-text</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--color-text-muted);"></div>
				<div class="swatch-info">
					<strong>Text Muted</strong>
					<code>--color-text-muted</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--color-border);"></div>
				<div class="swatch-info">
					<strong>Border</strong>
					<code>--color-border</code>
				</div>
			</div>
			<div class="swatch">
				<div class="swatch-color" style="background: var(--color-border-strong);"></div>
				<div class="swatch-info">
					<strong>Border Strong</strong>
					<code>--color-border-strong</code>
				</div>
			</div>
		</div>
	</section>

	<!-- Prose -->
	<section class="ds-section">
		<h2>Prose / Long-form Content</h2>
		<div class="prose-demo">
			<h3>This is what article content looks like</h3>
			<p>
				Body text uses Inter at 18px with relaxed line height (1.75). This ensures
				comfortable reading on all devices. <strong>Bold text stands out</strong> and
				<a href="#">links are underlined</a> with the primary red color.
			</p>
			<blockquote>
				<p>Blockquotes have a red left border, a dim background, and italic styling.
				They're used for pull-quotes and callouts.</p>
			</blockquote>
			<p>Inline <code>code</code> gets a subtle background and border treatment.</p>
			<ul>
				<li>List items have red markers</li>
				<li>Consistent vertical spacing</li>
				<li>Readable at all sizes</li>
			</ul>
		</div>
	</section>

	<!-- Imagery Style -->
	<section class="ds-section">
		<h2>Imagery Style</h2>
		<p class="ds-note">Guidelines for AI-generated and selected imagery across the brand.</p>

		<div class="imagery-grid">
			<div class="imagery-card">
				<h3>Tone</h3>
				<p>Warm, human, practical. Show real work scenarios — people at desks, teams collaborating, dashboards and tools in use. Avoid sterile stock photography.</p>
			</div>
			<div class="imagery-card">
				<h3>Color Treatment</h3>
				<p>Favor warm tones. If using brand colors as overlays or accents, use red sparingly as a highlight, not as a dominant wash. Navy works well for dark hero backgrounds.</p>
			</div>
			<div class="imagery-card">
				<h3>Illustrations</h3>
				<p>Abstract, geometric, dot-based. Use the ascending dot motif as a recurring element. SVG preferred for performance. Flat style, no 3D or skeuomorphism.</p>
			</div>
			<div class="imagery-card">
				<h3>Don'ts</h3>
				<p>No robots or sci-fi imagery. No cold blue AI aesthetics. No clip art. No busy patterns that compete with text content.</p>
			</div>
		</div>
	</section>

	<!-- Voice & Tone -->
	<section class="ds-section">
		<h2>Voice & Tone</h2>
		<div class="voice-grid">
			<div class="voice-card">
				<div class="voice-label">We are</div>
				<ul>
					<li><strong>Direct</strong> — say it plainly, no jargon walls</li>
					<li><strong>Practical</strong> — techniques you can apply today</li>
					<li><strong>Human</strong> — we write for people, not algorithms</li>
					<li><strong>Confident</strong> — no hedging, no "might" or "could possibly"</li>
				</ul>
			</div>
			<div class="voice-card">
				<div class="voice-label">We are not</div>
				<ul>
					<li><strong>Hype-driven</strong> — no "revolutionize" or "game-changing"</li>
					<li><strong>Corporate</strong> — no buzzword bingo</li>
					<li><strong>Academic</strong> — no unnecessary complexity</li>
					<li><strong>Dismissive</strong> — we respect every department and skill level</li>
				</ul>
			</div>
		</div>
	</section>
</Base>

<style>
	/* Page Header */
	.ds-header {
		padding: var(--space-12) 0 var(--space-8);
		text-align: center;
	}
	.ds-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.ds-label-mark {
		width: 16px;
		height: 16px;
		color: var(--color-primary);
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.ds-sub {
		color: var(--color-text-muted);
		font-size: var(--text-xl);
		max-width: 500px;
		margin: 0 auto;
	}

	/* Sections */
	.ds-section {
		padding: var(--space-10) 0;
		border-top: 1px solid var(--color-border);
	}
	.ds-section h2 {
		font-family: var(--font-display);
		margin-bottom: var(--space-6);
	}
	.ds-section h3 {
		font-family: var(--font-display);
		margin-top: var(--space-6);
		margin-bottom: var(--space-4);
	}

	/* Color Swatches */
	.swatch-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		gap: var(--space-4);
	}
	.swatch {
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border);
	}
	.swatch-color {
		height: 80px;
	}
	.swatch-light {
		border-bottom: 1px solid var(--color-border);
	}
	.swatch-info {
		padding: var(--space-3);
	}
	.swatch-info strong {
		display: block;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		margin-bottom: var(--space-1);
		color: var(--color-text-strong);
	}
	.swatch-info code {
