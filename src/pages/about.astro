---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { DEPARTMENTS } from '../consts';

const allPosts = await getCollection('blog');
const departmentsWithContent = new Set(allPosts.map((p) => p.data.department));

const guides = [
	{ title: 'AI for HR', href: '/blog/ai-for-hr/', dept: 'HR' },
	{ title: 'AI for Sales', href: '/blog/ai-for-sales-complete-guide/', dept: 'Sales' },
	{ title: 'AI for Marketing', href: '/blog/ai-for-marketing-complete-guide/', dept: 'Marketing' },
];
---

<Base title="About | Superdots" description="About Superdots — practical AI guides for every department.">
	<PageHeader
		title="Built by one person and nine AI agents"
		kicker="About us"
		subtitle="From a homelab in Italy. 8GB of RAM. No venture capital. Just practical guides that respect your time."
		breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }]}
	/>

	<div class="prose">
		<p>
			Every morning at 6 AM CET, an Ubuntu server in a small apartment in Italy wakes up.
			Nine AI agents check their task boards, read their assignments, and start working.
			One researches keywords. Another writes a draft. A third reviews it for legal compliance.
			By the time <a href="/about/luca/">Luca Bartoccini</a> — the only human on the team — pours his first coffee,
			the first draft is usually waiting for his review.
		</p>
		<p>
			That's Superdots. Not a media company with a bullpen of writers. Not a content farm.
			One person coordinating nine AI agents from a Proxmox VM with 4 CPUs and 8GB of RAM,
			publishing practical guides about AI for people who actually have jobs to do.
		</p>

		<h2>Why this exists</h2>
		<p>
			Most AI content falls into two buckets: breathless hype ("AI will replace all jobs by Tuesday")
			or impenetrable technical papers. Neither helps the operations manager wondering if she should
			use AI for vendor contracts, or the sales rep trying to figure out which CRM add-on is worth
			the $30/month.
		</p>
		<p>
			We write for them. Specific tools, specific prices, specific steps.
			No "leverage AI to unlock synergies." Just: here's how to use this thing to do your job better.
		</p>

		<h2>The team</h2>
		<p>
			We're upfront about this: our content is AI-assisted and human-edited.
			Here's exactly who does what.
		</p>
		<div class="team-grid">
			<div class="team-card team-card--human">
				<span class="team-role">Human</span>
				<h3>Luca Bartoccini</h3>
				<p>Founder, editor, the one who says "no, rewrite that." Final sign-off on everything published. <a href="/about/luca/">Full bio →</a></p>
			</div>
			<div class="team-card">
				<span class="team-role">AI Agent</span>
				<h3>CEO</h3>
				<p>Sets editorial priorities, manages the content calendar, and keeps the whole operation from going off the rails.</p>
			</div>
			<div class="team-card">
				<span class="team-role">AI Agent</span>
				<h3>Program Manager</h3>
				<p>Runs the daily pipeline — makes sure briefs move from research to draft to published without bottlenecks.</p>
			</div>
			<div class="team-card">
				<span class="team-role">AI Agent</span>
				<h3>Content Manager</h3>
				<p>Reviews every article for quality, consistency, and tone before it goes live. The editorial gatekeeper.</p>
			</div>
			<div class="team-card">
				<span class="team-role">AI Agent</span>
				<h3>SEO Expert</h3>
				<p>Researches keywords, analyzes competitors, writes content briefs. Finds the gaps other blogs miss.</p>
			</div>
			<div class="team-card">
				<span class="team-role">AI Agent</span>
				<h3>Copywriter</h3>
				<p>Writes the articles. Turns SEO briefs into prose that humans actually want to read.</p>
			</div>
			<div class="team-card">
				<span class="team-role">AI Agent</span>
				<h3>Frontend Designer</h3>
				<p>Generates hero images, handles design tweaks, and makes sure the site looks sharp.</p>
			</div>
			<div class="team-card">
				<span class="team-role">AI Agent</span>
				<h3>Growth Analyst</h3>
				<p>Tracks what's working — traffic, rankings, click-through rates — and flags what needs attention.</p>
			</div>
			<div class="team-card">
				<span class="team-role">AI Agent</span>
				<h3>Legal Expert</h3>
				<p>Reviews content for compliance, manages privacy policies, and keeps us out of trouble.</p>
			</div>
			<div class="team-card">
				<span class="team-role">AI Agent</span>
				<h3>Founding Engineer</h3>
				<p>Maintains the site infrastructure, fixes bugs, ships features. The one who keeps the lights on.</p>
			</div>
		</div>

		<p style="margin-top: var(--space-6);">
			Want the full breakdown of how these agents coordinate? Read <a href="/how-we-work/">how we work</a>.
		</p>

		<h2>What we promise</h2>
		<div class="approach-grid">
			<div class="approach-card">
				<div class="approach-icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
				</div>
				<h3>Specific, not generic</h3>
				<p>Tool names, pricing, step-by-step instructions. If you can't act on it today, we haven't done our job.</p>
			</div>
			<div class="approach-card">
				<div class="approach-icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
				</div>
				<h3>Honest about AI</h3>
				<p>We tell you what AI does well, where it falls short, and when the old way is still better. No cheerleading.</p>
			</div>
			<div class="approach-card">
				<div class="approach-icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
				</div>
				<h3>Transparent process</h3>
				<p>AI writes the first draft. A human reviews every word. We label it clearly. No pretending.</p>
			</div>
		</div>
	</div>

	<!-- Featured guides -->
	<section class="featured-guides">
		<h2 class="section-heading">
			<span class="superdot"></span>
			Start with a guide
		</h2>
		<div class="guides-row">
			{guides.map((g) => (
				<a href={g.href} class="guide-link-card">
					<span class="guide-link-dept">{g.dept}</span>
					<span class="guide-link-title">{g.title}</span>
					<span class="guide-link-arrow">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
					</span>
				</a>
			))}
			<a href="/guides/" class="guide-link-card guide-link-card--all">
				<span class="guide-link-title">View all guides</span>
				<span class="guide-link-arrow">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
				</span>
			</a>
		</div>
	</section>

	<!-- Browse by department -->
	<section class="browse-dept">
		<h2 class="section-heading">
			<span class="superdot"></span>
			Browse by department
		</h2>
		<div class="dept-chips">
			{DEPARTMENTS.filter((d) => departmentsWithContent.has(d.slug)).map((d) => (
				<a href={`/category/department/${d.slug}/`} class="dept-chip">
					{d.label}
				</a>
			))}
		</div>
	</section>

	<NewsletterForm variant="banner" source="about" />
</Base>

<style>
	/* Prose */
	.prose {
		line-height: var(--leading-relaxed);
	}
	.prose h2 {
		font-family: var(--font-display);
		margin-top: var(--space-10);
		margin-bottom: var(--space-4);
	}
	.prose strong {
		color: var(--color-text-strong);
	}

	/* Approach grid */
	.approach-grid {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-4);
	}
	.approach-card {
		padding: var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		transition: border-color var(--transition-fast);
	}
	.approach-card:hover {
		border-color: var(--color-primary);
	}
	.approach-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: var(--radius-md);
		background: var(--sd-red-light);
		color: var(--color-primary);
		margin-bottom: var(--space-3);
	}
	.approach-card h3 {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
	}
	.approach-card p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
		margin: 0;
	}

	/* Team grid */
	.team-grid {
		display: grid;
		gap: var(--space-3);
		margin-top: var(--space-4);
	}
	.team-card {
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		transition: border-color var(--transition-fast);
	}
	.team-card:hover {
		border-color: var(--color-primary);
	}
	.team-card--human {
		border-color: var(--color-primary);
		background: var(--sd-red-light);
	}
	.team-role {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-1);
	}
	.team-card--human .team-role {
		color: var(--color-primary);
	}
	.team-card h3 {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-1);
	}
	.team-card p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
		margin: 0;
	}
	.team-card a {
		color: var(--color-primary);
	}

	/* Section headings */
	.section-heading {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		margin-bottom: var(--space-5);
	}
	.section-heading .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
		flex-shrink: 0;
	}

	/* Featured guides */
	.featured-guides {
		padding: var(--space-10) 0 var(--space-8);
	}
	.guides-row {
		display: grid;
		gap: var(--space-3);
	}
	.guide-link-card {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		transition: all var(--transition-fast);
	}
	.guide-link-card:hover {
		border-color: var(--color-primary);
		transform: translateX(4px);
		text-decoration: none;
	}
	.guide-link-card:hover .guide-link-arrow {
		color: var(--color-primary);
	}
	.guide-link-dept {
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-primary);
		background: var(--sd-red-light);
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		flex-shrink: 0;
	}
	.guide-link-title {
		font-family: var(--font-display);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		flex: 1;
	}
	.guide-link-arrow {
		color: var(--color-text-muted);
		flex-shrink: 0;
		transition: color var(--transition-fast);
	}
	.guide-link-card--all {
		border-style: dashed;
		justify-content: center;
	}
	.guide-link-card--all .guide-link-title {
		flex: none;
		color: var(--color-text-muted);
	}

	/* Browse by department */
	.browse-dept {
		padding: var(--space-2) 0 var(--space-10);
	}
	.dept-chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.dept-chip {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		background: var(--color-bg-dim);
		border: 1px solid var(--color-border);
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-full);
		text-decoration: none;
		transition: all var(--transition-fast);
	}
	.dept-chip:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
		background: var(--sd-red-light);
		text-decoration: none;
	}

	@media (min-width: 640px) {
		.approach-grid {
			grid-template-columns: repeat(3, 1fr);
		}
		.team-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.guides-row {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 900px) {
		.team-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 480px) {
		.approach-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
