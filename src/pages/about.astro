---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { DEPARTMENTS } from '../consts';

const allPosts = await getCollection('blog');
const departmentsWithContent = new Set(allPosts.map((p) => p.data.department));

const guides = [
	{ title: 'AI for HR', href: '/blog/ai-for-hr/', dept: 'HR' },
	{ title: 'AI for Sales', href: '/blog/ai-for-sales-complete-guide/', dept: 'Sales' },
	{ title: 'AI for Marketing', href: '/blog/ai-for-marketing-complete-guide/', dept: 'Marketing' },
];
---

<Base title="About | Superdots" description="About Superdots — practical AI guides for every department.">
	<div class="about-header">
		<div class="dots dots-md" style="top: 5%; right: 3%;" aria-hidden="true"></div>
		<p class="about-label">
			<span class="superdot"></span>
			About us
		</p>
		<h1>AI guides that respect your time<span class="dot-accent">.</span></h1>
		<p class="about-subtitle">Practical, no-fluff resources for every team that uses a computer at work.</p>
	</div>

	<div class="prose">
		<p>
			We believe AI should help people work better, not replace them.
			Superdots publishes practical, no-fluff guides on how AI can help
			employees in every department — from engineering to HR, from finance
			to marketing.
		</p>
		<p>
			Every article focuses on real techniques you can apply today.
			No hype, no jargon walls, no "10x your productivity" promises —
			just clear, tested approaches to using AI tools at work.
		</p>

		<h2>Our approach</h2>
		<div class="approach-grid">
			<div class="approach-card">
				<div class="approach-icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
				</div>
				<h3>Written for practitioners</h3>
				<p>Every guide is built for the person doing the work — not their manager's manager. Step-by-step, tool-specific, immediately useful.</p>
			</div>
			<div class="approach-card">
				<div class="approach-icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
				</div>
				<h3>Tested before published</h3>
				<p>We don't write about tools we haven't used. Every workflow has been tested with real tasks in real departments.</p>
			</div>
			<div class="approach-card">
				<div class="approach-icon" aria-hidden="true">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
				</div>
				<h3>No fluff, no filler</h3>
				<p>We respect your time. Articles get to the point fast, with clear structure so you can skip to exactly what you need.</p>
			</div>
		</div>

		<h2>What we cover</h2>
		<div class="pillars-grid">
			<div class="pillar-card pillar-automation">
				<span class="pillar-label">Automation</span>
				<p>Streamline repetitive tasks so your team can focus on work that matters.</p>
			</div>
			<div class="pillar-card pillar-analysis">
				<span class="pillar-label">Analysis</span>
				<p>Make better decisions with AI-powered data insights — no data science degree required.</p>
			</div>
			<div class="pillar-card pillar-writing">
				<span class="pillar-label">Writing</span>
				<p>Draft, edit, and communicate faster while keeping your authentic voice.</p>
			</div>
			<div class="pillar-card pillar-communication">
				<span class="pillar-label">Communication</span>
				<p>Collaborate more effectively with smarter meetings, summaries, and async updates.</p>
			</div>
		</div>
	</div>

	<!-- Featured guides -->
	<section class="featured-guides">
		<h2 class="section-heading">
			<span class="superdot"></span>
			Start with a guide
		</h2>
		<div class="guides-row">
			{guides.map((g) => (
				<a href={g.href} class="guide-link-card">
					<span class="guide-link-dept">{g.dept}</span>
					<span class="guide-link-title">{g.title}</span>
					<span class="guide-link-arrow">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
					</span>
				</a>
			))}
			<a href="/guides/" class="guide-link-card guide-link-card--all">
				<span class="guide-link-title">View all guides</span>
				<span class="guide-link-arrow">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
				</span>
			</a>
		</div>
	</section>

	<!-- Browse by department -->
	<section class="browse-dept">
		<h2 class="section-heading">
			<span class="superdot"></span>
			Browse by department
		</h2>
		<div class="dept-chips">
			{DEPARTMENTS.filter((d) => departmentsWithContent.has(d.slug)).map((d) => (
				<a href={`/category/department/${d.slug}/`} class="dept-chip">
					{d.label}
				</a>
			))}
		</div>
	</section>

	<NewsletterForm variant="banner" source="about" />
</Base>

<style>
	.about-header {
		position: relative;
		overflow: hidden;
		padding: var(--space-8) 0 var(--space-2);
	}
	.about-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.about-label .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
	}
	.about-header h1 {
		margin-bottom: var(--space-3);
	}
	.about-subtitle {
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		line-height: var(--leading-snug);
		max-width: 540px;
		margin: 0;
	}

	/* Prose */
	.prose {
		max-width: var(--max-width-prose);
		line-height: var(--leading-relaxed);
	}
	.prose h2 {
		font-family: var(--font-display);
		margin-top: var(--space-10);
		margin-bottom: var(--space-4);
	}
	.prose strong {
		color: var(--color-text-strong);
	}

	/* Approach grid */
	.approach-grid {
		display: grid;
		gap: var(--space-4);
		margin-top: var(--space-4);
	}
	.approach-card {
		padding: var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		transition: border-color var(--transition-fast);
	}
	.approach-card:hover {
		border-color: var(--color-primary);
	}
	.approach-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: var(--radius-md);
		background: var(--sd-red-light);
		color: var(--color-primary);
		margin-bottom: var(--space-3);
	}
	.approach-card h3 {
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
	}
	.approach-card p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
		margin: 0;
	}

	/* Pillars grid */
	.pillars-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-4);
		margin-top: var(--space-4);
	}
	.pillar-card {
		padding: var(--space-5);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-bg);
	}
	.pillar-label {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
		color: var(--color-primary);
		margin-bottom: var(--space-2);
	}
	.pillar-card p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: var(--leading-normal);
		margin: 0;
	}

	/* Section headings */
	.section-heading {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		margin-bottom: var(--space-5);
	}
	.section-heading .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
		flex-shrink: 0;
	}

	/* Featured guides */
	.featured-guides {
		padding: var(--space-10) 0 var(--space-8);
	}
	.guides-row {
		display: grid;
		gap: var(--space-3);
	}
	.guide-link-card {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		transition: all var(--transition-fast);
	}
	.guide-link-card:hover {
		border-color: var(--color-primary);
		transform: translateX(4px);
		text-decoration: none;
	}
	.guide-link-card:hover .guide-link-arrow {
		color: var(--color-primary);
	}
	.guide-link-dept {
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-primary);
		background: var(--sd-red-light);
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		flex-shrink: 0;
	}
	.guide-link-title {
		font-family: var(--font-display);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		flex: 1;
	}
	.guide-link-arrow {
		color: var(--color-text-muted);
		flex-shrink: 0;
		transition: color var(--transition-fast);
	}
	.guide-link-card--all {
		border-style: dashed;
		justify-content: center;
	}
	.guide-link-card--all .guide-link-title {
		flex: none;
		color: var(--color-text-muted);
	}

	/* Browse by department */
	.browse-dept {
		padding: var(--space-2) 0 var(--space-10);
	}
	.dept-chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.dept-chip {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		background: var(--color-bg-dim);
		border: 1px solid var(--color-border);
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-full);
		text-decoration: none;
		transition: all var(--transition-fast);
	}
	.dept-chip:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
		background: var(--sd-red-light);
		text-decoration: none;
	}

	@media (min-width: 640px) {
		.approach-grid {
			grid-template-columns: repeat(3, 1fr);
		}
		.guides-row {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 480px) {
		.pillars-grid {
			grid-template-columns: 1fr;
		}
		.approach-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
