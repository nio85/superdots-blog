---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { TAGS } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tagLookup = new Map(TAGS.map((t) => [t.slug, t]));

	function slugToLabel(s: string): string {
		return s.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
	}

	const allTags = new Set<string>();
	for (const post of posts) {
		for (const tag of post.data.tags ?? []) {
			allTags.add(tag);
		}
	}
	for (const t of TAGS) {
		allTags.add(t.slug);
	}
	return [...allTags].map((slug) => {
		const known = tagLookup.get(slug);
		return {
			params: { tag: slug },
			props: {
				label: known?.label ?? slugToLabel(slug),
				description: known?.description ?? `Articles tagged with ${slugToLabel(slug)}.`,
			},
		};
	});
}

const { tag } = Astro.params;
const { label, description } = Astro.props;

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter(({ data }) => (data.tags ?? []).includes(tag!))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Compute related tags: tags that co-occur on articles with this tag
const coTagCounts = new Map<string, number>();
for (const post of posts) {
	for (const t of post.data.tags ?? []) {
		if (t !== tag) {
			coTagCounts.set(t, (coTagCounts.get(t) || 0) + 1);
		}
	}
}

const tagLookup = new Map(TAGS.map((t) => [t.slug, t]));
function slugToLabel(s: string): string {
	return s.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

const relatedTags = [...coTagCounts.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 8)
	.map(([slug, count]) => ({
		slug,
		label: tagLookup.get(slug)?.label ?? slugToLabel(slug),
		count,
	}));
---

<Base title={`${label} Articles | Superdots`} description={description}>
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span aria-hidden="true">/</span>
		<a href="/tags/">Tags</a>
		<span aria-hidden="true">/</span>
		<span aria-current="page">{label}</span>
	</nav>

	<div class="page-header">
		<div class="dots dots-sm dots-fine" style="top: 0; right: 0;" aria-hidden="true"></div>
		<h1>{label}<span class="dot-accent">.</span></h1>
		<p class="subtitle">{description}</p>
	</div>

	{posts.length === 0 ? (
		<p class="empty">No articles yet. Check back soon.</p>
	) : (
		<div class="post-grid">
			{posts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					department={post.data.department}
					useCase={post.data.useCase}
					slug={post.slug}
					tags={post.data.tags}
					headingLevel="h2"
				/>
			))}
		</div>
	)}

	{relatedTags.length > 0 && (
		<section class="related-section">
			<h2 class="related-heading">Related tags</h2>
			<div class="related-chips">
				{relatedTags.map((t) => (
					<a href={`/tags/${t.slug}/`} class="related-chip">
						<span class="related-chip-label">{t.label}</span>
					</a>
				))}
			</div>
		</section>
	)}

	<NewsletterForm variant="banner" source={`tag-${tag}`} />
</Base>

<style>
	/* Breadcrumb */
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		padding-top: var(--space-4);
	}
	.breadcrumb a {
		color: var(--color-text-muted);
		text-decoration: none;
	}
	.breadcrumb a:hover {
		color: var(--color-primary);
	}
	.breadcrumb span[aria-current] {
		color: var(--color-text-strong);
		font-weight: var(--weight-medium);
	}

	.subtitle {
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}
	.empty {
		color: var(--color-text-muted);
		font-style: italic;
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}

	/* Related tags section */
	.related-section {
		padding: var(--space-8) 0;
		border-top: 1px solid var(--color-border);
		margin-top: var(--space-8);
	}
	.related-heading {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		margin-bottom: var(--space-4);
	}
	.related-chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.related-chip {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		text-decoration: none;
		font-size: var(--text-sm);
		font-family: var(--font-display);
		font-weight: var(--weight-medium);
		color: var(--color-text);
		background: var(--color-bg);
		transition: all var(--transition-fast);
	}
	.related-chip:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
		text-decoration: none;
		background: var(--sd-red-light);
	}

	@media (min-width: 640px) {
		.post-grid { grid-template-columns: repeat(2, 1fr); }
	}
</style>
