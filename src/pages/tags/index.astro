---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { TAGS } from '../../consts';

const posts = await getCollection('blog');
const tagLookup = new Map(TAGS.map((t) => [t.slug, t]));

function slugToLabel(slug: string): string {
	return slug
		.split('-')
		.map((w) => w.charAt(0).toUpperCase() + w.slice(1))
		.join(' ');
}

// Count articles per tag
const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}

// Build tag list with metadata
const allTagSlugs = new Set([...tagCounts.keys(), ...TAGS.map((t) => t.slug)]);
const allTags = [...allTagSlugs]
	.map((slug) => ({
		slug,
		label: tagLookup.get(slug)?.label ?? slugToLabel(slug),
		description: tagLookup.get(slug)?.description ?? '',
		count: tagCounts.get(slug) ?? 0,
	}))
	.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const POPULAR_THRESHOLD = 5;
const popularTags = allTags.filter((t) => t.count >= POPULAR_THRESHOLD);
const otherTags = allTags.filter((t) => t.count < POPULAR_THRESHOLD);

const TAGS_PER_PAGE = 12;
---

<Base title="Tags | Superdots" description="Browse AI guides by topic tag.">
	<meta slot="head" name="robots" content="noindex, follow" />
	<PageHeader
		title="Tags"
		kicker="Topic"
		subtitle="Browse guides by topic — pick a tag to find articles that match your interest."
		breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Tags', href: '/tags/' }]}
	/>

	{/* Popular tags — larger cards with descriptions */}
	{popularTags.length > 0 && (
		<section class="popular-section" aria-label="Popular tags">
			<div class="section-label">
				<span class="superdot"></span>
				Popular Topics
			</div>
			<div class="popular-grid">
				{popularTags.map((t) => (
					<a href={`/tags/${t.slug}/`} class="popular-card">
						<div class="popular-card-header">
							<span class="popular-label">{t.label}</span>
							<span class="popular-count">{t.count}</span>
						</div>
						{t.description && (
							<p class="popular-desc">{t.description}</p>
						)}
						<span class="popular-cta">
							Browse articles <span aria-hidden="true">&rarr;</span>
						</span>
					</a>
				))}
			</div>
		</section>
	)}

	{/* Other tags — compact grid with show more */}
	{otherTags.length > 0 && (
		<section class="other-section" aria-label="More tags">
			<div class="section-label section-label--muted">
				More Topics
			</div>
			<div class="tag-grid" id="other-tags-grid">
				{otherTags.map((t, i) => (
					<a href={`/tags/${t.slug}/`} class="tag-card" data-tag-index={i} style={i >= TAGS_PER_PAGE ? 'display:none' : ''}>
						<span class="tag-label">{t.label}</span>
						<span class="tag-count">{t.count} {t.count === 1 ? 'article' : 'articles'}</span>
					</a>
				))}
			</div>
			{otherTags.length > TAGS_PER_PAGE && (
				<div class="load-more-wrap" id="load-more-wrap">
					<button class="btn-load-more" id="load-more-tags" type="button">
						Show more topics
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
					</button>
					<p class="showing-count" id="showing-count" aria-live="polite"></p>
				</div>
			)}
		</section>
	)}

	<NewsletterForm variant="banner" source="tags-listing" />
</Base>

<script define:vars={{ TAGS_PER_PAGE }}>
	const grid = document.getElementById('other-tags-grid');
	const items = grid ? Array.from(grid.querySelectorAll('.tag-card')) : [];
	const loadMoreBtn = document.getElementById('load-more-tags');
	const showingCount = document.getElementById('showing-count');
	const total = items.length;

	let visibleCount = TAGS_PER_PAGE;

	function render() {
		items.forEach((el, i) => {
			if (i < visibleCount) {
				el.style.display = '';
				el.style.opacity = '0';
				el.style.transform = 'translateY(12px)';
				requestAnimationFrame(() => {
					requestAnimationFrame(() => {
						el.style.opacity = '1';
						el.style.transform = 'translateY(0)';
					});
				});
			} else {
				el.style.display = 'none';
			}
		});

		if (loadMoreBtn) {
			loadMoreBtn.style.display = visibleCount >= total ? 'none' : '';
		}
		if (showingCount) {
			const shown = Math.min(visibleCount, total);
			showingCount.textContent = `Showing ${shown} of ${total} topics`;
		}
	}

	if (loadMoreBtn) {
		loadMoreBtn.addEventListener('click', () => {
			visibleCount += TAGS_PER_PAGE;
			render();
		});
	}

	if (total > TAGS_PER_PAGE) {
		render();
	}
</script>

<style>
	/* Section labels */
	.section-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.section-label .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
	}
	.section-label--muted {
		color: var(--color-text-muted);
	}

	/* Popular tags — large cards */
	.popular-section {
		margin-bottom: var(--space-8);
	}
	.popular-grid {
		display: grid;
		gap: var(--space-4);
	}
	@media (min-width: 640px) {
		.popular-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 960px) {
		.popular-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.popular-card {
		display: flex;
		flex-direction: column;
		padding: var(--space-5) var(--space-6);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		text-decoration: none;
		transition: all var(--transition-base);
		position: relative;
		overflow: hidden;
	}
	.popular-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 4px;
		height: 0;
		background: var(--color-primary);
		border-radius: var(--radius-lg) 0 0 var(--radius-lg);
		transition: height 350ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.popular-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: var(--color-primary);
		text-decoration: none;
	}
	.popular-card:hover::before {
		height: 100%;
	}
	.popular-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-2);
	}
	.popular-label {
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		font-size: var(--text-lg);
		color: var(--color-text-strong);
		transition: color var(--transition-fast);
	}
	.popular-card:hover .popular-label {
		color: var(--color-primary);
	}
	.popular-count {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-primary);
		line-height: 1;
		opacity: 0.25;
	}
	.popular-desc {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: var(--leading-snug);
		margin: 0 0 var(--space-3);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.popular-cta {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		margin-top: auto;
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		transition: gap var(--transition-fast);
	}
	.popular-card:hover .popular-cta {
		gap: var(--space-2);
	}

	/* Load more */
	.load-more-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-6) 0 var(--space-4);
	}
	.btn-load-more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-6);
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		background: transparent;
		border: 2px solid var(--color-primary);
		border-radius: var(--radius-full);
		cursor: pointer;
		transition: all var(--transition-base);
	}
	.btn-load-more:hover {
		background: var(--color-primary);
		color: #fff;
		transform: translateY(-1px);
		box-shadow: var(--shadow-md);
	}
	.btn-load-more svg {
		transition: transform var(--transition-base);
	}
	.btn-load-more:hover svg {
		transform: translateY(2px);
	}
	.showing-count {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0;
	}

	/* Other tags — compact grid */
	.other-section {
		margin-bottom: var(--space-6);
	}
	.tag-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: var(--space-3);
	}
	.tag-card {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-4) var(--space-5);
		border-radius: var(--radius-lg);
		background: var(--color-bg-dim);
		border: 1px solid var(--color-border);
		text-decoration: none;
		transition: all var(--transition-base), opacity var(--transition-slow), transform var(--transition-slow);
	}
	.tag-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		border-color: var(--color-primary);
		text-decoration: none;
	}
	.tag-label {
		font-family: var(--font-display);
		font-weight: var(--weight-semibold);
		font-size: var(--text-base);
		color: var(--color-text-strong);
	}
	.tag-count {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}
</style>
