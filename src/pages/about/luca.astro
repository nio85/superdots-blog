---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { authors } from '../../data/authors';

const authorData = authors["Luca Bartoccini"];
const allPosts = await getCollection('blog');
const lucaPosts = allPosts
	.filter((p) => p.data.author === "Luca Bartoccini")
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 10);
---

<Base title="Luca Bartoccini | Superdots" description="Founder of Superdots. Runs a team of 9 AI agents from his homelab to publish practical AI guides.">
	<PageHeader
		title="Luca Bartoccini"
		kicker="Founder"
		subtitle="I run a team of 9 AI agents from my homelab. This is where I write about what actually works — and what doesn't."
		breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: 'Luca', href: '/about/luca/' }]}
	/>

	<div class="author-page">
		<section class="author-intro prose">
			<p>
				I'm Luca Bartoccini, founder of Superdots. I built an AI agent team — 9 agents
				running on Paperclip from a homelab in Italy — that researches, writes, edits, and
				publishes content about AI and work.
			</p>
			<p>
				The guides on this site are AI-assisted and human-edited. My opinion pieces and
				field reports are written by me, based on real operational data from running this system.
			</p>
			<p>
				I started Superdots because I wanted to see if a small team of AI agents could produce
				content that's genuinely useful — not the clickbait "10x your productivity" stuff,
				but practical guides for people who use a computer at work and want to use AI without the hype.
			</p>

			<h2>The setup</h2>
			<p>
				9 AI agents, each with a defined role: CEO, Content Manager, SEO Expert, Copywriter,
				Growth Analyst, Frontend Designer, Founding Engineer, Legal Expert, and Program Manager.
				They run heartbeats every hour, coordinate via Paperclip, and produce content through
				structured pipelines with human review gates.
			</p>
			<p>
				Everything runs on a single Ubuntu VM on Proxmox — 8GB RAM, 4 CPUs. No cloud. No
				enterprise tools. Just a homelab, some Docker containers, and a lot of configuration.
			</p>

			<h2>What I write about</h2>
			<p>
				My articles are clearly different from the team's guides. I write about running AI agents
				operationally — the failures, the costs, the unexpected behaviors, and the lessons.
				Things you won't find by searching Google because nobody else is doing this transparently.
			</p>
		</section>

		{lucaPosts.length > 0 && (
			<section class="author-articles">
				<h2>Articles by Luca</h2>
				<ul class="author-article-list">
					{lucaPosts.map((post) => (
						<li>
							<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
							<FormattedDate date={post.data.pubDate} />
						</li>
					))}
				</ul>
			</section>
		)}

		<NewsletterForm variant="banner" source="author-page" />
	</div>
</Base>

<style>
	.author-page {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		padding: 0 var(--space-4);
	}
	.author-intro {
		margin-bottom: var(--space-10);
	}
	.author-articles h2 {
		font-family: var(--font-display);
		margin-bottom: var(--space-4);
	}
	.author-article-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.author-article-list li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-3);
		padding: var(--space-3) 0;
		border-bottom: 1px solid var(--color-border);
	}
	.author-article-list a {
		font-weight: var(--weight-medium);
		color: var(--color-text);
		text-decoration: none;
	}
	.author-article-list a:hover {
		color: var(--sd-red);
	}
	.author-article-list :global(time) {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		white-space: nowrap;
	}
</style>
