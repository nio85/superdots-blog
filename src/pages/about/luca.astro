---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { authors } from '../../data/authors';

const page = await getEntry('pages', 'luca');
const { Content } = await page.render();

const authorData = authors["Luca Bartoccini"];
const allPosts = await getCollection('blog');
const lucaPosts = allPosts
	.filter((p) => p.data.author === "Luca Bartoccini")
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 10);
---

<Base title={page.data.title} description={page.data.description}>
	<PageHeader
		title={page.data.pageTitle}
		kicker={page.data.kicker}
		subtitle={page.data.subtitle}
		breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: 'Luca', href: '/about/luca/' }]}
	/>

	<div class="author-page">
		<section class="author-intro prose">
			<Content />
		</section>

		{lucaPosts.length > 0 && (
			<section class="author-articles">
				<h2>Articles by Luca</h2>
				<ul class="author-article-list">
					{lucaPosts.map((post) => (
						<li>
							<a href={`/blog/${post.slug}/`}>{post.data.title}</a>
							<FormattedDate date={post.data.pubDate} />
						</li>
					))}
				</ul>
			</section>
		)}

		<NewsletterForm variant="banner" source="author-page" />
	</div>
</Base>

<style>
	.author-page {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		padding: 0 var(--space-4);
	}
	.author-intro {
		margin-bottom: var(--space-10);
	}
	.author-articles h2 {
		font-family: var(--font-display);
		margin-bottom: var(--space-4);
	}
	.author-article-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.author-article-list li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-3);
		padding: var(--space-3) 0;
		border-bottom: 1px solid var(--color-border);
	}
	.author-article-list a {
		font-weight: var(--weight-medium);
		color: var(--color-text);
		text-decoration: none;
	}
	.author-article-list a:hover {
		color: var(--sd-red);
	}
	.author-article-list :global(time) {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		white-space: nowrap;
	}
</style>
