---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import { USE_CASES, DEPARTMENTS } from '../../../consts';

export function getStaticPaths() {
	return USE_CASES.map((u) => ({
		params: { useCase: u.slug },
		props: { label: u.label, description: u.description },
	}));
}

const { useCase } = Astro.params;
const { label, description } = Astro.props;

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter(({ data }) => data.useCase === useCase)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Separate pillar (guide) articles
const pillarPosts = posts.filter(({ data }) => data.pillar);
const regularPosts = posts.filter(({ data }) => !data.pillar);

// Compute related departments for this use case
const deptCounts = new Map<string, number>();
for (const post of posts) {
	const d = post.data.department;
	if (d) deptCounts.set(d, (deptCounts.get(d) || 0) + 1);
}
const relatedDepts = DEPARTMENTS
	.filter((d) => deptCounts.has(d.slug))
	.map((d) => ({ ...d, count: deptCounts.get(d.slug)! }))
	.sort((a, b) => b.count - a.count);
---

<Base title={`${label} AI Guides | Superdots`} description={description}>
	<meta slot="head" name="robots" content="noindex, follow" />
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span aria-hidden="true">/</span>
		<a href="/category/">Categories</a>
		<span aria-hidden="true">/</span>
		<span aria-current="page">{label}</span>
	</nav>

	<div class="page-header">
		<div class="dots dots-sm dots-fine" style="top: 0; right: 0;" aria-hidden="true"></div>
		<h1>{label}<span class="dot-accent">.</span> <span class="article-count">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</span></h1>
		<p class="subtitle">{description}</p>
	</div>

	{pillarPosts.length > 0 && (
		<section class="featured-section">
			<div class="section-label">
				<span class="superdot"></span>
				{pillarPosts.length === 1 ? 'Featured Guide' : 'Featured Guides'}
			</div>
			<div class="featured-grid">
				{pillarPosts.map((post) => (
					<a href={`/blog/${post.slug}/`} class="featured-card">
						<div class="featured-badge">Guide</div>
						<h2 class="featured-title">{post.data.title}</h2>
						<p class="featured-desc">{post.data.description}</p>
						<span class="featured-cta">Read guide <span aria-hidden="true">&rarr;</span></span>
					</a>
				))}
			</div>
		</section>
	)}

	{posts.length === 0 ? (
		<p class="empty">No articles yet. Check back soon.</p>
	) : (
		<>
			{pillarPosts.length > 0 && regularPosts.length > 0 && (
				<div class="section-label section-label--muted">
					All Articles
				</div>
			)}
			<div class="post-grid">
				{(pillarPosts.length > 0 ? regularPosts : posts).map((post) => (
					<PostCard
						title={post.data.title}
						description={post.data.description}
						pubDate={post.data.pubDate}
						department={post.data.department}
						useCase={post.data.useCase}
						slug={post.slug}
						tags={post.data.tags}
						headingLevel="h2"
					/>
				))}
			</div>
		</>
	)}

	{relatedDepts.length > 0 && (
		<section class="related-section">
			<h2 class="related-heading">Related departments</h2>
			<div class="related-chips">
				{relatedDepts.map((d) => (
					<a href={`/category/department/${d.slug}/`} class="related-chip">
						<span class="related-chip-label">{d.label}</span>
						<span class="related-chip-count">{d.count}</span>
					</a>
				))}
			</div>
		</section>
	)}

	<NewsletterForm variant="banner" source={`usecase-${useCase}`} />
</Base>

<style>
	/* Breadcrumb */
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		padding-top: var(--space-4);
	}
	.breadcrumb a {
		color: var(--color-text-muted);
		text-decoration: none;
	}
	.breadcrumb a:hover {
		color: var(--color-primary);
	}
	.breadcrumb span[aria-current] {
		color: var(--color-text-strong);
		font-weight: var(--weight-medium);
	}

	.article-count {
		display: inline-block;
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-muted);
		background: var(--color-bg-dim);
		border: 1px solid var(--color-border);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-full);
		vertical-align: middle;
		letter-spacing: 0;
	}
	.subtitle {
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}
	.empty {
		color: var(--color-text-muted);
		font-style: italic;
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}

	/* Section labels */
	.section-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.section-label .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
	}
	.section-label--muted {
		color: var(--color-text-muted);
		margin-bottom: var(--space-4);
	}

	/* Featured guides */
	.featured-section {
		margin-bottom: var(--space-8);
	}
	.featured-grid {
		display: grid;
		gap: var(--space-4);
	}
	@media (min-width: 640px) {
		.featured-grid {
			grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		}
	}
	.featured-card {
		display: flex;
		flex-direction: column;
		padding: var(--space-6);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		border: 2px solid var(--color-primary);
		text-decoration: none;
		transition: all var(--transition-base);
	}
	.featured-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		text-decoration: none;
	}
	.featured-badge {
		display: inline-block;
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #fff;
		background: var(--color-primary);
		padding: var(--space-1) var(--space-3);
		border-radius: var(--radius-full);
		margin-bottom: var(--space-3);
		align-self: flex-start;
	}
	.featured-title {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
		line-height: var(--leading-tight);
	}
	.featured-desc {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: var(--leading-snug);
		margin: 0 0 var(--space-4);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.featured-cta {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		margin-top: auto;
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		transition: gap var(--transition-fast);
	}
	.featured-card:hover .featured-cta {
		gap: var(--space-2);
	}

	/* Related departments section */
	.related-section {
		padding: var(--space-8) 0;
		border-top: 1px solid var(--color-border);
		margin-top: var(--space-8);
	}
	.related-heading {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		margin-bottom: var(--space-4);
	}
	.related-chips {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
	.related-chip {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		font-family: var(--font-display);
		font-weight: var(--weight-medium);
		color: var(--color-text-strong);
		background: var(--color-bg);
		transition: all var(--transition-fast);
	}
	.related-chip:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: var(--shadow-sm);
	}
	.related-chip-count {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		background: var(--color-bg-dim);
		padding: var(--space-0-5) var(--space-2);
		border-radius: var(--radius-full);
	}

	@media (min-width: 640px) {
		.post-grid { grid-template-columns: repeat(2, 1fr); }
	}
</style>
