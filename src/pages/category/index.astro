---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { DEPARTMENTS, USE_CASES, TAGS } from '../../consts';

const posts = await getCollection('blog');

// Count articles per department
const deptCounts = new Map<string, number>();
for (const post of posts) {
	const d = post.data.department;
	if (d) deptCounts.set(d, (deptCounts.get(d) ?? 0) + 1);
}

// Count articles per use case
const ucCounts = new Map<string, number>();
for (const post of posts) {
	const u = post.data.useCase;
	if (u) ucCounts.set(u, (ucCounts.get(u) ?? 0) + 1);
}

// Count articles per tag — only show tags with articles
const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
const tagsWithContent = TAGS.filter((t) => (tagCounts.get(t.slug) ?? 0) > 0);

const TAGS_PER_PAGE = 12;
---

<Base title="Categories | Superdots" description="Browse AI guides by department or use case.">
	<meta slot="head" name="robots" content="noindex, follow" />
	<PageHeader
		title="Categories"
		kicker="Browse topics"
		subtitle="Browse guides by the team you're on or the problem you're solving. Pick a department or use case to find what's relevant to your work."
		breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Categories', href: '/category/' }]}
	/>

	<section class="cat-section">
		<div class="cat-section-label">
			<span class="superdot"></span>
			By department
		</div>
		<div class="cat-grid cat-grid--dept">
			{DEPARTMENTS.map((d) => {
				const count = deptCounts.get(d.slug) ?? 0;
				return (
					<a href={`/category/department/${d.slug}/`} class="cat-card cat-card--dept">
						<span class="cat-card-count">{count}</span>
						<span class="cat-card-label">{d.label}</span>
						{'description' in d && d.description && (
							<span class="cat-card-desc">{d.description}</span>
						)}
						<span class="cat-card-cta">
							Browse <span aria-hidden="true">&rarr;</span>
						</span>
					</a>
				);
			})}
		</div>
	</section>

	<section class="cat-section">
		<div class="cat-section-label cat-section-label--teal">
			<span class="superdot superdot--teal"></span>
			By use case
		</div>
		<div class="cat-grid cat-grid--uc">
			{USE_CASES.map((u) => {
				const count = ucCounts.get(u.slug) ?? 0;
				return (
					<a href={`/category/use-case/${u.slug}/`} class="cat-card cat-card--uc">
						<span class="cat-card-count">{count}</span>
						<span class="cat-card-label">{u.label}</span>
						{'description' in u && u.description && (
							<span class="cat-card-desc">{u.description}</span>
						)}
						<span class="cat-card-cta">
							Browse <span aria-hidden="true">&rarr;</span>
						</span>
					</a>
				);
			})}
		</div>
	</section>

	<section class="cat-section">
		<div class="cat-section-label cat-section-label--muted">
			By topic tag
		</div>
		<div class="cat-grid cat-grid--tags" id="tags-grid">
			{tagsWithContent.map((t, i) => (
				<a href={`/tags/${t.slug}/`} class="cat-chip" data-tag-index={i} style={i >= TAGS_PER_PAGE ? 'display:none' : ''}>
					{t.label}
					<span class="cat-chip-count">{tagCounts.get(t.slug)}</span>
				</a>
			))}
		</div>
		{tagsWithContent.length > TAGS_PER_PAGE && (
			<div class="load-more-wrap" id="tags-load-more-wrap">
				<button class="btn-load-more" id="load-more-tags" type="button">
					Show more tags
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
				</button>
				<p class="showing-count" id="tags-showing-count" aria-live="polite"></p>
			</div>
		)}
	</section>

	<NewsletterForm variant="banner" source="category-hub" />
</Base>

<script define:vars={{ TAGS_PER_PAGE }}>
	const grid = document.getElementById('tags-grid');
	const items = grid ? Array.from(grid.querySelectorAll('.cat-chip')) : [];
	const loadMoreBtn = document.getElementById('load-more-tags');
	const showingCount = document.getElementById('tags-showing-count');
	const total = items.length;

	let visibleCount = TAGS_PER_PAGE;

	function render() {
		items.forEach((el, i) => {
			if (i < visibleCount) {
				el.style.display = '';
				el.style.opacity = '0';
				el.style.transform = 'translateY(8px)';
				requestAnimationFrame(() => {
					requestAnimationFrame(() => {
						el.style.opacity = '1';
						el.style.transform = 'translateY(0)';
					});
				});
			} else {
				el.style.display = 'none';
			}
		});

		if (loadMoreBtn) {
			loadMoreBtn.style.display = visibleCount >= total ? 'none' : '';
		}
		if (showingCount) {
			const shown = Math.min(visibleCount, total);
			showingCount.textContent = `Showing ${shown} of ${total} tags`;
		}
	}

	if (loadMoreBtn) {
		loadMoreBtn.addEventListener('click', () => {
			visibleCount += TAGS_PER_PAGE;
			render();
		});
	}

	if (total > TAGS_PER_PAGE) {
		render();
	}
</script>

<style>
	/* Sections */
	.cat-section {
		margin-bottom: var(--space-10);
	}
	.cat-section-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.cat-section-label .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
	}
	.cat-section-label .superdot--teal {
		background: var(--color-secondary);
	}
	.cat-section-label--teal {
		color: var(--color-secondary);
	}
	.cat-section-label--muted {
		color: var(--color-text-muted);
	}

	/* Card grid */
	.cat-grid {
		display: grid;
		gap: var(--space-4);
	}
	.cat-grid--dept,
	.cat-grid--uc {
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
	}

	/* WOW category cards */
	.cat-card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: var(--space-5) var(--space-6);
		border-radius: var(--radius-lg);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		text-decoration: none;
		transition: all var(--transition-base);
		overflow: hidden;
		min-height: 110px;
	}
	/* Growing left border accent */
	.cat-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 4px;
		height: 0;
		border-radius: var(--radius-lg) 0 0 var(--radius-lg);
		transition: height 350ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.cat-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		text-decoration: none;
	}
	.cat-card:hover::before {
		height: 100%;
	}

	/* Department accent */
	.cat-card--dept::before {
		background: var(--color-primary);
	}
	.cat-card--dept:hover {
		border-color: var(--color-primary);
	}

	/* Use case accent */
	.cat-card--uc::before {
		background: var(--color-secondary);
	}
	.cat-card--uc:hover {
		border-color: var(--color-secondary);
	}

	/* Large count badge — top right */
	.cat-card-count {
		position: absolute;
		top: var(--space-3);
		right: var(--space-4);
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		line-height: 1;
		opacity: 0.18;
		transition: opacity var(--transition-base);
	}
	.cat-card--dept .cat-card-count {
		color: var(--color-primary);
	}
	.cat-card--uc .cat-card-count {
		color: var(--color-secondary);
	}
	.cat-card:hover .cat-card-count {
		opacity: 0.35;
	}

	/* Card label */
	.cat-card-label {
		font-family: var(--font-display);
		font-weight: var(--weight-bold);
		font-size: var(--text-lg);
		color: var(--color-text-strong);
		margin-bottom: auto;
		padding-right: var(--space-8);
		transition: color var(--transition-fast);
	}
	.cat-card--dept:hover .cat-card-label {
		color: var(--color-primary);
	}
	.cat-card--uc:hover .cat-card-label {
		color: var(--color-secondary);
	}

	/* Card description */
	.cat-card-desc {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: var(--leading-snug);
		margin-bottom: var(--space-2);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Browse CTA */
	.cat-card-cta {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		margin-top: var(--space-3);
		transition: gap var(--transition-fast), color var(--transition-fast);
	}
	.cat-card--dept .cat-card-cta {
		color: var(--color-primary);
	}
	.cat-card--uc .cat-card-cta {
		color: var(--color-secondary);
	}
	.cat-card:hover .cat-card-cta {
		gap: var(--space-2);
	}

	/* Load more */
	.load-more-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-6) 0 var(--space-4);
	}
	.btn-load-more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-3) var(--space-6);
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		background: transparent;
		border: 2px solid var(--color-primary);
		border-radius: var(--radius-full);
		cursor: pointer;
		transition: all var(--transition-base);
	}
	.btn-load-more:hover {
		background: var(--color-primary);
		color: #fff;
		transform: translateY(-1px);
		box-shadow: var(--shadow-md);
	}
	.btn-load-more svg {
		transition: transform var(--transition-base);
	}
	.btn-load-more:hover svg {
		transform: translateY(2px);
	}
	.showing-count {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin: 0;
	}

	/* Topic tag chips — compact row */
	.cat-grid--tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.cat-chip {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-4);
		font-family: var(--font-display);
		font-weight: var(--weight-medium);
		font-size: var(--text-sm);
		color: var(--color-text);
		background: var(--color-bg-dim);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		text-decoration: none;
		transition: all var(--transition-fast), opacity var(--transition-slow), transform var(--transition-slow);
		white-space: nowrap;
	}
	.cat-chip:hover {
		border-color: var(--color-text-strong);
		color: var(--color-text-strong);
		background: var(--color-bg);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
	}
	.cat-chip-count {
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		background: rgba(0, 0, 0, 0.08);
		color: var(--color-text-muted);
		min-width: 20px;
		height: 20px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-full);
		padding: 0 var(--space-1);
		line-height: 1;
	}
	:global([data-theme="dark"]) .cat-chip-count {
		background: rgba(255, 255, 255, 0.1);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .cat-chip-count {
			background: rgba(255, 255, 255, 0.1);
		}
	}

	/* Responsive */
	@media (max-width: 480px) {
		.cat-grid--dept,
		.cat-grid--uc {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-3);
		}
		.cat-card {
			padding: var(--space-4);
			min-height: 90px;
		}
		.cat-card-label {
			font-size: var(--text-base);
		}
		.cat-card-count {
			font-size: var(--text-xl);
		}
	}
</style>
