---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { DEPARTMENTS, USE_CASES, TAGS } from '../../consts';

const posts = await getCollection('blog');

// Count articles per department
const deptCounts = new Map<string, number>();
for (const post of posts) {
	const d = post.data.department;
	if (d) deptCounts.set(d, (deptCounts.get(d) ?? 0) + 1);
}

// Count articles per use case
const ucCounts = new Map<string, number>();
for (const post of posts) {
	const u = post.data.useCase;
	if (u) ucCounts.set(u, (ucCounts.get(u) ?? 0) + 1);
}

// Count articles per tag
const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
	}
}
---

<Base title="Categories | Superdots" description="Browse AI guides by department or use case.">
	<nav class="breadcrumb" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span aria-hidden="true">/</span>
		<span aria-current="page">Categories</span>
	</nav>

	<div class="page-header">
		<div class="dots dots-md" style="top: -15%; right: 0;" aria-hidden="true"></div>
		<h1>Categories<span class="dot-accent">.</span></h1>
		<p class="page-desc">Browse guides by the team you're on or the problem you're solving. Pick a department or use case to find what's relevant to your work.</p>
	</div>

	<section class="category-section">
		<h2>By department</h2>
		<div class="tag-grid">
			{DEPARTMENTS.map((d) => (
				<a href={`/category/department/${d.slug}/`} class="tag-card tag-dept">
					{d.label}
					{(deptCounts.get(d.slug) ?? 0) > 0 && (
						<span class="cat-count">{deptCounts.get(d.slug)}</span>
					)}
				</a>
			))}
		</div>
	</section>

	<section class="category-section">
		<h2>By use case</h2>
		<div class="tag-grid">
			{USE_CASES.map((u) => (
				<a href={`/category/use-case/${u.slug}/`} class="tag-card tag-usecase">
					{u.label}
					{(ucCounts.get(u.slug) ?? 0) > 0 && (
						<span class="cat-count">{ucCounts.get(u.slug)}</span>
					)}
				</a>
			))}
		</div>
	</section>

	<section class="category-section">
		<h2>By topic tag</h2>
		<div class="tag-grid">
			{TAGS.map((t) => (
				<a href={`/tags/${t.slug}/`} class="tag-card tag-topic">
					{t.label}
					{(tagCounts.get(t.slug) ?? 0) > 0 && (
						<span class="cat-count">{tagCounts.get(t.slug)}</span>
					)}
				</a>
			))}
		</div>
	</section>
	<NewsletterForm variant="banner" source="category-hub" />
</Base>

<style>
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		padding-top: var(--space-4);
	}
	.breadcrumb a {
		color: var(--color-text-muted);
		text-decoration: none;
	}
	.breadcrumb a:hover {
		color: var(--color-primary);
	}
	.breadcrumb span[aria-current] {
		color: var(--color-text-strong);
		font-weight: var(--weight-medium);
	}
	.page-desc {
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		margin-bottom: var(--space-6);
		line-height: var(--leading-snug);
	}
	.category-section {
		margin-bottom: var(--space-10);
	}
	.category-section h2 {
		font-family: var(--font-display);
		margin-bottom: var(--space-4);
	}
	.tag-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: var(--space-3);
	}
	.tag-card {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		padding: var(--space-4) var(--space-5);
		border-radius: var(--radius-lg);
		font-family: var(--font-display);
		font-weight: var(--weight-semibold);
		font-size: var(--text-base);
		text-decoration: none;
		text-align: center;
		transition: all var(--transition-base);
	}
	.tag-card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		text-decoration: none;
	}
	.tag-dept {
		background: var(--sd-red-light);
		color: var(--sd-red-dark);
	}
	.tag-dept:hover {
		background: var(--sd-red);
		color: #FFFFFF;
	}
	.tag-usecase {
		background: var(--sd-teal-light);
		color: var(--sd-teal-dark);
	}
	.tag-usecase:hover {
		background: var(--sd-teal);
		color: #FFFFFF;
	}
	.tag-topic {
		background: var(--color-bg-dim);
		color: var(--color-text);
		border: 1px solid var(--color-border);
	}
	.tag-topic:hover {
		background: var(--color-text-strong);
		color: var(--color-bg);
		border-color: var(--color-text-strong);
	}
	.cat-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 22px;
		height: 22px;
		font-size: var(--text-xs);
		font-weight: var(--weight-bold);
		border-radius: var(--radius-full);
		background: rgba(0, 0, 0, 0.1);
		padding: 0 var(--space-1);
		line-height: 1;
	}
	.tag-dept:hover .cat-count,
	.tag-usecase:hover .cat-count {
		background: rgba(255, 255, 255, 0.25);
	}
	.tag-topic:hover .cat-count {
		background: rgba(255, 255, 255, 0.2);
	}
</style>
