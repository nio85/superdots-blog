---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { DEPARTMENTS } from '../../../consts';

export function getStaticPaths() {
	return DEPARTMENTS.map((d) => ({
		params: { department: d.slug },
		props: { label: d.label },
	}));
}

const { department } = Astro.params;
const { label } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => data.department === department))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`${label} | Superdots`} description={`AI guides for ${label} teams.`}>
	<h1>{label}</h1>
	<p class="subtitle">AI guides for {label.toLowerCase()} teams</p>

	{posts.length === 0 ? (
		<p class="empty">No articles yet. Check back soon.</p>
	) : (
		<div class="post-grid">
			{posts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					department={post.data.department}
					useCase={post.data.useCase}
					slug={post.slug}
				/>
			))}
		</div>
	)}

	<a href="/category" class="back">&larr; All categories</a>
</Base>

<style>
	.subtitle {
		color: var(--text-light);
		margin-top: -0.25rem;
		margin-bottom: 1.5rem;
	}
	.empty {
		color: var(--text-light);
		font-style: italic;
	}
	.post-grid {
		display: grid;
		gap: 1.25rem;
	}
	@media (min-width: 640px) {
		.post-grid { grid-template-columns: repeat(2, 1fr); }
	}
	.back {
		display: inline-block;
		margin-top: 2rem;
		font-size: 0.9rem;
	}
</style>
