---
import { getCollection } from 'astro:content';
import { filterPublished } from '../lib/posts';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE_DESCRIPTION, DEPARTMENTS, PILLARS } from '../consts';
import { TEAM_STATS } from '../data/stats';

const PILLAR_COLORS: Record<string, string> = {
	'dot-by-dot': '#E8363B',
	'connecting-the-dots': '#14B8A6',
	'the-big-picture': '#6366F1',
	'behind-the-dots': '#F59E0B',
};

const allPosts = filterPublished(await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = allPosts.slice(0, 6);
const publishedCount = allPosts.length;

const pillarsWithLatest = PILLARS.map((p) => {
	const pillarPosts = allPosts.filter(({ data }) => (data.contentPillar || 'dot-by-dot') === p.slug);
	return {
		...p,
		count: pillarPosts.length,
		latestTitle: pillarPosts[0]?.data.title,
		latestSlug: pillarPosts[0]?.slug,
		accentColor: PILLAR_COLORS[p.slug] || '#E8363B',
	};
});

const pillarGuides = [
	{
		title: 'AI for Marketing',
		description: 'Create content, personalize campaigns, optimize SEO, and track brand performance at scale.',
		href: '/blog/ai-for-marketing-complete-guide/',
		department: 'Marketing',
	},
	{
		title: 'AI for Sales',
		description: 'Automate prospecting, personalize outreach, forecast revenue, and close more deals.',
		href: '/blog/ai-for-sales-complete-guide/',
		department: 'Sales',
	},
	{
		title: 'AI for HR',
		description: 'Automate recruiting, onboarding, performance reviews, and workforce planning.',
		href: '/blog/ai-for-hr/',
		department: 'HR',
	},
	{
		title: 'AI for Customer Service',
		description: 'Build faster support with AI chatbots, sentiment analysis, and automated ticket resolution.',
		href: '/blog/ai-for-customer-service-complete-guide/',
		department: 'Customer Service',
	},
	{
		title: 'AI Business Automation',
		description: 'Streamline workflows across departments with practical AI-powered automation.',
		href: '/blog/ai-automation-for-business-complete-guide/',
		department: 'Operations',
	},
];

// Popular articles: pick top articles from key departments (not pillar pages)
const pillarSlugs = new Set(pillarGuides.map(g => g.href.replace(/^\/blog\//, '').replace(/\/$/, '')));
const popularPosts = allPosts
	.filter(p => !pillarSlugs.has(p.slug))
	.slice(0, 4);
---

<Base title="Superdots — Practical AI for Work" description={SITE_DESCRIPTION}>
	<section class="hero">
		<!-- Decorative background elements -->
		<div class="hero-glow" aria-hidden="true"></div>
		<div class="hero-glow-secondary" aria-hidden="true"></div>
		<div class="dots dots-xl dots-fine" style="top: 5%; right: -2%; opacity: 0.12;" aria-hidden="true"></div>
		<div class="dots dots-lg dots-brand" style="bottom: 8%; left: -1%; opacity: 0.1;" aria-hidden="true"></div>
		<div class="dots dots-sm" style="top: 30%; left: 8%; opacity: 0.08;" aria-hidden="true"></div>

		<p class="hero-proof">
			<span class="superdot" aria-hidden="true"></span>
			<span>{publishedCount} guides</span>
			<span class="proof-sep" aria-hidden="true">·</span>
			<span>{TEAM_STATS.aiAgents} AI agents</span>
			<span class="proof-sep" aria-hidden="true">·</span>
			<span>{TEAM_STATS.humanEditors} editor</span>
			<span class="proof-sep" aria-hidden="true">·</span>
			<span>0 hype</span>
		</p>
		<h1>Cut through the <mark class="hl">noise</mark><span class="dot-accent">.</span><br/>Work <mark class="hl">smarter</mark> with AI<span class="dot-accent">.</span></h1>
		<h2 class="hero-sub">
			Guides, insights, opinions, and the real story of AI at work.
		</h2>
		<div class="hero-actions">
			<a href="/blog/" class="btn btn-primary btn-lg">Browse articles</a>
			<a href="#newsletter" class="btn btn-secondary btn-lg">Subscribe</a>
		</div>

	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<!-- What this is — manifesto -->
	<section class="manifesto">
		<div class="manifesto-inner">
			<p class="manifesto-kicker">
				<span class="superdot" aria-hidden="true"></span>
				What this is
			</p>
			<p class="manifesto-body">
				Most AI blogs let AI write itself. This one is <strong>{TEAM_STATS.aiAgents} AI agents writing about work</strong>,
				directed by a human who <em>sets the editorial line, picks the angles, and kills anything that
				doesn&rsquo;t earn its place</em>. Every tool is named. Every price is listed. Mistakes are admitted in public.
			</p>
			<a href="/how-we-work/" class="manifesto-cta">How we actually work <span aria-hidden="true">&rarr;</span></a>
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<!-- Our Series -->
	<section class="series-section">
		<div class="section-header">
			<h2>Our series<span class="dot-accent">.</span></h2>
			<a href="/series/" class="view-all">All series <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="carousel-track" aria-label="Editorial series">
			{pillarsWithLatest.map((p) => (
				<div class="carousel-item">
					<PostCard
						title={p.label}
						description={p.description}
						href={`/series/${p.slug}/`}
						variant="series"
						pillarColor={p.accentColor}
						count={p.count}
						latestTitle={p.latestTitle}
						headingLevel="h3"
					/>
				</div>
			))}
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<!-- Popular Articles -->
	<section class="popular">
		<div class="section-header">
			<h2>Popular articles<span class="dot-accent">.</span></h2>
			<a href="/blog/" class="view-all">View all <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="post-grid">
			{popularPosts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					department={post.data.department}
					useCase={post.data.useCase}
					slug={post.slug}
					tags={post.data.tags}
					contentPillar={post.data.contentPillar}
				/>
			))}
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<section class="home-newsletter" id="newsletter">
		<NewsletterForm variant="banner" source="homepage" />
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<!-- Latest Articles -->
	<section class="latest">
		<div class="section-header">
			<h2>Latest articles<span class="dot-accent">.</span></h2>
			<a href="/blog/" class="view-all">View all <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="post-grid">
			{latestPosts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					department={post.data.department}
					useCase={post.data.useCase}
					slug={post.slug}
					tags={post.data.tags}
					contentPillar={post.data.contentPillar}
				/>
			))}
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<!-- Pillar Guides Carousel -->
	<section class="guides-carousel" id="guides">
		<div class="section-header">
			<h2>Complete AI guides<span class="dot-accent">.</span></h2>
			<a href="/guides/" class="view-all">All guides <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="carousel-track">
			{pillarGuides.map((guide) => (
				<div class="carousel-item">
					<PostCard
						title={guide.title}
						description={guide.description}
						department={guide.department}
						href={guide.href}
						variant="guide"
					/>
				</div>
			))}
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<section class="browse">
		<div class="section-header">
			<h2>Browse by department<span class="dot-accent">.</span></h2>
			<a href="/category/" class="view-all">All categories <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="dept-grid">
			{DEPARTMENTS.map((d) => (
				<a href={`/category/department/${d.slug}/`} class="dept-card">
					<span class="dept-icon" aria-hidden="true"><span class="superdot"></span></span>
					<span class="dept-name">{d.label}</span>
					<svg class="dept-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
				</a>
			))}
		</div>
	</section>
</Base>

<style>
	/* Hero — full-bleed breakout from main container */
	.hero {
		position: relative;
		text-align: center;
		padding: var(--space-20) var(--space-4) var(--space-16);
		overflow-x: clip;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-top: calc(-1 * var(--space-8));
		-webkit-mask-image:
			linear-gradient(to bottom, black calc(100% - 120px), transparent),
			linear-gradient(to right, transparent, black 3%, black 97%, transparent);
		-webkit-mask-composite: destination-in;
		mask-image:
			linear-gradient(to bottom, black calc(100% - 120px), transparent),
			linear-gradient(to right, transparent, black 3%, black 97%, transparent);
		mask-composite: intersect;
	}
	.hero-glow {
		position: absolute;
		top: -30%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 1200px;
		height: 600px;
		border-radius: 50%;
		background: radial-gradient(ellipse, rgba(232, 54, 59, 0.06) 0%, transparent 70%);
		filter: blur(60px);
		pointer-events: none;
	}
	.hero-glow-secondary {
		position: absolute;
		bottom: -20%;
		right: 0;
		width: 50%;
		max-width: 600px;
		height: 500px;
		border-radius: 50%;
		background: radial-gradient(ellipse, rgba(20, 184, 166, 0.04) 0%, transparent 70%);
		filter: blur(50px);
		pointer-events: none;
	}
	:global([data-theme="dark"]) .hero-glow {
		background: radial-gradient(ellipse, rgba(232, 54, 59, 0.1) 0%, transparent 70%);
	}
	:global([data-theme="dark"]) .hero-glow-secondary {
		background: radial-gradient(ellipse, rgba(20, 184, 166, 0.06) 0%, transparent 70%);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .hero-glow {
			background: radial-gradient(ellipse, rgba(232, 54, 59, 0.1) 0%, transparent 70%);
		}
		:global([data-theme="auto"]) .hero-glow-secondary {
			background: radial-gradient(ellipse, rgba(20, 184, 166, 0.06) 0%, transparent 70%);
		}
	}
	.hero-proof {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}
	.hero-proof .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
		animation: pulse-dot 2s ease-in-out infinite;
		flex-shrink: 0;
	}
	.hero-proof .proof-sep {
		color: var(--color-primary);
		opacity: 0.65;
	}
	.hero-proof span:last-child {
		color: var(--color-primary);
	}
	@keyframes pulse-dot {
		0%, 100% { box-shadow: 0 0 0 0 rgba(232, 54, 59, 0.4); }
		50% { box-shadow: 0 0 0 6px rgba(232, 54, 59, 0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-proof .superdot { animation: none; }
	}
	/* Brand highlight for H1 keywords (noise, smarter) — dot underline */
	.hero h1 .hl {
		background: transparent;
		color: inherit;
		padding: 0 0.06em;
		position: relative;
		white-space: nowrap;
	}
	.hero h1 .hl::before {
		content: '';
		position: absolute;
		left: -0.04em;
		right: -0.04em;
		bottom: 0.08em;
		height: 0.36em;
		background-image: radial-gradient(circle, var(--color-primary) 1.6px, transparent 1.6px);
		background-size: 8px 8px;
		opacity: 0.55;
		z-index: -1;
		border-radius: 2px;
	}
	:global([data-theme="dark"]) .hero h1 .hl::before {
		opacity: 0.8;
	}
	.hero h1 {
		position: relative;
		font-size: var(--text-5xl);
		line-height: 1.08;
		margin-bottom: var(--space-6);
		max-width: 740px;
		margin-left: auto;
		margin-right: auto;
		letter-spacing: -0.03em;
	}
	.hero-sub {
		position: relative;
		color: var(--color-text-muted);
		font-size: var(--text-xl);
		max-width: 560px;
		margin: 0 auto var(--space-10);
		line-height: var(--leading-snug);
	}
	.hero-actions {
		position: relative;
		display: flex;
		gap: var(--space-4);
		justify-content: center;
		flex-wrap: wrap;
	}
	.hero-actions .btn-primary:hover {
		box-shadow: var(--shadow-md), 0 0 20px rgba(232, 54, 59, 0.2);
	}
	.btn-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-weight: var(--weight-semibold);
		font-size: var(--text-base);
		padding: var(--space-3) var(--space-6);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text-strong);
		text-decoration: none;
		transition: border-color var(--transition-base), box-shadow var(--transition-base), color var(--transition-base);
		cursor: pointer;
	}
	.btn-secondary:hover {
		border-color: var(--color-text-muted);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		color: var(--color-text-strong);
	}
	.btn-secondary.btn-lg {
		padding: var(--space-4) var(--space-8);
		font-size: var(--text-lg);
	}


	/* Guides Carousel */
	.guides-carousel {
		padding: var(--space-4) 0 var(--space-8);
		overflow-x: clip;
	}
	.carousel-track {
		display: flex;
		gap: var(--space-4);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		padding-bottom: var(--space-2);
		margin: 0 calc(-1 * var(--space-4));
		padding-left: var(--space-4);
		padding-right: var(--space-4);
	}
	.carousel-track::-webkit-scrollbar {
		display: none;
	}
	.carousel-item {
		/* Mobile: one card + a peek of the next (matches article grid: 1 col).
		   Desktop: half-container (matches article grid: 2 cols). */
		flex: 0 0 86vw;
		max-width: 420px;
		scroll-snap-align: start;
	}
	.carousel-item :global(.post-card) {
		height: 100%;
	}
	@media (min-width: 640px) {
		.carousel-item {
			flex: 0 0 calc(45% - var(--space-2));
			max-width: none;
		}
	}
	@media (min-width: 1024px) {
		.carousel-item {
			flex: 0 0 calc(31% - var(--space-2));
			max-width: none;
		}
	}

	/* Popular / Latest Section */
	.popular, .latest {
		padding: var(--space-4) 0 var(--space-8);
	}
	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: var(--space-6);
		gap: var(--space-4);
	}
	.section-header h2 {
		margin: 0;
	}
	.view-all {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		transition: gap var(--transition-fast);
		flex-shrink: 0;
	}
	.view-all:hover {
		text-decoration: none;
		gap: var(--space-2);
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}
	@media (min-width: 640px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* Newsletter section */
	.home-newsletter {
		padding: var(--space-2) 0;
	}
	.home-newsletter :global(.newsletter) {
		margin: 0;
	}

	/* Browse by Department */
	.browse {
		padding: var(--space-4) 0 var(--space-12);
	}
	.dept-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: var(--space-3);
	}
	.dept-card {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-4) var(--space-5);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		text-decoration: none;
		transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
		position: relative;
		overflow: hidden;
	}
	.dept-card::before {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(232, 54, 59, 0.04) 0%, transparent 60%);
		opacity: 0;
		transition: opacity var(--transition-base);
	}
	.dept-card:hover {
		border-color: var(--color-primary);
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
		text-decoration: none;
		color: var(--color-text-strong);
	}
	.dept-card:hover::before {
		opacity: 1;
	}
	.dept-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		background: var(--sd-red-light);
		border-radius: var(--radius-md);
		flex-shrink: 0;
		transition: background var(--transition-base);
	}
	.dept-icon .superdot {
		width: 6px;
		height: 6px;
	}
	.dept-card:hover .dept-icon {
		background: var(--sd-red);
	}
	.dept-card:hover .dept-icon .superdot {
		background: #FFFFFF;
	}
	.dept-name {
		flex: 1;
		position: relative;
	}
	.dept-arrow {
		opacity: 0;
		transform: translateX(-6px);
		transition: opacity var(--transition-fast), transform var(--transition-fast);
		color: var(--color-text-muted);
		flex-shrink: 0;
	}
	.dept-card:hover .dept-arrow {
		opacity: 0.6;
		transform: translateX(0);
	}

	/* Responsive */
	@media (max-width: 720px) {
		.hero {
			padding: var(--space-12) var(--space-4) var(--space-10);
		}
		.hero h1 {
			font-size: var(--text-4xl);
		}
		.hero-sub {
			font-size: var(--text-lg);
		}
	}
	@media (max-width: 480px) {
		.hero h1 {
			font-size: var(--text-3xl);
		}
		.dept-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-2);
		}
		.dept-card {
			padding: var(--space-3);
			gap: var(--space-2);
			font-size: var(--text-sm);
		}
		.dept-icon {
			width: 24px;
			height: 24px;
		}
		.dept-arrow {
			display: none;
		}
	}

	/* Series section — horizontal carousel on every viewport, same behaviour
	   as .guides-carousel. Cards share the common .carousel-track /
	   .carousel-item styles defined lower in this file. */
	.series-section {
		padding: var(--space-4) 0 var(--space-8);
		overflow-x: clip;
	}

	/* "What this is" manifesto — no card, no border, just typography */
	.manifesto {
		padding: var(--space-8) 0 var(--space-4);
	}
	.manifesto-inner {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
	}
	.manifesto-kicker {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-primary);
		margin: 0 0 var(--space-5);
	}
	.manifesto-kicker .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
	}
	.manifesto-body {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-normal);
		line-height: var(--leading-snug);
		letter-spacing: -0.015em;
		color: var(--color-text);
		margin: 0 0 var(--space-6);
	}
	.manifesto-body strong {
		color: var(--color-primary);
		font-weight: var(--weight-semibold);
	}
	.manifesto-body em {
