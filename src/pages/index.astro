---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);
---

<Base title="Superdots — Practical AI for Work" description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="dots dots-xl" style="top: 5%; right: 4%;"></div>
		<div class="dots dots-lg dots-fine" style="bottom: 5%; left: 2%;"></div>
		<div class="dots dots-md dots-brand" style="top: 20%; left: 8%;"></div>
		<p class="hero-label">
			<span class="superdot"></span>
			AI guides that actually help
		</p>
		<h1>Cut through the noise<span class="dot-accent">.</span><br/>Work smarter with AI<span class="dot-accent">.</span></h1>
		<p class="hero-sub">
			Practical, no-fluff guides on using AI across every department.
			Real techniques you can apply today — not hype, not theory.
		</p>
		<div class="hero-actions">
			<a href="/blog" class="btn btn-primary btn-lg">Browse articles</a>
			<a href="/about" class="btn btn-ghost btn-lg">Learn more</a>
		</div>
	</section>

	<section class="latest">
		<div class="section-header">
			<h2>Latest articles</h2>
			<a href="/blog" class="view-all">View all <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="post-grid">
			{posts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					department={post.data.department}
					useCase={post.data.useCase}
					slug={post.slug}
				/>
			))}
		</div>
	</section>
</Base>

<style>
	/* Hero */
	.hero {
		position: relative;
		overflow: hidden;
		text-align: center;
		padding: var(--space-16) 0 var(--space-12);
	}
	.hero-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary);
		margin-bottom: var(--space-6);
	}
	.hero-label .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		display: inline-block;
	}
	.hero h1 {
		font-size: var(--text-5xl);
		line-height: 1.1;
		margin-bottom: var(--space-6);
		max-width: 700px;
		margin-left: auto;
		margin-right: auto;
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.hero-sub {
		color: var(--color-text-muted);
		font-size: var(--text-xl);
		max-width: 560px;
		margin: 0 auto var(--space-8);
		line-height: var(--leading-snug);
	}
	.hero-actions {
		display: flex;
		gap: var(--space-4);
		justify-content: center;
		flex-wrap: wrap;
	}

	/* Latest Section */
	.latest {
		padding: var(--space-8) 0;
	}
	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: var(--space-6);
	}
	.section-header h2 {
		margin: 0;
	}
	.view-all {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
	}
	.view-all:hover {
		text-decoration: none;
		gap: var(--space-2);
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}

	@media (min-width: 640px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 720px) {
		.hero {
			padding: var(--space-10) 0 var(--space-8);
		}
		.hero h1 {
			font-size: var(--text-4xl);
		}
		.hero-sub {
			font-size: var(--text-lg);
		}
	}
	@media (max-width: 480px) {
		.hero h1 {
			font-size: var(--text-3xl);
		}
	}
</style>
