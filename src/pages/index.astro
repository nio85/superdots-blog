---
import { getCollection } from 'astro:content';
import { filterPublished } from '../lib/posts';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import AgentConstellation from '../components/AgentConstellation.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE_DESCRIPTION, DEPARTMENTS, PILLARS } from '../consts';

const PILLAR_COLORS: Record<string, string> = {
	'dot-by-dot': '#E8363B',
	'connecting-the-dots': '#14B8A6',
	'the-big-picture': '#8B8BF5',
	'behind-the-dots': '#F59E0B',
};

const allPosts = filterPublished(await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = allPosts.slice(0, 6);
const publishedCount = allPosts.length;

const pillarsWithLatest = PILLARS.map((p) => {
	const pillarPosts = allPosts.filter(({ data }) => (data.contentPillar || 'dot-by-dot') === p.slug);
	return {
		...p,
		count: pillarPosts.length,
		latestTitle: pillarPosts[0]?.data.title,
		latestSlug: pillarPosts[0]?.slug,
		accentColor: PILLAR_COLORS[p.slug] || '#E8363B',
	};
});

const pillarGuides = [
	{
		title: 'AI for Marketing',
		description: 'Create content, personalize campaigns, optimize SEO, and track brand performance at scale.',
		href: '/blog/ai-for-marketing-complete-guide/',
		department: 'Marketing',
	},
	{
		title: 'AI for Sales',
		description: 'Automate prospecting, personalize outreach, forecast revenue, and close more deals.',
		href: '/blog/ai-for-sales-complete-guide/',
		department: 'Sales',
	},
	{
		title: 'AI for HR',
		description: 'Automate recruiting, onboarding, performance reviews, and workforce planning.',
		href: '/blog/ai-for-hr/',
		department: 'HR',
	},
	{
		title: 'AI for Customer Service',
		description: 'Build faster support with AI chatbots, sentiment analysis, and automated ticket resolution.',
		href: '/blog/ai-for-customer-service-complete-guide/',
		department: 'Customer Service',
	},
	{
		title: 'AI Business Automation',
		description: 'Streamline workflows across departments with practical AI-powered automation.',
		href: '/blog/ai-automation-for-business-complete-guide/',
		department: 'Operations',
	},
];
---

<Base title="Superdots — Nine AI agents. One human. Honest AI guides for work." description={SITE_DESCRIPTION}>
	<section class="hero">
		<div class="hero-bg" aria-hidden="true">
			<div class="hero-glow"></div>
		</div>

		<div class="hero-constellation">
			<AgentConstellation variant="hero" />
		</div>

		<div class="hero-copy">
			<p class="hero-proof">
				<span class="superdot" aria-hidden="true"></span>
				<span>{publishedCount} guides</span>
				<span class="proof-sep" aria-hidden="true">·</span>
				<span>9 AI agents</span>
				<span class="proof-sep" aria-hidden="true">·</span>
				<span>1 editor</span>
				<span class="proof-sep" aria-hidden="true">·</span>
				<span>0 hype</span>
			</p>
			<h1>
				Cut through the <mark class="hl hl-noise">noise</mark><span class="dot-accent">.</span><br/>
				Work <mark class="hl hl-smarter">smarter</mark> with AI<span class="dot-accent">.</span>
			</h1>
			<p class="hero-sub">
				Guides, insights, opinions, and the real story of AI at work.
			</p>
			<div class="hero-actions">
				<a href="/blog/" class="btn btn-primary btn-lg">Browse articles</a>
				<a href="#newsletter" class="hero-secondary">or subscribe &rarr;</a>
			</div>
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<!-- What this is — manifesto -->
	<section class="manifesto">
		<div class="manifesto-inner">
			<p class="manifesto-kicker">
				<span class="superdot"></span>
				What this is
			</p>
			<p class="manifesto-body">
				Most AI blogs are ChatGPT writing about itself. This one is
				<strong>nine AI agents writing about work</strong>, with a human saying
				<em>&ldquo;no, rewrite that.&rdquo;</em> Every guide names real tools,
				real prices, and real steps. Mistakes are admitted in public.
				When we haven&rsquo;t used a tool ourselves, we say so.
			</p>
			<a href="/how-we-work/" class="manifesto-cta">How we actually work <span aria-hidden="true">&rarr;</span></a>
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<!-- Our Series — pari dignità -->
	<section class="series-section">
		<div class="section-header">
			<h2>Our series<span class="dot-accent">.</span></h2>
			<a href="/series/" class="view-all">All series <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="series-grid">
			{pillarsWithLatest.map((p) => (
				<a href={`/series/${p.slug}/`} class="series-card" style={`--pillar-color: ${p.accentColor};`}>
					<div class="series-dot" aria-hidden="true"></div>
					<h3 class="series-name">{p.label}</h3>
					<p class="series-desc">{p.description}</p>
					<div class="series-footer">
						<span class="series-count">{p.count}</span>
						<span class="series-cta">Browse <span aria-hidden="true">&rarr;</span></span>
					</div>
				</a>
			))}
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<!-- Latest Articles — mix variant (1 feature + 5 default) -->
	<section class="latest">
		<div class="section-header">
			<h2>Latest articles<span class="dot-accent">.</span></h2>
			<a href="/blog/" class="view-all">View all <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="post-grid post-grid--mixed">
			{latestPosts.map((post, i) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					department={post.data.department}
					useCase={post.data.useCase}
					slug={post.slug}
					tags={post.data.tags}
					contentPillar={post.data.contentPillar}
					variant={i === 0 ? 'feature' : 'default'}
				/>
			))}
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<section class="home-newsletter" id="newsletter">
		<NewsletterForm variant="banner" source="homepage" />
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<!-- Pillar Guides Carousel -->
	<section class="guides-carousel" id="guides">
		<div class="section-header">
			<h2>Complete AI guides<span class="dot-accent">.</span></h2>
			<a href="/guides/" class="view-all">All guides <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="carousel-track">
			{pillarGuides.map((guide) => (
				<div class="carousel-item">
					<PostCard
						title={guide.title}
						description={guide.description}
						department={guide.department}
						href={guide.href}
						variant="guide"
					/>
				</div>
			))}
		</div>
	</section>

	<div class="section-divider" aria-hidden="true"><span class="superdot"></span></div>

	<section class="browse">
		<div class="section-header">
			<h2>Browse by department<span class="dot-accent">.</span></h2>
			<a href="/category/" class="view-all">All categories <span aria-hidden="true">&rarr;</span></a>
		</div>
		<div class="dept-grid">
			{DEPARTMENTS.map((d) => (
				<a href={`/category/department/${d.slug}/`} class="dept-card">
					<span class="dept-icon" aria-hidden="true"><span class="superdot"></span></span>
					<span class="dept-name">{d.label}</span>
					<svg class="dept-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
				</a>
			))}
		</div>
	</section>
</Base>

<style>
	/* Hero — the statement. Constellation dominant, typography amplified. */
	.hero {
		position: relative;
		text-align: center;
		padding: var(--space-16) var(--space-4) var(--space-12);
		overflow-x: clip;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-top: calc(-1 * var(--space-8));
	}
	.hero-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
	}
	.hero-glow {
		position: absolute;
		top: -10%;
		left: 50%;
		transform: translateX(-50%);
		width: 80%;
		max-width: 1000px;
		height: 580px;
		border-radius: 50%;
		background: radial-gradient(ellipse, rgba(232, 54, 59, 0.08) 0%, transparent 70%);
		filter: blur(70px);
	}
	:global([data-theme="dark"]) .hero-glow {
		background: radial-gradient(ellipse, rgba(232, 54, 59, 0.14) 0%, transparent 70%);
	}

	.hero-constellation {
		position: relative;
		z-index: 1;
		margin: 0 auto var(--space-6);
		max-width: 960px;
	}

	.hero-copy {
		position: relative;
		z-index: 2;
	}

	.hero-proof {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-text-muted);
		margin: 0 0 var(--space-5);
		flex-wrap: wrap;
		justify-content: center;
	}
	.hero-proof .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
		animation: dot-breath 3s ease-in-out infinite;
		flex-shrink: 0;
	}
	.hero-proof .proof-sep {
		color: var(--color-primary);
		opacity: 0.7;
	}
	.hero-proof span:last-child {
		color: var(--color-primary);
	}

	/* Brand highlight for H1 keywords */
	.hero h1 .hl {
		background: transparent;
		color: var(--color-text-strong);
		padding: 0 0.08em;
		position: relative;
		white-space: nowrap;
	}
	.hero h1 .hl::before {
		content: '';
		position: absolute;
		left: -0.04em;
		right: -0.04em;
		bottom: 0.08em;
		height: 0.38em;
		background-image: radial-gradient(circle, var(--color-primary) 1.6px, transparent 1.6px);
		background-size: 8px 8px;
		opacity: 0.55;
		z-index: -1;
		border-radius: 2px;
	}
	.hero h1 .hl-smarter::before {
		background-image: radial-gradient(circle, var(--color-primary) 1.6px, transparent 1.6px);
		opacity: 0.75;
	}
	:global([data-theme="dark"]) .hero h1 .hl::before {
		opacity: 0.7;
	}
	:global([data-theme="dark"]) .hero h1 .hl-smarter::before {
		opacity: 0.95;
	}

	.hero h1 {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5.5vw, 3.75rem);
		font-weight: var(--weight-bold);
		line-height: 1.08;
		margin: 0 auto var(--space-5);
		max-width: 880px;
		letter-spacing: -0.035em;
		color: var(--color-text-strong);
	}

	.hero-sub {
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		max-width: 560px;
		margin: 0 auto var(--space-8);
		line-height: var(--leading-snug);
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		justify-content: center;
		flex-wrap: wrap;
	}

	.hero-actions .btn-primary {
		box-shadow: 0 6px 20px rgba(232, 54, 59, 0.2);
	}
	.hero-actions .btn-primary:hover {
		box-shadow: 0 8px 28px rgba(232, 54, 59, 0.35);
		transform: translateY(-1px);
	}

	.hero-secondary {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		letter-spacing: 0.01em;
		transition: color 160ms ease, gap 160ms ease;
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		text-decoration: none;
	}
	.hero-secondary:hover {
		color: var(--color-primary);
		gap: var(--space-2);
		text-decoration: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-kicker .superdot { animation: none; }
	}

	/* Manifesto — no card, no border. Just typography and a dot. */
	.manifesto {
		padding: var(--space-10) 0;
	}
	.manifesto-inner {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
	}
	.manifesto-kicker {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-primary);
		margin: 0 0 var(--space-5);
	}
	.manifesto-kicker .superdot {
		width: 8px;
		height: 8px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
	}
	.manifesto-body {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-semibold);
		line-height: var(--leading-snug);
		letter-spacing: -0.02em;
		color: var(--color-text-strong);
		margin: 0 0 var(--space-6);
	}
	.manifesto-body strong {
		color: var(--color-primary);
		font-weight: var(--weight-semibold);
	}
	.manifesto-body em {
		font-style: normal;
		color: var(--color-text);
		background: linear-gradient(180deg, transparent 60%, color-mix(in srgb, var(--color-primary) 20%, transparent) 60%);
		padding: 0 4px;
	}
	.manifesto-cta {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		letter-spacing: 0.01em;
		transition: gap 160ms ease;
		text-decoration: none;
	}
	.manifesto-cta:hover {
		gap: var(--space-2);
		text-decoration: none;
	}

	@media (max-width: 639px) {
		.manifesto-body {
			font-size: var(--text-lg);
		}
	}

	/* Guides Carousel */
	.guides-carousel {
		padding: var(--space-4) 0 var(--space-8);
	}
	.carousel-track {
		display: flex;
		gap: var(--space-4);
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
		padding-bottom: var(--space-2);
		margin: 0 calc(-1 * var(--space-4));
		padding-left: var(--space-4);
		padding-right: var(--space-4);
	}
	.carousel-track::-webkit-scrollbar {
		display: none;
	}
	.carousel-item {
		flex: 0 0 280px;
		scroll-snap-align: start;
	}
	.carousel-item :global(.post-card) {
		height: 100%;
	}
	@media (min-width: 640px) {
		.carousel-item {
			flex: 0 0 300px;
		}
	}

	/* Latest / feed */
	.latest {
		padding: var(--space-4) 0 var(--space-8);
	}
	.section-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: var(--space-6);
		gap: var(--space-4);
	}
	.section-header h2 {
		margin: 0;
		font-size: var(--text-3xl);
		letter-spacing: -0.025em;
	}
	.view-all {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		color: var(--color-primary);
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		transition: gap var(--transition-fast);
		flex-shrink: 0;
		text-decoration: none;
	}
	.view-all:hover {
		text-decoration: none;
		gap: var(--space-2);
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}
	@media (min-width: 640px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	/* Newsletter section */
	.home-newsletter {
		padding: var(--space-2) 0;
	}
	.home-newsletter :global(.newsletter) {
		margin: 0;
	}

	/* Browse by Department */
	.browse {
		padding: var(--space-4) 0 var(--space-12);
	}
	.dept-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: var(--space-3);
	}
	.dept-card {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-4) var(--space-5);
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		font-family: var(--font-display);
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		text-decoration: none;
		transition: all var(--transition-base);
		position: relative;
		overflow: hidden;
	}
	.dept-card:hover {
		border-color: var(--color-primary);
		background: color-mix(in srgb, var(--color-primary) 4%, transparent);
		text-decoration: none;
		color: var(--color-text-strong);
	}
	.dept-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		background: color-mix(in srgb, var(--color-primary) 12%, transparent);
		border-radius: var(--radius-md);
		flex-shrink: 0;
		transition: background var(--transition-base);
	}
	.dept-icon .superdot {
		width: 6px;
		height: 6px;
	}
	.dept-card:hover .dept-icon {
		background: var(--sd-red);
	}
	.dept-card:hover .dept-icon .superdot {
		background: #FFFFFF;
	}
	.dept-name {
		flex: 1;
		position: relative;
	}
	.dept-arrow {
		opacity: 0;
		transform: translateX(-6px);
		transition: all var(--transition-fast);
		color: var(--color-text-muted);
		flex-shrink: 0;
	}
	.dept-card:hover .dept-arrow {
		opacity: 0.6;
		transform: translateX(0);
	}

	/* Responsive */
	@media (max-width: 720px) {
		.hero {
			padding: var(--space-10) var(--space-4) var(--space-8);
		}
		.section-header h2 {
			font-size: var(--text-2xl);
		}
	}
	@media (max-width: 480px) {
		.dept-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--space-2);
		}
		.dept-card {
			padding: var(--space-3);
			gap: var(--space-2);
			font-size: var(--text-sm);
		}
		.dept-icon {
			width: 24px;
			height: 24px;
		}
		.dept-arrow {
			display: none;
		}
	}

	/* Series section */
	.series-grid {
		display: grid;
		gap: var(--space-4);
		grid-template-columns: repeat(2, 1fr);
	}
	@media (max-width: 639px) {
		.series-grid { grid-template-columns: 1fr; }
	}
	.series-card {
		display: flex;
		flex-direction: column;
		padding: var(--space-5);
		border-radius: var(--radius-lg);
		background: var(--color-bg-dim);
		border: 1px solid transparent;
		border-top: 3px solid var(--pillar-color);
		text-decoration: none;
		transition: all var(--transition-base);
	}
	.series-card:hover {
		border-color: var(--pillar-color);
		text-decoration: none;
	}
	.series-dot {
		width: 10px;
		height: 10px;
		border-radius: var(--radius-full);
		background: var(--pillar-color);
		margin-bottom: var(--space-3);
		transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.series-card:hover .series-dot {
		transform: scale(1.5);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--pillar-color) 20%, transparent);
	}
	.series-name {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		color: var(--color-text-strong);
		margin: 0 0 var(--space-2);
		line-height: var(--leading-tight);
		letter-spacing: -0.02em;
	}
	.series-desc {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: var(--leading-snug);
		margin: 0;
		flex: 1;
	}
	.series-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: var(--space-4);
	}
	.series-count {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		color: var(--color-text-muted);
		letter-spacing: 0.04em;
	}
	.series-count::after {
		content: ' articles';
		font-weight: var(--weight-normal);
		text-transform: lowercase;
	}
	.series-cta {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
