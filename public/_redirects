# Redirect www to apex
https://www.superdots.sh/* https://superdots.sh/:splat 301

# Prevent redirect loop on 404 page (CF Pages 301 /404→/404/ vs 308 /404/→/404)
/404 /404.html 200
/404/ /404.html 200

# Favicon fallback for browsers that request .ico or .png
/favicon.ico /favicon.svg 301
/favicon.png /favicon.svg 301
