---
/**
 * ToolReviewCard — Individual tool review block for comparison/review pages.
 *
 * Usage:
 *   <ToolReviewCard
 *     name="ToolName"
 *     overview="Brief description of the tool."
 *     pros={["Fast setup", "Great UI"]}
 *     cons={["Expensive", "Limited integrations"]}
 *     pricing="From $29/mo (free tier available)"
 *     verdict="Best all-around choice for mid-size teams."
 *     bestFor="Marketing teams"
 *     rating={4.5}
 *     ctaText="Try ToolName free"
 *     ctaUrl="https://..."
 *   />
 */

interface Props {
	name: string;
	logo?: string;
	url?: string;
	overview: string;
	pros: string[];
	cons: string[];
	pricing: string;
	verdict: string;
	bestFor: string;
	rating?: number;
	ctaText?: string;
	ctaUrl: string;
}

const { name, logo, url, overview, pros, cons, pricing, verdict, bestFor, rating, ctaText, ctaUrl } = Astro.props;

function renderStars(r: number): string {
	const full = Math.floor(r);
	const half = r % 1 >= 0.25 && r % 1 < 0.75 ? 1 : 0;
	const bump = r % 1 >= 0.75 ? 1 : 0;
	const filled = full + bump;
	const empty = 5 - filled - half;
	return '★'.repeat(filled) + (half ? '½' : '') + '☆'.repeat(empty);
}
---

<div class="review-card" id={`review-${name.toLowerCase().replace(/\s+/g, '-')}`}>
	<div class="review-card-header">
		<div class="review-card-title">
			{logo && <img src={logo} alt="" class="review-logo" width="36" height="36" loading="lazy" />}
			<div>
				<h3 class="review-name">
					{url ? <a href={url} rel="noopener">{name}</a> : name}
				</h3>
				{rating && (
					<div class="review-rating" title={`${rating} out of 5`}>
						<span class="review-stars" aria-hidden="true">{renderStars(rating)}</span>
						<span class="review-rating-num">{rating}/5</span>
					</div>
				)}
			</div>
		</div>
		<span class="review-best-for">{bestFor}</span>
	</div>

	<p class="review-overview">{overview}</p>

	<div class="review-columns">
		<div class="review-pros">
			<h4 class="review-section-title review-section-pros">Pros</h4>
			<ul>
				{pros.map((p) => <li>{p}</li>)}
			</ul>
		</div>
		<div class="review-cons">
			<h4 class="review-section-title review-section-cons">Cons</h4>
			<ul>
				{cons.map((c) => <li>{c}</li>)}
			</ul>
		</div>
	</div>

	<div class="review-footer">
		<div class="review-pricing">
			<span class="review-pricing-label">Pricing</span>
			<span class="review-pricing-value">{pricing}</span>
		</div>
		<div class="review-verdict">
			<span class="review-verdict-label">Verdict</span>
			<p class="review-verdict-text">{verdict}</p>
		</div>
	</div>

	<a href={ctaUrl} class="btn btn-primary review-cta" rel="noopener sponsored">
		{ctaText || `Try ${name}`}
		<span aria-hidden="true">&rarr;</span>
	</a>
</div>

<style>
	.review-card {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		padding: var(--space-8);
		margin: var(--space-8) 0;
		position: relative;
		overflow: hidden;
		transition: border-color var(--transition-base);
	}
	.review-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 4px;
		height: 0;
		background: var(--color-primary);
		border-radius: var(--radius-xl) 0 0 var(--radius-xl);
		transition: height 350ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.review-card:hover {
		border-color: var(--color-primary);
	}
	.review-card:hover::before {
		height: 100%;
	}

	/* --- Header --- */
	.review-card-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
		flex-wrap: wrap;
	}
	.review-card-title {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}
	.review-logo {
		border-radius: var(--radius-md);
		flex-shrink: 0;
	}
	.review-name {
		font-family: var(--font-display);
		font-size: var(--text-2xl);
		font-weight: var(--weight-bold);
		color: var(--color-text-strong);
		margin: 0;
		letter-spacing: -0.02em;
	}
	.review-name a {
		color: inherit;
		text-decoration: none;
	}
	.review-name a:hover {
		color: var(--color-primary);
	}
	.review-rating {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		margin-top: var(--space-1);
	}
	.review-stars {
		color: var(--sd-amber);
		font-size: var(--text-sm);
		letter-spacing: 1px;
	}
	.review-rating-num {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}
	.review-best-for {
		display: inline-flex;
		align-items: center;
		padding: var(--space-1) var(--space-3);
		background: var(--sd-teal-light);
		color: var(--sd-teal-dark);
		border-radius: var(--radius-full);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
		flex-shrink: 0;
	}

	/* --- Overview --- */
	.review-overview {
		color: var(--color-text);
		font-size: var(--text-base);
		line-height: var(--leading-normal);
		margin-bottom: var(--space-6);
	}

	/* --- Pros / Cons --- */
	.review-columns {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-6);
		margin-bottom: var(--space-6);
	}
	.review-section-title {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin: 0 0 var(--space-3);
		padding-bottom: var(--space-2);
		border-bottom: 2px solid var(--color-border);
	}
	.review-section-pros {
		color: var(--sd-teal-dark);
		border-color: var(--sd-teal);
	}
	.review-section-cons {
		color: var(--sd-red-dark);
		border-color: var(--sd-red);
	}
	.review-pros ul,
	.review-cons ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.review-pros li,
	.review-cons li {
		padding: var(--space-1) 0;
		font-size: var(--text-sm);
		color: var(--color-text);
		line-height: var(--leading-snug);
		position: relative;
		padding-left: var(--space-5);
	}
	.review-pros li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--sd-teal);
		font-weight: var(--weight-bold);
	}
	.review-cons li::before {
		content: '✗';
		position: absolute;
		left: 0;
		color: var(--sd-red);
		font-weight: var(--weight-bold);
	}

	/* --- Footer (pricing + verdict) --- */
	.review-footer {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-6);
		margin-bottom: var(--space-6);
		padding: var(--space-4);
		background: var(--color-bg-dim);
		border-radius: var(--radius-lg);
	}
	.review-pricing-label,
	.review-verdict-label {
		display: block;
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-muted);
		margin-bottom: var(--space-1);
	}
	.review-pricing-value {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--color-text-strong);
		font-weight: var(--weight-semibold);
	}
	.review-verdict-text {
		font-size: var(--text-sm);
		color: var(--color-text);
		line-height: var(--leading-snug);
		margin: 0;
	}

	/* --- CTA --- */
	.review-cta {
		display: flex;
		width: 100%;
		text-decoration: none;
	}
	.review-cta:hover {
		text-decoration: none;
	}

	/* --- Responsive --- */
	@media (max-width: 600px) {
		.review-card {
			padding: var(--space-5);
		}
		.review-columns {
			grid-template-columns: 1fr;
			gap: var(--space-4);
		}
		.review-footer {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
		.review-card-header {
			flex-direction: column;
			gap: var(--space-2);
		}
	}

	/* --- Dark mode --- */
	:global([data-theme="dark"]) .review-best-for {
		background: rgba(20, 184, 166, 0.15);
		color: #5EEAD4;
	}
	:global([data-theme="dark"]) .review-section-pros {
		color: #5EEAD4;
	}
	:global([data-theme="dark"]) .review-section-cons {
		color: #F87171;
	}
	:global([data-theme="dark"]) .review-card {
		background: var(--color-bg-dim);
	}
	@media (prefers-color-scheme: dark) {
		:global([data-theme="auto"]) .review-best-for {
			background: rgba(20, 184, 166, 0.15);
			color: #5EEAD4;
		}
		:global([data-theme="auto"]) .review-section-pros {
			color: #5EEAD4;
		}
		:global([data-theme="auto"]) .review-section-cons {
			color: #F87171;
		}
		:global([data-theme="auto"]) .review-card {
			background: var(--color-bg-dim);
		}
	}
</style>
