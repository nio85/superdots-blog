---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	widths?: number[];
	sizes?: string;
	class?: string;
	loading?: 'lazy' | 'eager';
	fetchpriority?: 'high' | 'low' | 'auto';
}

const {
	src,
	alt,
	widths = [400, 800, 1200],
	sizes = '(max-width: 720px) 100vw, 720px',
	class: className,
	loading = 'lazy',
	fetchpriority,
} = Astro.props;

const isLocal = typeof src !== 'string';
---

{isLocal ? (
	<Picture
		src={src}
		alt={alt}
		formats={['avif', 'webp']}
		widths={widths}
		sizes={sizes}
		class={className}
		loading={loading}
		fetchpriority={fetchpriority}
		decoding="async"
	/>
) : (
	<img
		src={src}
		alt={alt}
		class={className}
		loading={loading}
		fetchpriority={fetchpriority}
		decoding="async"
	/>
)}
