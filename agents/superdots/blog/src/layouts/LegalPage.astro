---
import Base from './Base.astro';

interface Props {
	title: string;
	description: string;
	pageTitle: string;
	lastUpdated: string;
}

const { title, description, pageTitle, lastUpdated } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const legalLinks = [
	{ href: '/privacy', label: 'Privacy Policy' },
	{ href: '/cookie-policy', label: 'Cookie Policy' },
	{ href: '/terms', label: 'Terms of Service' },
];
---

<Base title={title} description={description}>
	<article class="legal-page">
		<header class="legal-header">
			<div class="dots dots-md dots-brand" style="top: 0; right: 0;"></div>
			<div class="dots dots-sm" style="bottom: 10%; left: -2%;"></div>
			<p class="legal-label">
				<span class="superdot"></span>
				Legal
			</p>
			<h1>{pageTitle}<span class="dot-accent">.</span></h1>
			<p class="legal-meta">Last updated: {lastUpdated}</p>
		</header>
		<div class="legal-body">
			<slot />
		</div>
		<footer class="legal-footer">
			<div class="legal-footer-inner">
				<p>
					Questions? Contact <a href="mailto:privacy@superdots.sh">privacy@superdots.sh</a>
				</p>
				<nav class="legal-nav" aria-label="Legal pages">
					{legalLinks.map((link, i) => (
						<>
							{i > 0 && <span class="legal-nav-sep" aria-hidden="true">&middot;</span>}
							<a
								href={link.href}
								class:list={[{ 'is-current': currentPath === link.href }]}
								aria-current={currentPath === link.href ? 'page' : undefined}
							>
								{link.label}
							</a>
						</>
					))}
				</nav>
			</div>
		</footer>
	</article>
</Base>

<script>
	// Wrap tables in scroll containers to prevent horizontal overflow on mobile
	document.querySelectorAll('.legal-body table').forEach((table) => {
		const wrapper = document.createElement('div');
		wrapper.className = 'table-scroll-wrapper';
		table.parentNode!.insertBefore(wrapper, table);
		wrapper.appendChild(table);
	});
</script>

<style>
	.legal-page {
		max-width: var(--max-width-prose);
		margin: 0 auto;
		overflow-x: hidden;
	}

	/* --- Header --- */
	.legal-header {
		position: relative;
		overflow: hidden;
		padding: var(--space-12) 0 var(--space-8);
		border-bottom: 2px solid var(--color-border);
		margin-bottom: var(--space-8);
	}
	.legal-label {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-display);
		font-size: var(--text-xs);
		font-weight: var(--weight-semibold);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-primary);
		margin-bottom: var(--space-4);
	}
	.legal-header h1 {
		margin-bottom: var(--space-3);
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.legal-meta {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		margin: 0;
	}

	/* --- Body --- */
	.legal-body {
		line-height: var(--leading-relaxed);
		overflow-wrap: break-word;
		word-break: break-word;
	}
	.legal-body :global(h2) {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		margin-top: var(--space-10);
		margin-bottom: var(--space-4);
		padding-bottom: var(--space-2);
		border-bottom: 1px solid var(--color-border);
	}
	.legal-body :global(h3) {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		margin-top: var(--space-6);
		margin-bottom: var(--space-3);
	}
	.legal-body :global(ul),
	.legal-body :global(ol) {
		padding-left: var(--space-6);
	}
	.legal-body :global(li) {
		margin-bottom: 0.5em;
	}
	.legal-body :global(li::marker) {
		color: var(--color-primary);
	}
	.legal-body :global(strong) {
		color: var(--color-text-strong);
	}
	.legal-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: var(--space-6) 0;
		font-size: var(--text-sm);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		min-width: 480px;
	}
	.legal-body :global(thead) {
		background: var(--color-bg-dim);
	}
	.legal-body :global(th),
	.legal-body :global(td) {
		text-align: left;
		padding: var(--space-3) var(--space-4);
		border-bottom: 1px solid var(--color-border);
	}
	.legal-body :global(th) {
		font-weight: var(--weight-semibold);
		color: var(--color-text-strong);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.legal-body :global(tr:last-child td) {
		border-bottom: none;
	}
	.legal-body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.85em;
		background: var(--color-bg-code);
		padding: 0.15em 0.4em;
		border-radius: var(--radius-sm);
		border: 1px solid var(--color-border);
	}

	/* --- Footer nav --- */
	.legal-footer {
		margin-top: var(--space-12);
		padding-top: var(--space-6);
		border-top: 2px solid var(--color-border);
	}
	.legal-footer-inner {
		text-align: center;
	}
	.legal-footer p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		margin-bottom: var(--space-3);
	}
	.legal-nav {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
	.legal-nav a {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color var(--transition-fast);
	}
	.legal-nav a:hover {
		color: var(--color-primary);
		text-decoration: none;
	}
	.legal-nav a.is-current {
		color: var(--color-text-strong);
		font-weight: var(--weight-semibold);
	}
	.legal-nav-sep {
		color: var(--color-border-strong);
	}

	/* Table scroll wrapper (injected by script below) */
	.legal-body :global(.table-scroll-wrapper) {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		margin: var(--space-6) 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}
	.legal-body :global(.table-scroll-wrapper table) {
		margin: 0;
		border: none;
		border-radius: 0;
	}

	@media (max-width: 720px) {
		.legal-header {
			padding: var(--space-8) 0 var(--space-6);
		}
	}
</style>
