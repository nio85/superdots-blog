---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, author, department, useCase } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${title} | Superdots`} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="article-header">
					<div class="meta">
						<span class="badge dept">{department}</span>
						<span class="badge use-case">{useCase}</span>
					</div>
					<h1>{title}</h1>
					<p class="description">{description}</p>
					<div class="byline">
						<span class="author">{author}</span>
						<span class="separator">&middot;</span>
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">
								(Updated: <FormattedDate date={updatedDate} />)
							</span>
						)}
					</div>
					<hr />
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-header {
		margin-bottom: 2rem;
	}
	.article-header h1 {
		margin: 0.75rem 0 0.5rem;
		font-size: 2.25rem;
	}
	.description {
		color: var(--text-light);
		font-size: 1.125rem;
		margin-bottom: 1rem;
	}
	.meta {
		display: flex;
		gap: 0.5rem;
	}
	.badge {
		display: inline-block;
		padding: 2px 8px;
		border-radius: 4px;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: capitalize;
	}
	.badge.dept {
		background: #ede9fe;
		color: #6d28d9;
	}
	.badge.use-case {
		background: #ecfdf5;
		color: #059669;
	}
	.byline {
		color: var(--text-light);
		font-size: 0.9rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}
	.author {
		font-weight: 600;
	}
	.updated {
		font-style: italic;
	}
	.prose {
		line-height: 1.8;
	}
	.prose :global(h2) {
		margin-top: 2rem;
	}
	.prose :global(h3) {
		margin-top: 1.5rem;
	}
	.prose :global(ul), .prose :global(ol) {
		padding-left: 1.5rem;
	}
	.prose :global(li) {
		margin-bottom: 0.5em;
	}
</style>
