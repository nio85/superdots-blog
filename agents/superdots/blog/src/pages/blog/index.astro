---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title="All Articles | Superdots" description="Browse all practical AI guides.">
	<script slot="head" type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "CollectionPage",
		"name": "All Articles",
		"description": "Browse all practical AI guides.",
		"url": "https://superdots.sh/blog",
		"mainEntity": {
			"@type": "ItemList",
			"numberOfItems": posts.length,
			"itemListElement": posts.slice(0, 10).map((post, i) => ({
				"@type": "ListItem",
				"position": i + 1,
				"url": `https://superdots.sh/blog/${post.slug}/`
			}))
		}
	})} />
	<div class="page-header">
		<div class="dots dots-md dots-loose" style="top: 5%; right: 3%;"></div>
		<h1>All articles<span class="dot-accent">.</span></h1>
		<p class="page-desc">Step-by-step AI guides for every team — from sales call prep to contract review. No theory, no hype. Just techniques you can use today.</p>
	</div>
	<div class="post-grid">
		{posts.map((post) => (
			<PostCard
				title={post.data.title}
				description={post.data.description}
				pubDate={post.data.pubDate}
				department={post.data.department}
				useCase={post.data.useCase}
				slug={post.slug}
				tags={post.data.tags}
			/>
		))}
	</div>
</Base>

<style>
	.page-header {
		position: relative;
		overflow: hidden;
		padding: var(--space-6) 0 var(--space-2);
	}
	.page-header h1 {
		margin-bottom: var(--space-2);
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.page-desc {
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		margin-bottom: var(--space-6);
		line-height: var(--leading-snug);
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}
	@media (min-width: 640px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
</style>
