---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { TAGS } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tagLookup = new Map(TAGS.map((t) => [t.slug, t]));

	function slugToLabel(s: string): string {
		return s.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
	}

	const allTags = new Set<string>();
	for (const post of posts) {
		for (const tag of post.data.tags ?? []) {
			allTags.add(tag);
		}
	}
	for (const t of TAGS) {
		allTags.add(t.slug);
	}
	return [...allTags].map((slug) => {
		const known = tagLookup.get(slug);
		return {
			params: { tag: slug },
			props: {
				label: known?.label ?? slugToLabel(slug),
				description: known?.description ?? `Articles tagged with ${slugToLabel(slug)}.`,
			},
		};
	});
}

const { tag } = Astro.params;
const { label, description } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => (data.tags ?? []).includes(tag!)))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`${label} Articles | Superdots`} description={description}>
	<div class="page-header">
		<div class="dots dots-sm dots-fine" style="top: 0; right: 0;" aria-hidden="true"></div>
		<a href="/tags/" class="back">&larr; Tags</a>
		<h1>{label}<span class="dot-accent">.</span></h1>
		<p class="subtitle">{description}</p>
	</div>

	{posts.length === 0 ? (
		<p class="empty">No articles yet. Check back soon.</p>
	) : (
		<div class="post-grid">
			{posts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					department={post.data.department}
					useCase={post.data.useCase}
					slug={post.slug}
					tags={post.data.tags}
					headingLevel="h2"
				/>
			))}
		</div>
	)}
</Base>

<style>
	.page-header {
		position: relative;
		overflow: hidden;
		padding: var(--space-6) 0 var(--space-2);
	}
	.page-header h1 {
		margin-bottom: var(--space-2);
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.back {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-muted);
		display: inline-block;
		margin-bottom: var(--space-4);
	}
	.back:hover {
		color: var(--color-primary);
		text-decoration: none;
	}
	.subtitle {
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}
	.empty {
		color: var(--color-text-muted);
		font-style: italic;
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}
	@media (min-width: 640px) {
		.post-grid { grid-template-columns: repeat(2, 1fr); }
	}
</style>
