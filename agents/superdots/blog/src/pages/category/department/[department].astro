---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PostCard from '../../../components/PostCard.astro';
import { DEPARTMENTS } from '../../../consts';

export function getStaticPaths() {
	return DEPARTMENTS.map((d) => ({
		params: { department: d.slug },
		props: { label: d.label },
	}));
}

const { department } = Astro.params;
const { label } = Astro.props;

const posts = (await getCollection('blog', ({ data }) => data.department === department))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`${label} | Superdots`} description={`AI guides for ${label} teams.`}>
	<div class="page-header">
		<div class="dots dots-sm dots-fine" style="top: 0; right: 0;"></div>
		<a href="/category" class="back">&larr; Categories</a>
		<h1>{label}<span class="dot-accent">.</span></h1>
		<p class="subtitle">AI guides for {label.toLowerCase()} teams</p>
	</div>

	{posts.length === 0 ? (
		<p class="empty">No articles yet. Check back soon.</p>
	) : (
		<div class="post-grid">
			{posts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					department={post.data.department}
					useCase={post.data.useCase}
					slug={post.slug}
				/>
			))}
		</div>
	)}
</Base>

<style>
	.page-header {
		position: relative;
		overflow: hidden;
		padding: var(--space-4) 0 var(--space-2);
	}
	.page-header h1 {
		margin-bottom: var(--space-2);
	}
	.dot-accent {
		color: var(--color-primary);
	}
	.back {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		font-weight: var(--weight-medium);
		color: var(--color-text-muted);
		display: inline-block;
		margin-bottom: var(--space-4);
	}
	.back:hover {
		color: var(--color-primary);
		text-decoration: none;
	}
	.subtitle {
		color: var(--color-text-muted);
		margin-bottom: var(--space-6);
	}
	.empty {
		color: var(--color-text-muted);
		font-style: italic;
	}
	.post-grid {
		display: grid;
		gap: var(--space-5);
	}
	@media (min-width: 640px) {
		.post-grid { grid-template-columns: repeat(2, 1fr); }
	}
</style>
