# Resend SMTP (required for email notifications and alerts)
RESEND_SMTP_API_KEY=

# Cloudflare (required for Wrangler deploy and deploy health checks)
CLOUDFLARE_API_TOKEN=

# GitHub (required for subtree push deploy)
GITHUB_TOKEN=

# Syndication platform API keys
DEVTO_API_KEY=
HASHNODE_TOKEN=
HASHNODE_PUB_ID=
MEDIUM_TOKEN=
MEDIUM_AUTHOR_ID=

# Replicate (required for AI image generation)
REPLICATE_API_TOKEN=

# Overrides (optional, defaults are set in scripts/config.mjs)
# SMTP_USER=
# TO_EMAIL=
# PAPERCLIP_API_URL=http://localhost:3100
# PAPERCLIP_COMPANY_ID=
# PAPERCLIP_DB_URL=
