<mjml>
  <mj-head>
    <mj-title>Your next event could plan itself (almost)</mj-title>
    <mj-preview>Plus: the onboarding gap killing your revenue</mj-preview>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <mj-font name="Space Grotesk" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="'Inter', Arial, Helvetica, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#CBD5E1" />
      <mj-section padding="0" />
      <mj-body background-color="#080E1A" />
    </mj-attributes>
    <mj-style>
      /* Links */
      a { color: #14B8A6; text-decoration: none; }
      a:hover { text-decoration: underline; }
      .cta-link a { color: #FFFFFF !important; text-decoration: none !important; }
      .footer-link a { color: #94A3B8 !important; font-size: 13px; }
      .webview-link a { color: #475569 !important; font-size: 12px; }
      .secondary-title a { color: #F1F5F9 !important; text-decoration: none; }
      .secondary-title a:hover { color: #E8363B !important; }
      /* Brand dot */
      .superdot { color: #E8363B; }
      /* Logo dots - ascending diagonal (small→medium→large) */
      .dot-sm { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background-color: #E8363B; vertical-align: middle; }
      .dot-md { display: inline-block; width: 11px; height: 11px; border-radius: 50%; background-color: #E8363B; vertical-align: middle; margin-left: 3px; margin-bottom: 3px; }
      .dot-lg { display: inline-block; width: 14px; height: 14px; border-radius: 50%; background-color: #E8363B; vertical-align: middle; margin-left: 3px; margin-bottom: 6px; }
    </mj-style>
    <!--[if mso]>
    <style type="text/css">
      .dot-sm, .dot-md, .dot-lg { display: inline-block !important; }
      td { background-color: #0B1222 !important; }
    </style>
    <![endif]-->
  </mj-head>

  <mj-body background-color="#080E1A" width="620px">

    <!-- Block 1: Header with logo -->
    <mj-section background-color="#0B1222" padding="20px 24px">
      <mj-column width="60%" vertical-align="middle">
        <mj-text align="left" color="#FFFFFF" font-size="22px" font-weight="700" font-family="'Space Grotesk', Arial, sans-serif" padding="0">
          <!--[if mso]><span style="color:#E8363B; font-size:10px;">&#9679;</span><span style="color:#E8363B; font-size:14px;">&#9679;</span><span style="color:#E8363B; font-size:18px;">&#9679;</span><![endif]-->
          <!--[if !mso]><!--><span class="dot-sm"></span><span class="dot-md"></span><span class="dot-lg"></span><!--<![endif]-->
          <span style="margin-left: 8px; vertical-align: middle;">superdots</span>
        </mj-text>
      </mj-column>
      <mj-column width="40%" vertical-align="middle">
        <mj-text align="right" padding="0" css-class="webview-link">
          <a href="{webview_url}" style="color:#475569; font-size:12px;">View in browser</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Accent gradient line: red→teal -->
    <mj-section padding="0" background-color="#0B1222">
      <mj-column>
        <mj-text padding="0"><div style="height:3px; background: linear-gradient(90deg, #E8363B 0%, #14B8A6 100%);"></div></mj-text>
      </mj-column>
    </mj-section>
    <!--[if mso]>
    <table role="presentation" width="100%" style="background-color:#E8363B;"><tr><td style="height:3px; font-size:0; line-height:0;">&nbsp;</td></tr></table>
    <![endif]-->

    <!-- Block 2: Intro editorial -->
    <mj-section background-color="#0B1222" padding="36px 24px 28px">
      <mj-column>
        <mj-text font-size="17px" line-height="1.7" color="#E2E8F0" padding="0">
          Hi {contactfield=firstname},
        </mj-text>
        <mj-text font-size="16px" line-height="1.7" color="#94A3B8" padding="12px 0 0">
          This week we dug into the parts of work that eat time without anyone noticing — event logistics, customer onboarding, negotiations you didn't prepare for, and the chaos that happens when "we're adopting AI" means different things to every team.
        </mj-text>
        <mj-text font-size="16px" line-height="1.7" color="#94A3B8" padding="8px 0 0">
          Four articles, four ways to stop winging it<span style="color:#E8363B;">.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Block 3: Featured article card -->
    <mj-section background-color="#0B1222" padding="8px 16px 8px">
      <mj-column background-color="#111827" border-radius="12px" padding="0">
        <mj-image src="https://superdots.sh/images/blog/ai-event-planning-tools.webp" alt="AI Event Planning Tools" width="588px" border-radius="12px 12px 0 0" padding="0" />
        <mj-text font-size="13px" font-weight="600" color="#E8363B" letter-spacing="1px" text-transform="uppercase" padding="24px 24px 8px">
          Operations
        </mj-text>
        <mj-text font-size="24px" font-weight="700" font-family="'Space Grotesk', Arial, sans-serif" color="#FFFFFF" line-height="1.3" padding="0 24px 12px">
          8 AI Event Planning Tools That Handle the Logistics So You Don't Have To<span style="color:#E8363B;">.</span>
        </mj-text>
        <mj-text font-size="16px" line-height="1.7" color="#94A3B8" padding="0 24px 12px">
          67% of event pros already use AI in their workflow. The other 33% are still chasing RSVPs through email threads that stopped making sense three replies ago.
        </mj-text>
        <mj-text font-size="16px" line-height="1.7" color="#94A3B8" padding="0 24px 20px">
          If you run even two corporate events a year, this will change how you think about the prep work<span style="color:#E8363B;">.</span>
        </mj-text>
        <mj-button background-color="#E8363B" color="#FFFFFF" font-size="15px" font-weight="600" font-family="'Space Grotesk', Arial, sans-serif" border-radius="6px" inner-padding="12px 28px" href="https://superdots.sh/blog/ai-event-planning-tools/" css-class="cta-link" padding="0 24px 28px" align="left">
          Read the full article
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Block 4: Also this week header -->
    <mj-section background-color="#0B1222" padding="32px 24px 16px">
      <mj-column>
        <mj-text font-size="13px" font-weight="600" color="#475569" letter-spacing="1.5px" text-transform="uppercase" padding="0">
          <span style="color:#14B8A6;">&#9472;&#9472;</span>&nbsp;&nbsp;Also this week
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Secondary article 1 -->
    <mj-section background-color="#0B1222" padding="0 16px 12px">
      <mj-column background-color="#111827" border-radius="8px" border-left="3px solid #E8363B" padding="20px 24px">
        <mj-text padding="0 0 6px" css-class="secondary-title">
          <a href="https://superdots.sh/blog/ai-customer-onboarding/" style="color:#F1F5F9; font-size:17px; font-weight:600; font-family:'Space Grotesk', Arial, sans-serif; text-decoration:none;">AI Customer Onboarding: Reduce Time-to-Value and Cut Churn</a>
        </mj-text>
        <mj-text font-size="15px" color="#94A3B8" line-height="1.5" padding="0">
          Your customer signed. Your sales team celebrated. Three weeks later, they've logged in twice and are asking about cancellation terms. Here's how AI closes that gap<span style="color:#E8363B;">.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Secondary article 2 -->
    <mj-section background-color="#0B1222" padding="0 16px 12px">
      <mj-column background-color="#111827" border-radius="8px" border-left="3px solid #14B8A6" padding="20px 24px">
        <mj-text padding="0 0 6px" css-class="secondary-title">
          <a href="https://superdots.sh/blog/ai-negotiation-tools/" style="color:#F1F5F9; font-size:17px; font-weight:600; font-family:'Space Grotesk', Arial, sans-serif; text-decoration:none;">AI Negotiation Tools: Prepare, Practice, and Win Better Deals</a>
        </mj-text>
        <mj-text font-size="15px" color="#94A3B8" line-height="1.5" padding="0">
          Most people lose negotiations before they walk into the room. These tools compress hours of deal prep into minutes<span style="color:#E8363B;">.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Secondary article 3 -->
    <mj-section background-color="#0B1222" padding="0 16px 12px">
      <mj-column background-color="#111827" border-radius="8px" border-left="3px solid #E8363B" padding="20px 24px">
        <mj-text padding="0 0 6px" css-class="secondary-title">
          <a href="https://superdots.sh/blog/ai-change-management/" style="color:#F1F5F9; font-size:17px; font-weight:600; font-family:'Space Grotesk', Arial, sans-serif; text-decoration:none;">AI Change Management: Lead AI Adoption Without the Chaos</a>
        </mj-text>
        <mj-text font-size="15px" color="#94A3B8" line-height="1.5" padding="0">
          78% of CHROs say workflows must fundamentally change for AI ROI. Here's why the old playbook fails and what actually works<span style="color:#E8363B;">.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Block 5: Quick tip -->
    <mj-section background-color="#0B1222" padding="20px 16px 8px">
      <mj-column background-color="#0F172A" border-radius="8px" border-left="4px solid #14B8A6" padding="24px 24px">
        <mj-text font-size="13px" font-weight="600" color="#14B8A6" letter-spacing="1px" text-transform="uppercase" padding="0 0 10px">
          Quick tip
        </mj-text>
        <mj-text font-size="18px" font-weight="600" font-family="'Space Grotesk', Arial, sans-serif" color="#FFFFFF" line-height="1.4" padding="0 0 8px">
          30-second meeting prep hack
        </mj-text>
        <mj-text font-size="15px" color="#94A3B8" line-height="1.6" padding="0">
          Before your next meeting, paste the agenda into ChatGPT or Claude and ask: "What questions am I likely to get, and what data should I have ready?" Takes 30 seconds. Prevents the moment where someone asks a number you should know and you don't<span style="color:#E8363B;">.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Spacer -->
    <mj-section background-color="#0B1222" padding="16px 0">
      <mj-column>
        <mj-text font-size="1px" padding="0" color="#0B1222">&nbsp;</mj-text>
      </mj-column>
    </mj-section>

    <!-- Accent gradient line: teal→red -->
    <mj-section padding="0" background-color="#0B1222">
      <mj-column>
        <mj-text padding="0"><div style="height:2px; background: linear-gradient(90deg, #14B8A6 0%, #E8363B 100%);"></div></mj-text>
      </mj-column>
    </mj-section>

    <!-- Block 6: Footer -->
    <mj-section background-color="#0B1222" padding="32px 24px 12px">
      <mj-column>
        <mj-text align="center" padding="0 0 4px">
          <!--[if mso]><span style="color:#E8363B; font-size:8px;">&#9679;</span><span style="color:#E8363B; font-size:11px;">&#9679;</span><span style="color:#E8363B; font-size:14px;">&#9679;</span><![endif]-->
          <!--[if !mso]><!--><span class="dot-sm"></span><span class="dot-md"></span><span class="dot-lg"></span><!--<![endif]-->
        </mj-text>
        <mj-text align="center" color="#E2E8F0" font-size="15px" font-family="'Space Grotesk', Arial, sans-serif" font-weight="500" padding="12px 0 4px">
          Practical AI for every department<span style="color:#E8363B;">.</span>
        </mj-text>
        <mj-text align="center" color="#475569" font-size="13px" padding="4px 0 0">
          <a href="https://superdots.sh" style="color:#475569; text-decoration:none;">superdots.sh</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#0B1222" padding="12px 24px 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#334155" padding="0 0 16px">
          You're receiving this because you subscribed at superdots.sh
        </mj-text>
        <mj-text align="center" padding="0" css-class="footer-link">
          <a href="{unsubscribe_text}" style="color:#94A3B8; font-size:13px;">Unsubscribe</a>&nbsp;&nbsp;&middot;&nbsp;&nbsp;<a href="{webview_url}" style="color:#94A3B8; font-size:13px;">View in browser</a>
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
